---
interface Props {
  variant?: "workshop" | "assessment" | "merchant";
  formId?: string;
  defaultIntent?: string;
  detailsPlaceholder?: string;
  sourceCity?: string;
  sourceIndustry?: string;
  sourceService?: string;
  submitLabel?: string;
}

const {
  variant = "assessment",
  formId = "lead",
  defaultIntent,
  detailsPlaceholder = "Example: after-hours calls, booking estimates, rescheduling.",
  sourceCity = "",
  sourceIndustry = "",
  sourceService = "",
  submitLabel,
} = Astro.props;
const isWorkshop = variant === "workshop";
const isMerchant = variant === "merchant";
const intent = defaultIntent ??
  (isWorkshop ? "Reserve a workshop seat, $497 early bird" : isMerchant ? "Merchant store activation" : "Book the free 15-minute assessment");
const fieldId = (name: string) => `${formId}-${name}`;
---

<div class="form-card">
  <form id={formId} data-lead-form data-variant={variant} data-intent={intent}
    data-city={sourceCity} data-industry={sourceIndustry} data-service={sourceService} novalidate>
    <input type="hidden" name="intent" value={intent} />
    <div class="field">
      <label for={fieldId("businessName")}>{isMerchant ? "Store name" : "Business name"}</label>
      <input id={fieldId("businessName")} name="businessName" type="text" required autocomplete="organization" />
    </div>
    <div class="field-row">
      <div class="field">
        <label for={fieldId("contactName")}>{isMerchant ? "Contact name" : "Your name"}</label>
        <input id={fieldId("contactName")} name="contactName" type="text" required autocomplete="name" />
      </div>
      <div class="field">
        <label for={fieldId("email")}>Work email</label>
        <input id={fieldId("email")} name="email" type="email" required autocomplete="email" />
      </div>
    </div>
    {isMerchant ? (
      <div class="field">
        <label for={fieldId("mall")}>Mall / property name</label>
        <input id={fieldId("mall")} name="industry" type="text" placeholder="Example: Central Mall" />
      </div>
    ) : (
      <div class="field-row">
        <div class="field">
          <label for={fieldId("phone")}>Phone</label>
          <input id={fieldId("phone")} name="phone" type="tel" autocomplete="tel" />
        </div>
        {isWorkshop ? (
          <div class="field">
            <label for={fieldId("seats")}>Seats</label>
            <select id={fieldId("seats")} name="seats">
              <option value="1">1 seat, $497 early bird</option>
              <option value="2">2 seats, partner rate</option>
            </select>
          </div>
        ) : (
          <div class="field">
            <label for={fieldId("industry")}>Industry</label>
            <input id={fieldId("industry")} name="industry" type="text" placeholder="Example: HVAC" />
          </div>
        )}
      </div>
    )}
    {isWorkshop ? (
      <div class="field">
        <label for={fieldId("session")}>Preferred session</label>
        <input id={fieldId("session")} name="session" type="text" placeholder="Next available Saturday, or a date that works" />
      </div>
    ) : !isMerchant ? (
      <div class="field">
        <label for={fieldId("stack")}>Phone, calendar, or CRM tools <span class="optional">(optional)</span></label>
        <input id={fieldId("stack")} name="stack" type="text" placeholder="Example: RingCentral, Google Calendar, Jobber" />
      </div>
    ) : null}
    {!isMerchant && (
      <div class="field">
        <label for={fieldId("details")}>{isWorkshop ? "Biggest call-handling problem" : "What should work better?"} <span class="optional">(optional)</span></label>
        <textarea id={fieldId("details")} name="details" rows="3" placeholder={detailsPlaceholder}></textarea>
      </div>
    )}
    <div class="hp" aria-hidden="true">
      <label for={fieldId("bot-field")}>Do not fill this in</label>
      <input id={fieldId("bot-field")} name="bot-field" type="text" tabindex="-1" autocomplete="off" />
    </div>
    <button class="btn btn-primary" type="submit" style="width:100%" data-lead-submit>
      {submitLabel ?? (isWorkshop ? "Request my workshop seat" : "Request my 15-minute assessment")}
    </button>
    <p class="form-note">No payment today. We usually reply within one business day. You can also email <a href="mailto:dre@arkansasautomated.com">dre@arkansasautomated.com</a>.</p>
    <p class="form-legal">By submitting, you agree that Arkansas Automated may contact you about this request. See our <a href="/privacy">privacy and data handling page</a>.</p>
    <div class="form-msg" data-lead-message hidden></div>
  </form>
</div>

<script>
  const ENDPOINT = "https://fortsmithdirectory.com/api/public/leads";

  document.querySelectorAll<HTMLFormElement>("[data-lead-form]").forEach((form) => {
    if (form.dataset.ready === "true") return;
    form.dataset.ready = "true";
    const msg = form.querySelector<HTMLElement>("[data-lead-message]");
    const submit = form.querySelector<HTMLButtonElement>("[data-lead-submit]");
    const pageLoadedAt = Date.now();
    let firstInteractionAt: number | null = null;
    let failedAttempts = 0;
    let formEverVisible = false;

    function show(kind: "ok" | "error", text: string) {
      if (!msg) return;
      msg.hidden = false;
      msg.dataset.kind = kind;
      msg.textContent = text;
    }

    function showRecoverable(text: string, mail: { subject: string; body: string }) {
      if (!msg) return;
      msg.hidden = false;
      msg.dataset.kind = "error";
      msg.textContent = "";
      const p = document.createElement("p");
      p.textContent = text;
      msg.appendChild(p);
      const a = document.createElement("a");
      a.href = `mailto:dre@arkansasautomated.com?subject=${encodeURIComponent(mail.subject)}&body=${encodeURIComponent(mail.body)}`;
      a.textContent = "Send this as an email instead";
      a.style.textDecoration = "underline";
      msg.appendChild(a);
    }

    form.addEventListener("input", () => {
      if (firstInteractionAt === null) firstInteractionAt = Date.now();
    });
    if ("IntersectionObserver" in window) {
      const observer = new IntersectionObserver((entries) => {
        if (entries.some((entry) => entry.isIntersecting)) {
          formEverVisible = true;
          observer.disconnect();
        }
      }, { threshold: 0.3 });
      observer.observe(form);
    }

    form.addEventListener("submit", async (event) => {
      event.preventDefault();
      if (!submit) return;
      const fd = new FormData(form);
      const val = (key: string) => {
        const value = fd.get(key);
        return typeof value === "string" && value.trim() ? value.trim() : undefined;
      };
      const businessName = val("businessName");
      const contactName = val("contactName");
      const email = val("email");
      if (!businessName || !contactName || !email) {
        show("error", "Business name, your name, and a work email are required.");
        return;
      }
      submit.disabled = true;
      const original = submit.textContent;
      submit.textContent = "Sending";
      const params = new URLSearchParams(location.search);
      const payload: Record<string, unknown> = {
        type: "automation_assessment",
        businessName,
        name: contactName,
        email,
        phone: val("phone"),
        details: val("details"),
        spokeDomain: "arkansasautomated.com",
        sourcePath: location.pathname,
        "bot-field": fd.get("bot-field") ?? "",
        extra: {
          intent: val("intent") ?? form.dataset.intent ?? null,
          seats: val("seats") ?? null,
          session: val("session") ?? null,
          industry: val("industry") ?? form.dataset.industry ?? null,
          stack: val("stack") ?? null,
          city: form.dataset.city || null,
          service: form.dataset.service || null,
          utmSource: params.get("utm_source"),
          utmMedium: params.get("utm_medium"),
          utmCampaign: params.get("utm_campaign"),
          msToSubmit: Date.now() - pageLoadedAt,
          msToFirstInput: firstInteractionAt === null ? null : firstInteractionAt - pageLoadedAt,
          failedAttempts,
          formEverVisible,
          referrer: document.referrer || null,
        },
      };
      const mail = {
        subject: `Arkansas Automated request from ${businessName}`,
        body: [`Business: ${businessName}`, `Name: ${contactName}`, `Email: ${email}`,
          `Phone: ${val("phone") ?? ""}`, `Request: ${val("intent") ?? form.dataset.intent ?? ""}`,
          `Seats: ${val("seats") ?? ""}`, `Preferred session: ${val("session") ?? ""}`,
          `Industry: ${val("industry") ?? form.dataset.industry ?? ""}`, `Tools: ${val("stack") ?? ""}`,
          "", val("details") ?? ""].join("\n"),
      };
      async function post() {
        const response = await fetch(ENDPOINT, { method: "POST", headers: { "Content-Type": "text/plain" }, body: JSON.stringify(payload) });
        return response.ok;
      }
      let ok = false;
      for (let attempt = 0; attempt < 2 && !ok; attempt++) {
        try { ok = await post(); } catch { ok = false; }
        if (!ok && attempt === 0) await new Promise((resolve) => setTimeout(resolve, 800));
      }
      if (ok) {
        form.reset();
        show("ok", form.dataset.variant === "workshop"
          ? "Request received. We will confirm availability, price, and the room details by email."
          : form.dataset.variant === "merchant"
            ? "Activation request received. We will confirm enrollment status within one business day."
            : "Request received. We will reply from a real address, usually within one business day.");
        submit.textContent = "Request received";
        return;
      }
      failedAttempts++;
      showRecoverable("That did not go through, and we do not want to lose your request.", mail);
      submit.disabled = false;
      submit.textContent = original;
    });
  });
</script>
