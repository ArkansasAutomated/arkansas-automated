---
/*
 * Shared lead form. Posts to the hub's public lead endpoint as type
 * "automation_assessment", the same capture path the previous audit form
 * used. The workshop intent rides in `extra`, so no hub change is required.
 *
 * One instance per page (ids are page-unique). `sourcePath` tells the hub
 * which pSEO page the lead came from.
 */
interface Props {
  /** Preselected intent option. */
  defaultIntent?: string;
  /** Placeholder for the details textarea, tuned per page type. */
  detailsPlaceholder?: string;
}

const {
  defaultIntent = "Book the free 15-minute assessment",
  detailsPlaceholder = "Example: after-hours calls, booking estimates, rescheduling.",
} = Astro.props;

const intents = [
  "Reserve a workshop seat, $497 early bird",
  "Book the free 15-minute assessment",
  "Talk done-for-you or retainer",
];
---

<div class="form-card">
  <form id="reserve-form" novalidate>
    <div class="field">
      <label for="intent">I want to</label>
      <select id="intent" name="intent">
        {
          intents.map((i) => (
            <option value={i} selected={i === defaultIntent}>{i}</option>
          ))
        }
      </select>
    </div>
    <div class="field">
      <label for="businessName">Business name</label>
      <input id="businessName" name="businessName" type="text" required autocomplete="organization" />
    </div>
    <div class="field-row">
      <div class="field">
        <label for="contactName">Your name</label>
        <input id="contactName" name="contactName" type="text" required autocomplete="name" />
      </div>
      <div class="field">
        <label for="email">Work email</label>
        <input id="email" name="email" type="email" required autocomplete="email" />
      </div>
    </div>
    <div class="field-row">
      <div class="field">
        <label for="phone">Phone</label>
        <input id="phone" name="phone" type="tel" autocomplete="tel" />
      </div>
      <div class="field">
        <label for="seats">Seats (workshop only)</label>
        <select id="seats" name="seats">
          <option value="1">1</option>
          <option value="2">2, partner rate</option>
        </select>
      </div>
    </div>
    <div class="field">
      <label for="details">What is the first thing you would want handled?</label>
      <textarea id="details" name="details" rows="3" placeholder={detailsPlaceholder}></textarea>
    </div>

    <!-- Honeypot. Real people never see or fill this; the hub rejects
         any submission that carries a value (server-side bot-field). -->
    <div class="hp" aria-hidden="true">
      <label for="bot-field">Do not fill this in</label>
      <input id="bot-field" name="bot-field" type="text" tabindex="-1" autocomplete="off" />
    </div>

    <button class="btn btn-primary" type="submit" style="width:100%" id="reserve-submit">
      Send my request
    </button>
    <!-- Second conversion path. Until now this form was the only way to reach
         the business from any page, and it sits roughly 84% of the way down
         the homepage. No phone number is published for this brand, so email is
         the only alternative that can be stated truthfully here. -->
    <p class="form-note">
      No payment due now. We reply from a real address. You can also email
      <a href="mailto:dre@arkansasautomated.com">dre@arkansasautomated.com</a>.
    </p>
    <div id="reserve-msg" class="form-msg" hidden></div>
  </form>
</div>

<script>
  // APEX host, never www: www 308-redirects, and a redirected cross-origin
  // fetch resends with Origin: null, which the hub allowlist rejects. That
  // exact bug silently ate every submission from this domain until 2026-07-27.
  //
  // text/plain is deliberate: it is a CORS-safelisted content type, so the
  // browser sends no preflight.
  const ENDPOINT = "https://fortsmithdirectory.com/api/public/leads";
  const form = document.getElementById("reserve-form") as HTMLFormElement | null;
  const msg = document.getElementById("reserve-msg") as HTMLElement | null;
  const submit = document.getElementById("reserve-submit") as HTMLButtonElement | null;

  function show(kind: "ok" | "error", text: string) {
    if (!msg) return;
    msg.hidden = false;
    msg.dataset.kind = kind;
    msg.textContent = text;
  }

  /*
   * Failure recovery. Before 2026-08-08 a failed POST showed an address as
   * plain text, so the only way to recover was to retype everything into a
   * mail client. Anyone who had already filled the form was the most motivated
   * visitor on the page, and that is exactly who was dropped. This rebuilds
   * what they typed into a prefilled mailto so a transport failure costs one
   * click instead of the lead.
   */
  function showRecoverable(text: string, mail: { subject: string; body: string }) {
    if (!msg) return;
    msg.hidden = false;
    msg.dataset.kind = "error";
    msg.textContent = "";

    const p = document.createElement("p");
    p.textContent = text;
    msg.appendChild(p);

    const a = document.createElement("a");
    a.href =
      "mailto:dre@arkansasautomated.com?subject=" +
      encodeURIComponent(mail.subject) +
      "&body=" +
      encodeURIComponent(mail.body);
    a.textContent = "Send this as an email instead";
    a.style.textDecoration = "underline";
    msg.appendChild(a);
  }

  // Funnel context, recorded only on submissions that succeed. It rides in the
  // lead's existing `extra` (jsonb `payload` on the hub) so it needs no schema
  // or endpoint change. It cannot tell us about people who never submit; that
  // needs an events endpoint the hub does not have yet.
  const pageLoadedAt = Date.now();
  let firstInteractionAt: number | null = null;
  let failedAttempts = 0;
  let formEverVisible = false;

  form?.addEventListener(
    "input",
    () => {
      if (firstInteractionAt === null) firstInteractionAt = Date.now();
    },
    { once: false },
  );

  if (form && "IntersectionObserver" in window) {
    const io = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (entry.isIntersecting) {
            formEverVisible = true;
            io.disconnect();
          }
        }
      },
      { threshold: 0.3 },
    );
    io.observe(form);
  }

  form?.addEventListener("submit", async (e) => {
    e.preventDefault();
    if (!form || !submit) return;
    const fd = new FormData(form);
    const val = (k: string) => {
      const v = fd.get(k);
      return typeof v === "string" && v.trim() !== "" ? v.trim() : undefined;
    };

    const businessName = val("businessName");
    const contactName = val("contactName");
    const email = val("email");
    if (!businessName || !contactName || !email) {
      show("error", "Business name, your name, and a work email are required.");
      return;
    }

    submit.disabled = true;
    const original = submit.textContent;
    submit.textContent = "Sending";

    // `category` is deliberately omitted: leads.category is a foreign key to
    // categories(slug) and automation is not a directory category, so sending
    // one would fail the insert.
    const payload: Record<string, unknown> = {
      type: "automation_assessment",
      businessName,
      name: contactName,
      email,
      phone: val("phone"),
      details: val("details"),
      spokeDomain: "arkansasautomated.com",
      sourcePath: location.pathname,
      "bot-field": fd.get("bot-field") ?? "",
      extra: {
        intent: val("intent") ?? null,
        seats: val("seats") ?? null,
        // Funnel context. `msToSubmit` is time from page load; `msToFirstInput`
        // separates "arrived ready to convert" from "read the page first".
        // `formEverVisible` false means the form was submitted without ever
        // scrolling into view, which is a bot tell worth keeping on the row.
        msToSubmit: Date.now() - pageLoadedAt,
        msToFirstInput: firstInteractionAt === null ? null : firstInteractionAt - pageLoadedAt,
        failedAttempts,
        formEverVisible,
        referrer: document.referrer || null,
      },
    };

    const mail = {
      subject: `Arkansas Automated request from ${businessName}`,
      body: [
        `Business: ${businessName}`,
        `Name: ${contactName}`,
        `Email: ${email}`,
        `Phone: ${val("phone") ?? ""}`,
        `I want to: ${val("intent") ?? ""}`,
        `Seats: ${val("seats") ?? ""}`,
        "",
        `${val("details") ?? ""}`,
      ].join("\n"),
    };

    // One retry before giving up. A single transient network blip should not
    // cost a lead that is already typed and submitted.
    async function post(): Promise<boolean> {
      const res = await fetch(ENDPOINT, {
        method: "POST",
        headers: { "Content-Type": "text/plain" },
        body: JSON.stringify(payload),
      });
      return res.ok;
    }

    let ok = false;
    for (let attempt = 0; attempt < 2 && !ok; attempt++) {
      try {
        ok = await post();
      } catch {
        ok = false;
      }
      if (!ok && attempt === 0) await new Promise((r) => setTimeout(r, 800));
    }

    if (ok) {
      form.reset();
      show("ok", "Received. We will read this and reply from a real address, usually within one business day.");
      submit.textContent = "Request received";
      return;
    }

    failedAttempts++;
    showRecoverable("That did not go through, and we do not want to lose your request. ", mail);
    submit.disabled = false;
    submit.textContent = original;
  });
</script>
