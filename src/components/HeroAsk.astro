---
/**
 * Live buyer-ask thread. No ChatGPT logo, no implied partnership.
 * Full text is in the HTML so the page works with JS off.
 * Motion only types the same words; reduced-motion leaves them still.
 */
interface Props {
  question?: string;
  answer?: string;
}

const question =
  Astro.props.question ?? "Who should I hire for HVAC in Fort Smith?";
const answer =
  Astro.props.answer ??
  "HVAC repair in Fort Smith. Open until 6. Licensed. Call the shop.";
---

<aside class="ask" data-ask aria-label="What a buyer sees when they ask who to hire">
  <div class="ask-core">
    <p class="ask-bar">A stranger in your town</p>
    <p class="ask-user"><span data-ask-user>{question}</span></p>
    <p class="ask-bot">
      <span data-ask-bot>{answer}</span><span class="ask-cursor" aria-hidden="true"></span>
    </p>
  </div>
</aside>

<script>
  const roots = document.querySelectorAll<HTMLElement>("[data-ask]");
  const reduce = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

  function typeText(el: HTMLElement, text: string, ms: number) {
    return new Promise<void>((resolve) => {
      el.textContent = "";
      let i = 0;
      const tick = () => {
        i += 1;
        el.textContent = text.slice(0, i);
        if (i >= text.length) resolve();
        else window.setTimeout(tick, ms);
      };
      tick();
    });
  }

  async function play(root: HTMLElement) {
    const user = root.querySelector<HTMLElement>("[data-ask-user]");
    const bot = root.querySelector<HTMLElement>("[data-ask-bot]");
    if (!user || !bot) return;
    const q = user.textContent ?? "";
    const a = bot.textContent ?? "";
    if (reduce) {
      root.classList.add("is-done");
      return;
    }
    user.textContent = "";
    bot.textContent = "";
    root.classList.add("is-playing");
    await typeText(user, q, 28);
    await new Promise((r) => window.setTimeout(r, 380));
    await typeText(bot, a, 22);
    root.classList.add("is-done");
    root.classList.remove("is-playing");
  }

  const io = new IntersectionObserver(
    (entries) => {
      for (const entry of entries) {
        if (!entry.isIntersecting) continue;
        const root = entry.target as HTMLElement;
        if (root.dataset.played === "1") continue;
        root.dataset.played = "1";
        void play(root);
        io.unobserve(root);
      }
    },
    { threshold: 0.45 },
  );

  roots.forEach((root) => io.observe(root));
</script>
