---
import { industries } from "../data/industries";
import { AA_PUBLIC_PHONE_DISPLAY, AA_PUBLIC_PHONE_HREF } from "../lib/public-phone";

const trades = ["roofers", "hvac", "plumbers"]
  .map((slug) => industries.find((i) => i.slug === slug))
  .filter((i): i is NonNullable<typeof i> => Boolean(i));

const ladder = [
  {
    n: "01",
    name: "Leak Audit",
    price: "$1,500",
    p: "Ninety minutes in the operation. A written map back: every leak, costed, ranked by payback. The full fee comes off the first fix.",
    href: "/audit",
  },
  {
    n: "02",
    name: "First Fix",
    price: "From $2,500",
    p: "The one cut at the top of the map. Scoped before anyone writes the check. Not a website package.",
    href: "/audit",
  },
  {
    n: "03",
    name: "Advisor retainer",
    price: "From $2,000/mo",
    p: "The map stays current. New cuts get built as they show up. The systems stay running.",
    href: "/forward-deployed-ai-engineer",
  },
  {
    n: "04",
    name: "Strategy and roadmap",
    price: "From $7,500",
    p: "For a company with 25 or more people. The roadmap comes before any build.",
    href: "/audit",
  },
];

const sample = [
  {
    h: "After-hours calls that ring out",
    p: "6 a week. About 2 would have booked. At $1,200 a job, that is roughly $12,000 a month if the rate held.",
  },
  {
    h: "Estimates with no second touch",
    p: "4 sitting open. 1 closes on a second text. At $3,000, that is $3,000 this month.",
  },
  {
    h: "What stays human",
    p: "Pricing exceptions, safety calls, and anything that needs a judgment. Those do not go on the build list.",
  },
];

const faqs = [
  {
    q: "Are you Arkansas Automated Security?",
    a: "No. This company is Brassfield Ventures LLC, in Fort Smith. Arkansas Automated Security, LLC of Mayflower is a different business. We do not install alarms.",
  },
  {
    q: "Is the missed-call test a sales meeting?",
    a: "No. Send the business number and when the office is closed. I call the line and send a short recording of what happened. If there is nothing to fix, that is the finding.",
  },
  {
    q: "Does the audit fee come off the build?",
    a: "Yes. The full $1,500 comes off the first fix if you build it with us. If you do not, you keep the map.",
  },
  {
    q: "Do you sell a $497 website?",
    a: "No. If the map says the site is the leak, that is a first fix, scoped, from $2,500. A cheap storefront is not the offer.",
  },
];
---

<div class="hero-frame">
  <div class="hero-stage-media" aria-hidden="true">
    <img
      class="hero-stage-bg"
      src="/images/hero-network.webp"
      alt=""
      width="1122"
      height="1402"
      fetchpriority="high"
    />
    <div class="hero-stage-scrim"></div>
    <div class="hero-stage-grain"></div>
  </div>
  <section class="hero-stage" id="start">
    <div class="container hero-stage-grid">
      <div class="hero-stage-copy">
        <p class="eyebrow">Andre Brassfield. AI consultant in Fort Smith.</p>
        <h1 class="heading-xl advisor-h1 enter">I find the process bleeding money in your business, and fix it with AI.</h1>
        <p class="body-lg enter enter-2">
          Start with a missed-call test. I call the line after the office is closed and send you what happened.
          If the leak is real, the audit is $1,500 and the full fee comes off the first fix.
        </p>
        <div class="hero-ctas enter enter-3">
          <a class="btn btn-primary" href="/missed-call-test">Get the missed-call test</a>
          <a class="btn btn-secondary" href="/audit">See the $1,500 audit</a>
        </div>
      </div>
      <aside class="audit-ticket" aria-label="How to start">
        <p class="ask-bar">Start here</p>
        <p class="audit-ticket-price">Free</p>
        <ul>
          <li>You send the number and the hour the office is closed</li>
          <li>I call the line</li>
          <li>You get a short recording of what happened</li>
          <li>No pitch on that call</li>
        </ul>
        <a class="text-link ticket-link" href={AA_PUBLIC_PHONE_HREF}>Or call {AA_PUBLIC_PHONE_DISPLAY}</a>
      </aside>
    </div>
  </section>
</div>

<section class="section" id="map">
  <div class="container">
    <p class="eyebrow">Sample. Not a client. Not a promise.</p>
    <h2 class="heading-lg measure">What a leak map looks like.</h2>
    <p class="body-lg measure" style="margin-top:1rem">
      The numbers below are an example of the math. They are not a result from a Fort Smith shop.
      A real map uses your calls, your estimates, and your prices.
    </p>
    <div class="leak-grid">
      {sample.map((row) => (
        <article class="leak">
          <h3>{row.h}</h3>
          <p>{row.p}</p>
        </article>
      ))}
    </div>
  </div>
</section>

<section class="section section-tint" id="ladder">
  <div class="container">
    <h2 class="heading-lg measure">Four prices. That is the offer.</h2>
    <p class="body-lg measure" style="margin-top:1rem">
      The missed-call test is free. Everything after it has a number on it.
    </p>
    <div class="rows">
      {ladder.map((step) => (
        <article class="row">
          <div class="row-n">{step.n}</div>
          <h3><a class="text-link-plain" href={step.href}>{step.name}</a></h3>
          <p><strong>{step.price}.</strong> {step.p}</p>
        </article>
      ))}
    </div>
  </div>
</section>

<section class="section" id="teardowns">
  <div class="container split">
    <div>
      <h2 class="heading-lg">Teardowns</h2>
    </div>
    <div>
      <p class="body-lg">
        A teardown is a real audit, published when the owner says yes, or anonymized without invented numbers.
        None are up yet. This section stays empty until the first one is real.
      </p>
      <p class="body-lg" style="margin-top:1.1rem">
        <a class="text-link" href="/learn/audit-teardown">How a teardown is written</a>.
      </p>
    </div>
  </div>
</section>

<section class="section section-tint" id="trades">
  <div class="container">
    <h2 class="heading-lg measure">Roofing, HVAC, plumbing.</h2>
    <p class="body-lg measure" style="margin-top:1rem">
      The leak is usually the same: the phone during the job, and the estimate that never gets a second touch.
    </p>
    <div class="city-grid">
      {trades.map((t) => (
        <a class="city-card" href={`/for/${t.slug}`}>
          <span class="prop-name">{t.name.charAt(0).toUpperCase() + t.name.slice(1)}</span>
          <span class="prop-role">{t.intent}</span>
          <span class="city-cta">See the leaks</span>
        </a>
      ))}
    </div>
    <div class="link-chips">
      <a class="chip" href="/ai-consultant/fort-smith">Fort Smith and Van Buren</a>
      <a class="chip" href="/ai-consultant/northwest-arkansas">Northwest Arkansas</a>
      <a class="chip" href="/for">Other trades</a>
    </div>
  </div>
</section>

<section class="section">
  <div class="container faq-wrap">
    <h2 class="heading-lg measure">Questions</h2>
    <div class="faq-list">
      {faqs.map((f) => (
        <details class="faq-item">
          <summary>{f.q}</summary>
          <p>{f.a}</p>
        </details>
      ))}
    </div>
  </div>
</section>
