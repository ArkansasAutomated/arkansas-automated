---
import BookCall from "./BookCall.astro";
import { services, serviceBySlug } from "../data/services";
import { AA_PUBLIC_PHONE_DISPLAY, AA_PUBLIC_PHONE_HREF } from "../lib/public-phone";
import { VISIBILITY_INSTALL_URL } from "../lib/visibility-install-checkout";

interface Props {
  home?: boolean;
}

const { home = false } = Astro.props;
const s = serviceBySlug("visibility-install");
const others = services.filter((x) => x.slug !== s.slug);
const payUrl = VISIBILITY_INSTALL_URL;
const checkoutMailto =
  "mailto:dre@arkansasautomated.com?subject=Visibility%20Install%20checkout";
const primaryHref = payUrl || checkoutMailto;
const primaryLabel = payUrl ? "Pay $2,500 to start" : "Send me the checkout link";
---

<section class="hero" id="install">
  <div class="container">
    {
      !home && (
        <nav class="crumbs" aria-label="Breadcrumb">
          <a href="/">Home</a><span>/</span><a href="/services">Services</a><span>/</span>{s.name}
        </nav>
      )
    }
    <p class="hero-kicker enter">Does ChatGPT know your business exists?</p>
    <span class="eyebrow">VISIBILITY INSTALL</span>
    <h1 class="heading-xl measure">Become the business AI can name.</h1>
    <p class="body-lg measure" style="margin-top:1.15rem">{s.answer}</p>
    <p class="body-lg measure" style="margin-top:0.75rem">
      $2,500 setup, then $497 a month. 90-day term.
    </p>
    <div class="hero-ctas" style="margin-top:2rem">
      <a class="btn btn-primary" href={primaryHref}>{primaryLabel}</a>
    </div>
    <p class="fine-print" style="margin-top:1.25rem">
      Five items installed in 14 days from access. Delivery guarantee, not a ranking guarantee.
      You keep every asset.
    </p>
  </div>
</section>

<section class="section section-tint">
  <div class="container">
    <h2 class="heading-lg measure">This is not the AI front desk. Same price, different job.</h2>
    <div class="rows" style="margin-top:1.5rem">
      <article class="row">
        <h3>AI front desk, $2,500 + $497/mo</h3>
        <p>
          Answers the phone 24/7, qualifies the caller, and books the job.
          {" "}<a class="text-link" href="/services/ai-front-desk">See the AI front desk</a>.
        </p>
      </article>
      <article class="row">
        <h3>Visibility Install, $2,500 + $497/mo</h3>
        <p>
          Five inspectable items on the site you already have, so AI and Google have something
          true to name. It does not answer calls.
        </p>
      </article>
    </div>
    <p class="body-lg measure" style="margin-top:1.5rem">
      One makes your phone answer. One makes people ask for you. If you already answer every
      call and still have empty weeks, this is the one you buy.
    </p>
  </div>
</section>

<section class="section">
  <div class="container">
    <h2 class="heading-lg measure">The problem people actually search.</h2>
    <ul class="included">
      <li>You appear when someone searches your name. You disappear when they ask who does the work nearby.</li>
      <li>Buyers already ask ChatGPT, Google AI, and Perplexity who to hire. AI answers anyway, often from a directory, an association, a competitor, or an old article.</li>
      <li>Generic titles and multiple H1s make the site harder to interpret.</li>
      <li>Service area, credentials, specialties, and proof are not consistently machine-readable.</li>
      <li>An llms.txt file is not a strategy. We are not selling you another file.</li>
    </ul>
    <a class="btn btn-primary" href={primaryHref} style="margin-top:1.5rem">{primaryLabel}</a>
  </div>
</section>

<section class="section section-tint">
  <div class="container">
    <h2 class="heading-lg measure">What is included.</h2>
    <ul class="included">
      {s.includes.map((i) => <li>{i}</li>)}
    </ul>
    <p class="form-note" style="margin-top:1.5rem">
      Not included: a website rebuild, paid ads, social posting, booking-system migration,
      rewriting every old blog post, or the AI front desk.
    </p>
    <a class="btn btn-primary" href={primaryHref} style="margin-top:1.25rem">{primaryLabel}</a>
  </div>
</section>

<section class="section">
  <div class="container">
    <h2 class="heading-lg measure">How the 14 days run.</h2>
    <div class="rows">
      {
        s.process.map((p, idx) => (
          <article class="row">
            <div class="row-n">{String(idx + 1).padStart(2, "0")}</div>
            <h3>{p.h}</h3>
            <p>{p.p}</p>
          </article>
        ))
      }
    </div>
  </div>
</section>

<section class="section section-tint">
  <div class="container">
    <h2 class="heading-lg measure">The delivery guarantee, and what it does not cover.</h2>
    <p class="body-lg measure" style="margin-top:1.15rem">
      If the five items are not live within 14 days of access, we keep working at no extra
      setup cost until they are, or we refund the $2,500. Live means published. It does not
      mean a ranking we cannot control.
    </p>
    <p class="body-lg measure" style="margin-top:1rem">
      We do not have named Visibility Install case studies yet. We are not going to invent them.
    </p>
    <a class="btn btn-primary" href={primaryHref} style="margin-top:1.5rem">{primaryLabel}</a>
  </div>
</section>

<section class="section">
  <div class="container">
    <h2 class="heading-lg measure">Do not buy this if.</h2>
    <ul class="included">
      <li>You want a guaranteed number-one ranking. We will not write that sentence.</li>
      <li>You will not give website, Google Business Profile, and Search Console access.</li>
      <li>You need the phone answered. That is the AI front desk.</li>
      <li>You want ads, social posting, or a new website in this fee.</li>
    </ul>
  </div>
</section>

<section class="section section-tint">
  <div class="container">
    <h2 class="heading-lg measure">$2,500 setup. $497 a month. 90 days.</h2>
    <div class="rows" style="margin-top:1.5rem">
      <article class="row">
        <h3>$2,500 once</h3>
        <p>The 14-day install of all five items.</p>
      </article>
      <article class="row">
        <h3>$497 a month</h3>
        <p>New pages stay titled, marked up, and on one call-to-action. Facts updated when they change.</p>
      </article>
      <article class="row">
        <h3>90-day term</h3>
        <p>Then month to month. Cancel anytime after day 90. Card only. No Affirm or Afterpay.</p>
      </article>
    </div>
    <a class="btn btn-primary" href={primaryHref} style="margin-top:1.5rem">{primaryLabel}</a>
  </div>
</section>

<section class="section">
  <div class="container faq-wrap">
    <h2 class="heading-lg measure">Straight answers.</h2>
    <div class="faq-list">
      {
        s.faqs.map((f) => (
          <details class="faq-item">
            <summary>{f.q}</summary>
            <p>{f.a}</p>
          </details>
        ))
      }
    </div>
  </div>
</section>

<section class="section section-tint">
  <div class="container">
    <h2 class="heading-lg measure">Start today. Be live in 14 days from access.</h2>
    <p class="body-lg measure" style="margin-top:1.15rem">
      Pay the setup, send access, approve copy. If you would rather ask a question first,
      that block is the next one on this page.
    </p>
    <a class="btn btn-primary" href={primaryHref} style="margin-top:1.5rem">{primaryLabel}</a>
    <p class="fine-print" style="margin-top:1.25rem">
      Last updated September 2026. Written by Andre Brassfield, founder of Arkansas Automated.
    </p>
  </div>
</section>

<section class="section">
  <div class="container">
    <h2 class="heading-md">Other solutions</h2>
    <div class="link-chips">
      <a class="chip" href="/services/front-door">Front Door $497</a>
      <a class="chip" href="/services/ai-front-desk">AI front desk</a>
      {others.filter((o) => o.slug !== "front-door" && o.slug !== "ai-front-desk").map((o) => (
        <a class="chip" href={`/services/${o.slug}`}>{o.name}</a>
      ))}
    </div>
  </div>
</section>

<section class="section section-tint" id="contact">
  <div class="container split">
    <div>
      <h2 class="heading-lg">Questions first.</h2>
      <p class="body-lg" style="margin-top:1rem">
        If you do not want to pay without talking, say so here. No payment due to ask.
        Call {AA_PUBLIC_PHONE_DISPLAY} if that is faster.
      </p>
      <p class="fine-print" style="margin-top:2rem">
        <a class="text-link" href={AA_PUBLIC_PHONE_HREF}>Call {AA_PUBLIC_PHONE_DISPLAY}</a>
      </p>
    </div>
    <BookCall
      heading="Pick a time on the live calendar"
      note="Fifteen minutes on the Visibility Install. Straight answer on whether the five items fit the site you already have. No payment due now."
    />
  </div>
</section>
