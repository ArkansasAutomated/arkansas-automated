---
import BookCall from "./BookCall.astro";
import HeroAsk from "./HeroAsk.astro";
import { serviceBySlug } from "../data/services";
import { AA_PUBLIC_PHONE_DISPLAY, AA_PUBLIC_PHONE_HREF } from "../lib/public-phone";
import { VISIBILITY_INSTALL_URL } from "../lib/visibility-install-checkout";

interface Property {
  name: string;
  role: string;
  host: string;
  url: string;
}

interface Props {
  home?: boolean;
  properties?: Property[];
}

const { home = false, properties = [] } = Astro.props;
const s = serviceBySlug("visibility-install");
const payUrl = VISIBILITY_INSTALL_URL;
const checkoutMailto =
  "mailto:dre@arkansasautomated.com?subject=Visibility%20Install%20checkout";
const primaryHref = payUrl || checkoutMailto;
const primaryLabel = payUrl ? "Pay $2,500 to start" : "Send me the checkout link";

const leaks = [
  {
    h: "Searching your name was never the fight",
    p: "If they already know you, they find you. The jobs you never hear about are the ones where a stranger asked who to hire nearby.",
  },
  {
    h: "Buyers already ask ChatGPT",
    p: "Google AI and Perplexity too. They get an answer either way, often from a directory, a competitor, or a page you forgot you published.",
  },
  {
    h: "Your site is hard for a machine to read",
    p: "Mixed titles. Three headlines. Town, license, and what you actually sell buried. AI fills the gaps with the other guy.",
  },
  {
    h: "A one-file hack is not a plan",
    p: "Dropping llms.txt on the server does not make you the answer. We are not selling you another file.",
  },
];

const fixes = [
  {
    h: "One headline per page",
    p: "It names the work and the town. Not Home. HVAC repair in Fort Smith.",
  },
  {
    h: "Facts a machine can actually read",
    p: "Name, address, hours, license. The same facts you would tell a customer standing in the shop.",
  },
  {
    h: "Services listed once, clearly",
    p: "So ChatGPT knows what you sell, not a guess from an old blog post.",
  },
  {
    h: "A guide on your domain",
    p: "Answers the questions people ask before they call. Lives on your site, not a directory.",
  },
  {
    h: "One button, junk pages out",
    p: "Junk URLs hidden from search. Call or book, same action on every page.",
  },
];
---

<div class="hero-frame">
  <div class="hero-stage-media" aria-hidden="true">
    <img
      class="hero-stage-bg"
      src="/images/hero-network.webp"
      alt=""
      width="1122"
      height="1402"
      fetchpriority="high"
    />
    <div class="hero-stage-scrim"></div>
    <div class="hero-stage-grain"></div>
  </div>
  <section class="hero-stage" id="install">
    <div class="container hero-stage-grid">
    <div class="hero-stage-copy">
      {
        !home && (
          <nav class="crumbs crumbs-on-dark" aria-label="Breadcrumb">
            <a href="/">Home</a><span>/</span><a href="/services">Services</a><span>/</span>{s.name}
          </nav>
        )
      }
      <h1 class="heading-xl enter">When a buyer asks ChatGPT who to hire, it should name you.</h1>
      <p class="body-lg enter enter-2">
        Five fixes on the website you already have. Live in 14 days from access.
        $2,500 to start, then $497 a month for 90 days. Card only. This does not answer your phone.
      </p>
      <div class="hero-ctas one enter enter-3">
        <div class="cta-choice">
          <a class="btn btn-primary" href={primaryHref}>{primaryLabel}</a>
          <p class="guarantee">
            If the five fixes are not live in 14 days, we keep working at no extra setup
            cost, or we refund the $2,500. You keep every asset.
          </p>
        </div>
      </div>
    </div>
    <HeroAsk />
  </div>
  </section>
</div>

<section class="proof-strip" aria-labelledby="vi-proof-title">
  <div class="container">
    <div class="proof-strip-grid">
      <div>
        <h2 id="vi-proof-title">Five published fixes. You keep every one.</h2>
        <p>The clock starts when we have website, Google Business Profile, and Search Console access. Not at payment.</p>
      </div>
      <ul>
        <li>Live in 14 days from access</li>
        <li>Delivery guarantee, not a ranking</li>
        <li>90-day term, then month to month</li>
      </ul>
    </div>
  </div>
</section>

{
  home && properties.length > 0 && (
    <section class="section" id="proof">
      <div class="container">
        <h2 class="heading-lg measure">We run this playbook on our own properties.</h2>
        <p class="body-lg measure" style="margin-top:1rem">
          Arkansas Automated builds and operates the local directories and service sites below.
          They are live, so you can check them. We do not have named Visibility Install case studies yet.
          We are not going to invent them.
        </p>
        <div class="props">
          {properties.map((p) => (
            <a class="prop" href={p.url} target="_blank" rel="noopener">
              <span class="prop-name">{p.name}</span>
              <span class="prop-role">{p.role}</span>
              <span class="prop-host">{p.host}</span>
            </a>
          ))}
        </div>
      </div>
    </section>
  )
}

<figure class="photo-band">
  <img
    src="/images/shops-network.webp"
    alt="Storefronts, a trade shop, and a clinic on the same local map."
    width="1122"
    height="1010"
  />
  <figcaption>The jobs you never hear about start here. A stranger asks. AI names somebody.</figcaption>
</figure>

<section class="section section-tint">
  <div class="container">
    <h2 class="heading-lg measure">The jobs you never hear about.</h2>
    <p class="body-lg measure" style="margin-top:1rem">
      A stranger in your town asks who to call. AI names somebody. If your site is a mess of
      old titles and buried facts, that somebody is rarely you.
    </p>
    <div class="leak-grid">
      {
        leaks.map((l) => (
          <article class="leak">
            <h3>{l.h}</h3>
            <p>{l.p}</p>
          </article>
        ))
      }
    </div>
  </div>
</section>

<section class="section">
  <div class="container">
    <h2 class="heading-lg measure">What you actually get.</h2>
    <div class="rows row-stack">
      {
        fixes.map((item, idx) => (
          <article class="row">
            <div class="row-n">{String(idx + 1).padStart(2, "0")}</div>
            <h3>{item.h}</h3>
            <p>{item.p}</p>
          </article>
        ))
      }
    </div>
    <p class="form-note" style="margin-top:1.5rem">
      You also get screenshots on day 0 and day 14 of the same buyer questions asked of ChatGPT.
      Not in this fee: a new website, ads, social posting, a booking-system move, or the AI front desk.
    </p>
    <div class="hero-ctas one" style="margin-top:1.5rem">
      <div class="cta-choice">
        <a class="btn btn-primary" href={primaryHref}>{primaryLabel}</a>
        <p class="guarantee">Card today. Monthly starts after the install. Card only. No Affirm or Afterpay.</p>
      </div>
    </div>
  </div>
</section>

<section class="section section-tint">
  <div class="container">
    <h2 class="heading-lg measure">How the 14 days run.</h2>
    <div class="rows">
      {
        s.process.map((p, idx) => (
          <article class="row">
            <div class="row-n">{String(idx + 1).padStart(2, "0")}</div>
            <h3>{p.h}</h3>
            <p>{p.p}</p>
          </article>
        ))
      }
    </div>
  </div>
</section>

<section class="section">
  <div class="container">
    <h2 class="heading-lg measure">$2,500 setup. $497 a month. 90 days.</h2>
    <div class="rows" style="margin-top:1.5rem">
      <article class="row">
        <div class="row-n">01</div>
        <h3>$2,500 once</h3>
        <p>The 14-day install of all five fixes.</p>
      </article>
      <article class="row">
        <div class="row-n">02</div>
        <h3>$497 a month</h3>
        <p>New pages stay titled, readable, and on one button. Facts updated when they change.</p>
      </article>
      <article class="row">
        <div class="row-n">03</div>
        <h3>90-day term</h3>
        <p>Then month to month. Cancel anytime after day 90. Card only. No Affirm or Afterpay.</p>
      </article>
    </div>
    <p class="body-lg measure" style="margin-top:2rem">
      If the five fixes are not live within 14 days of access, we keep working at no extra
      setup cost until they are, or we refund the $2,500. Live means published. It does not
      mean a ranking we cannot control.
    </p>
  </div>
</section>

<section class="section section-tint">
  <div class="container faq-wrap">
    <h2 class="heading-lg measure">Straight answers.</h2>
    <div class="faq-list">
      {
        s.faqs.map((f) => (
          <details class="faq-item">
            <summary>{f.q}</summary>
            <p>{f.a}</p>
          </details>
        ))
      }
    </div>
  </div>
</section>

<section class="section section-tint" id="contact">
  <div class="container">
    <h2 class="heading-lg">Start today. Be live in 14 days from access.</h2>
    <p class="body-lg measure" style="margin-top:1.15rem">
      Pay the setup, send access, approve copy. If you do not want to pay without talking,
      use the calendar or call {AA_PUBLIC_PHONE_DISPLAY}. No payment due to ask.
    </p>
    <div class="hero-ctas one" style="margin-top:1.5rem">
      <div class="cta-choice">
        <a class="btn btn-primary" href={primaryHref}>{primaryLabel}</a>
        <p class="guarantee">Last updated September 2026. Written by Andre Brassfield.</p>
      </div>
    </div>
    <div class="split" style="margin-top:3rem">
      <div>
        <h2 class="heading-md">Questions first.</h2>
        <p class="body-lg" style="margin-top:1rem">
          Fifteen minutes. Straight answer on whether the five fixes fit the site you already have.
        </p>
        <p class="fine-print" style="margin-top:1.25rem">
          <a class="text-link" href={AA_PUBLIC_PHONE_HREF}>Call {AA_PUBLIC_PHONE_DISPLAY}</a>
        </p>
        <p class="form-note" style="margin-top:1.5rem">
          Need the phone answered instead? Same price, different job.
          <a class="text-link" href="/services/ai-front-desk">AI front desk</a>
          or
          <a class="text-link" href="/services/front-door">Front Door $497</a>
          if you do not have a site yet.
        </p>
      </div>
      <BookCall
        heading="Pick a time on the live calendar"
        note="Fifteen minutes. Straight answer on whether the five fixes fit the site you already have. No payment due now."
      />
    </div>
  </div>
</section>
