---
/*
 * /vendra - public product page for Vendra.
 *
 * Vendra is the product name. Arkansas Automated is the company. This page
 * lives on the parent domain so early proof and search authority stay here.
 * Merchant activation is token-scoped and does not start from this page.
 */
import Base from "../layouts/Base.astro";
import SiteNav from "../components/SiteNav.astro";
import SiteFooter from "../components/SiteFooter.astro";
import LeadForm from "../components/LeadForm.astro";

const title = "Vendra | Sales Reporting for Modern Shopping Centers";
const description =
  "Merchants automate monthly sales reporting for $29/month through a property-manager invite. Stay compliant without changing payment processing.";

const site = "https://arkansasautomated.com";
const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "SoftwareApplication",
      name: "Vendra",
      applicationCategory: "BusinessApplication",
      operatingSystem: "Web",
      url: `${site}/vendra`,
      description,
      provider: {
        "@type": "ProfessionalService",
        name: "Arkansas Automated",
        url: site,
      },
      offers: {
        "@type": "Offer",
        availability: "https://schema.org/LimitedAvailability",
        description: "Controlled shopping-center rollout. Merchants pay $29/month and activate through a property-manager invite.",
      },
    },
    {
      "@type": "BreadcrumbList",
      itemListElement: [
        { "@type": "ListItem", position: 1, name: "Home", item: `${site}/` },
        { "@type": "ListItem", position: 2, name: "Vendra", item: `${site}/vendra` },
      ],
    },
  ],
};

const steps = [
  {
    n: "01",
    h: "Confirm the store and choose a path",
    p: "The merchant confirms the storefront, then chooses a supported POS connection or the CSV they already export.",
    t: "About 1 minute",
  },
  {
    n: "02",
    h: "Connect or upload, then review the preview",
    p: "Square and Clover are the supported live-connection targets. Any other register can stay on a validated CSV upload.",
    t: "About 3-6 minutes",
  },
  {
    n: "03",
    h: "Review the month and certify when prompted",
    t: "About 1-3 minutes",
    p: "Once the store is in the workflow, monthly review and manager certification happen in one place.",
  },
];

const bounds = [
  {
    h: "What Vendra does",
    p: "It helps a store complete the shopping center's monthly sales-reporting workflow. After setup, the merchant reviews the report and completes manager certification through one process.",
  },
  {
    h: "What Vendra does not do",
    p: "It does not change how a store accepts customer payments, and it does not require a POS replacement. It is not a payment processor. Live ERP delivery, SMS, and transactional email are not claimed until those provider paths are activated and certified.",
  },
];
---

<Base title={title} description={description} path="/vendra" schema={schema}>
  <SiteNav />
  <main>
    <section class="hero">
      <div class="container hero-grid">
        <div>
          <nav class="crumbs" aria-label="Breadcrumb">
            <a href="/">Home</a><span>/</span>Vendra
          </nav>
          <h1 class="heading-xl">Automate your monthly sales report before the next deadline.</h1>
          <p class="body-lg">
            Most shopping-center leases require monthly sales reporting. Missing deadlines can trigger penalties. Vendra keeps your store compliant for <strong>$29/month</strong> — no POS replacement, no change to how you accept payments.
          </p>
          <div class="hero-ctas">
            <a class="btn btn-primary" href="#activate">Get my store activated</a>
            <a class="btn btn-secondary" href="#how">How activation works</a>
          </div>
          <p class="fine-print" style="margin-top:1rem">
            No payment until your property is enrolled. Activation only happens after your property manager invites your store.
          </p>
        </div>
        <figure class="hero-figure">
          <img
            src="/images/vendra-hero.webp"
            alt="A shopping-center concourse with storefronts open for business"
            width="1280"
            height="720"
          />
        </figure>
      </div>
    </section>

    <section class="section section-tint">
      <div class="container">
        <p class="measure body-lg" style="margin:0">
          Vendra is an Arkansas Automated solution. Each store subscribes for <strong>$29/month</strong>; the mall team coordinates the cohort and views reporting status without covering per-store costs.
        </p>
        <div class="leak-grid" style="margin-top:3rem">
          {
            bounds.map((item) => (
              <article class="leak">
                <h2 class="heading-md">{item.h}</h2>
                <p>{item.p}</p>
              </article>
            ))
          }
        </div>
      </div>
    </section>

    <section class="section" id="how">
      <div class="container">
        <h2 class="heading-lg measure">Walk in, scan, and leave the store in the monthly workflow.</h2>
        <p class="body-lg measure" style="margin-top:1.15rem">
          The operator prepares a store-specific invite. The merchant scans a QR code or
          opens the link, then chooses the path that already matches how they close the
          register.
        </p>
        <div class="rows">
          {
            steps.map((s) => (
              <article class="row">
                <div class="row-n">{s.n}</div>
                <div>
                  <h3>{s.h}</h3>
                  <p class="fine-print" style="margin-top:0.35rem">{s.t}</p>
                </div>
                <p>{s.p}</p>
              </article>
            ))
          }
        </div>
      </div>
    </section>

    <section class="section section-tint" id="activate">
      <div class="container split">
        <div>
          <h2 class="heading-lg">Get your store activated.</h2>
          <p class="body-lg" style="margin-top:1.15rem">
            Central Mall is the first coordinated Arkansas shopping-center rollout. Participating stores are being invited individually through property management. Submit your store info and we’ll confirm enrollment status within one business day.
          </p>
          <p class="body-lg" style="margin-top:1.15rem">
            Questions go to
            <a class="text-link" href="mailto:dre@arkansasautomated.com">dre@arkansasautomated.com</a>.
            The product app stays on a Vendra host. This page is the public overview.
          </p>
        </div>
        <LeadForm
          variant="merchant"
          formId="vendra-activate"
          defaultIntent="Merchant store activation"
          submitLabel="Check if my property participates"
          detailsPlaceholder="Example: Central Mall store #104, or the mall/property where your store is located."
        />
      </div>
    </section>

    <section class="section">
      <div class="container">
        <p class="heading-md" style="margin:0">First-mover status</p>
        <p class="body-lg" style="margin-top:0.45rem">
          Central Mall is the first coordinated Arkansas shopping-center rollout. Square and Clover connections are supported. Live POS callback delivery is in active certification; CSV upload is available now for any register type.
        </p>
      </div>
    </section>

    <section class="section section-tint">
      <div class="container">
        <h2 class="heading-lg measure">FAQ</h2>
        <div class="faq-list">
          <article>
            <h3>Does this change how I accept payments?</h3>
            <p>No. Vendra is not a payment processor and does not require a POS replacement.</p>
          </article>
          <article>
            <h3>Who pays?</h3>
            <p>The store pays $29/month. There is no charge to the property.</p>
          </article>
          <article>
            <h3>What if my POS isn’t supported?</h3>
            <p>CSV upload is available for any register type.</p>
          </article>
          <article>
            <h3>Is there a contract?</h3>
            <p>Monthly subscription. Cancel when your property is no longer participating.</p>
          </article>
        </div>
      </div>
    </section>

    <section class="section">
      <div class="container split">
        <article>
          <h2 class="heading-md">For the mall team</h2>
          <p class="body-lg" style="margin-top:0.85rem">
            A consistent view of reporting status, a cleaner follow-up path on exceptions, and an auditable record of the completed workflow. Property managers receive activation materials, invite tokens, and exception-status summaries.
          </p>
        </article>
        <article>
          <h2 class="heading-md">For merchants</h2>
          <p class="body-lg" style="margin-top:0.85rem">
            A 5-10 minute activation, then one monthly process. Payment-taking does not change. CSV remains available if a POS connection is the wrong fit.
          </p>
        </article>
      </div>
    </section>

    <section class="section section-tint">
      <div class="container">
        <p class="heading-md" style="margin:0">Vendra</p>
        <p class="body-lg" style="margin-top:0.45rem">Sales reporting for modern shopping centers.</p>
        <p class="fine-print" style="margin-top:0.7rem">An Arkansas Automated solution</p>
      </div>
    </section>
  </main>
  <SiteFooter />
</Base>
