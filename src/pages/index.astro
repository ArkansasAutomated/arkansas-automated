---
import Base from "../layouts/Base.astro";
import SiteNav from "../components/SiteNav.astro";
import SiteFooter from "../components/SiteFooter.astro";
import VisibilityInstallOffer from "../components/VisibilityInstallOffer.astro";
import { AA_PUBLIC_PHONE_E164 } from "../lib/public-phone";
import { serviceBySlug } from "../data/services";

const s = serviceBySlug("visibility-install");

const title = "Does ChatGPT know your business exists? | Arkansas Automated";
const description =
  "Visibility Install for Arkansas service businesses. Five inspectable items on the site you already have, live in 14 days from access. $2,500 setup, then $497 a month. Not a ranking promise. Not the AI front desk.";

const properties = [
  {
    name: "Fort Smith Directory",
    role: "Local directory and lead pipeline for the River Valley",
    host: "fortsmithdirectory.com",
    url: "https://fortsmithdirectory.com",
  },
  {
    name: "NWA Automated",
    role: "Automation practice for Northwest Arkansas businesses",
    host: "nwaautomated.com",
    url: "https://nwaautomated.com",
  },
  {
    name: "Smart Home NWA",
    role: "Residential automation and installation",
    host: "smarthomenwa.com",
    url: "https://smarthomenwa.com",
  },
  {
    name: "Good Garage Co.",
    role: "Garage cleanout and storage systems",
    host: "goodgarageco.com",
    url: "https://goodgarageco.com",
  },
];

const homeSchema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": ["Organization", "ProfessionalService"],
      name: "Arkansas Automated",
      url: "https://arkansasautomated.com",
      telephone: AA_PUBLIC_PHONE_E164,
      description,
      sameAs: properties.map((p) => p.url),
      areaServed: [
        { "@type": "AdministrativeArea", name: "Fort Smith, Arkansas" },
        { "@type": "AdministrativeArea", name: "Northwest Arkansas" },
        { "@type": "State", name: "Arkansas" },
      ],
      serviceType: [
        "Visibility Install",
        "AI search visibility",
        "AI front desk",
        "Front Door websites",
      ],
    },
    {
      "@type": "WebSite",
      name: "Arkansas Automated",
      url: "https://arkansasautomated.com",
    },
    {
      "@type": "Service",
      name: s.name,
      provider: { "@type": "ProfessionalService", name: "Arkansas Automated", url: "https://arkansasautomated.com" },
      areaServed: { "@type": "State", name: "Arkansas" },
      description: s.answer,
    },
    {
      "@type": "FAQPage",
      mainEntity: s.faqs.map((f) => ({
        "@type": "Question",
        name: f.q,
        acceptedAnswer: { "@type": "Answer", text: f.a },
      })),
    },
  ],
};
---

<Base title={title} description={description} path="/" schema={homeSchema}>
  <SiteNav />
  <main id="main-content" tabindex="-1">
    <VisibilityInstallOffer home />

    <section class="section" id="proof">
      <div class="container">
        <h2 class="heading-lg measure">We run this playbook on our own properties.</h2>
        <p class="body-lg measure" style="margin-top:1rem">
          Arkansas Automated builds and operates the local directories and service sites below.
          They are live, so you can check them.
        </p>
        <div class="props">
          {
            properties.map((p) => (
              <a class="prop" href={p.url} target="_blank" rel="noopener">
                <span class="prop-name">{p.name}</span>
                <span class="prop-role">{p.role}</span>
                <span class="prop-host">{p.host}</span>
              </a>
            ))
          }
        </div>
      </div>
    </section>
  </main>
  <SiteFooter />
</Base>
