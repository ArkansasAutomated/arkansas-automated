---
import Base from "../layouts/Base.astro";
import SiteNav from "../components/SiteNav.astro";
import SiteFooter from "../components/SiteFooter.astro";
import AdvisorHome from "../components/AdvisorHome.astro";
import { AA_PUBLIC_PHONE_E164 } from "../lib/public-phone";
import { serviceBySlug } from "../data/services";

const audit = serviceBySlug("operations-audit");

const title = "AI Consultant in Fort Smith | Arkansas Automated";
const description =
  "Andre Brassfield finds the process bleeding money in Fort Smith and Northwest Arkansas businesses and fixes it with AI. Free missed-call test. Leak audit $1,500, credited in full toward the first fix. Call (479) 282-3121.";

const properties = [
  {
    name: "Fort Smith Directory",
    role: "Local directory and lead pipeline for the River Valley",
    host: "fortsmithdirectory.com",
    url: "https://fortsmithdirectory.com",
  },
  {
    name: "NWA Automated",
    role: "Automation practice for Northwest Arkansas businesses",
    host: "nwaautomated.com",
    url: "https://nwaautomated.com",
  },
  {
    name: "Smart Home NWA",
    role: "Residential automation and installation",
    host: "smarthomenwa.com",
    url: "https://smarthomenwa.com",
  },
  {
    name: "Good Garage Co.",
    role: "Garage cleanout and storage systems",
    host: "goodgarageco.com",
    url: "https://goodgarageco.com",
  },
];

const homeSchema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": ["Organization", "ProfessionalService"],
      "@id": "https://arkansasautomated.com/#organization",
      name: "Arkansas Automated",
      legalName: "Brassfield Ventures LLC",
      url: "https://arkansasautomated.com",
      telephone: AA_PUBLIC_PHONE_E164,
      description,
      disambiguatingDescription:
        "AI consultant and business automation company operated by Brassfield Ventures LLC, serving Rogers and Fort Smith, Arkansas. Not affiliated with Arkansas Automated Security, LLC of Mayflower, a separate security and alarm installer.",
      founder: { "@id": "https://arkansasautomated.com/about#andre-brassfield" },
      sameAs: properties.map((p) => p.url),
      areaServed: [
        { "@type": "City", name: "Rogers, Arkansas" },
        { "@type": "City", name: "Fort Smith, Arkansas" },
        { "@type": "AdministrativeArea", name: "Northwest Arkansas" },
        { "@type": "State", name: "Arkansas" },
      ],
      serviceType: [
        "AI consulting",
        "AI operations audit",
        "AI front desk",
      ],
    },
    {
      "@type": "Person",
      "@id": "https://arkansasautomated.com/about#andre-brassfield",
      name: "Andre Brassfield",
      jobTitle: "Founder",
      url: "https://arkansasautomated.com/about",
      worksFor: { "@id": "https://arkansasautomated.com/#organization" },
    },
    {
      "@type": "WebSite",
      name: "Arkansas Automated",
      url: "https://arkansasautomated.com",
      publisher: { "@id": "https://arkansasautomated.com/#organization" },
    },
    {
      "@type": "Service",
      name: audit.name,
      provider: { "@type": "ProfessionalService", name: "Arkansas Automated", url: "https://arkansasautomated.com" },
      areaServed: { "@type": "State", name: "Arkansas" },
      description: audit.answer,
      offers: {
        "@type": "Offer",
        price: "1500",
        priceCurrency: "USD",
        url: "https://arkansasautomated.com/audit",
      },
    },
    {
      "@type": "FAQPage",
      mainEntity: audit.faqs.map((f) => ({
        "@type": "Question",
        name: f.q,
        acceptedAnswer: { "@type": "Answer", text: f.a },
      })),
    },
  ],
};
---

<Base title={title} description={description} path="/" schema={homeSchema}>
  <SiteNav overHero />
  <main id="main-content" tabindex="-1">
    <AdvisorHome properties={properties} />
  </main>
  <SiteFooter />
</Base>
