---
import Base from "../layouts/Base.astro";
import SiteNav from "../components/SiteNav.astro";
import SiteFooter from "../components/SiteFooter.astro";
import LeadForm from "../components/LeadForm.astro";

const title = "AI Workshops and Done-For-You Automation in Arkansas | Arkansas Automated";
const description =
  "In-person AI workshops for Arkansas business owners. Build your AI receptionist in one afternoon, or have us build and run the automation for you.";

const leaks = [
  {
    h: "Calls that reach voicemail",
    p: "An unanswered call is not a message in a queue. It is a customer dialing the next name on the list while your crew is under a truck.",
  },
  {
    h: "Quotes that wait overnight",
    p: "A request lands after hours and goes out the next afternoon. By then the buyer is holding three other numbers and yours is not the first callback.",
  },
  {
    h: "The same job, typed three times",
    p: "Details captured in the field, rekeyed into the CRM, rekeyed again into accounting. You are paying three times for one piece of information.",
  },
  {
    h: "Follow-up that runs on memory",
    p: "Estimates go cold because the second and third touch belong to nobody in particular. The work was already won and then quietly lost.",
  },
];

const agenda = [
  {
    t: "1:00",
    h: "The cost of a missed call",
    p: "What after-hours voicemail actually costs a local service business, and what a human receptionist versus an AI front desk runs per month.",
  },
  {
    t: "1:45",
    h: "Watch it answer",
    p: "Live demo. An AI receptionist picks up, qualifies the caller, captures the job details, and books it against a real calendar.",
  },
  {
    t: "2:30",
    h: "Build yours",
    p: "Configure your own version: your greeting, your services, your calendar, your SMS handoff. No code, and we build it together.",
  },
  {
    t: "4:00",
    h: "Test it live",
    p: "Call your own number from the room. Set the guardrails and escalation rules. Then decide: run it yourself, or hand it to us.",
  },
];

const included = [
  "A working AI receptionist prototype configured for your business",
  "Your calendar and SMS follow-up wired in before you leave",
  "Escalation rules you set and test yourself",
  "30 days of email support after the session",
  "Your seat price credited toward a done-for-you build started within 60 days",
  "A room capped at 18 owners, so your questions get answered",
];

const paths = [
  {
    k: "Build with us",
    h: "Leave the workshop with a working prototype",
    p: "$497 early bird. Spend one Saturday building, testing, and understanding an AI front desk configured for your business.",
  },
  {
    k: "Have us build it",
    h: "Pay for the outcome, not the training",
    p: "Start with a free 15-minute fit assessment. If the numbers work, we can audit, build, launch, and manage the system for you.",
  },
];

const packages = [
  {
    price: "$2,500 + $497/mo",
    h: "AI front desk",
    p: "Answers 24/7 in your business's voice, qualifies the caller, and books straight onto your calendar. SMS follow-up, call recordings, and monthly tuning included.",
  },
  {
    price: "$1,500 to $5,000 + monthly",
    h: "Workflow automation",
    p: "Lead to quote to job to invoice, without the retyping and the follow-up gaps. Built on the tools you already pay for.",
  },
  {
    price: "From $2,000/mo",
    h: "Embedded retainer",
    p: "We come to you. On-site working sessions, a continuous build-out of custom workflows, priority turnaround, and staff training included.",
  },
];

const faqs = [
  {
    q: "I am not technical. Will I keep up in the workshop?",
    a: "Yes. The workshop is built for owners, not engineers. Everything is no-code, we build step by step together, and the room is capped at 18 so nobody gets left behind. If you can run a smartphone, you can do this.",
  },
  {
    q: "What exactly do I leave with?",
    a: "A working AI receptionist prototype configured for your business: your greeting, your services, your calendar, and SMS follow-up. You will call it live before you leave. Keep running it yourself, or hand it to us to productionize and manage.",
  },
  {
    q: "What if I would rather not sit through a workshop?",
    a: "That is exactly what the done-for-you work is for. Start with the free 15-minute assessment call, and if the ROI is there we build and manage everything, including on-site work under the retainer.",
  },
  {
    q: "What does it cost after the workshop?",
    a: "Nothing is required. If you want us to run it, the AI front desk is $2,500 setup plus $497 a month. Larger workflow builds run $1,500 to $5,000 setup. Your seat price credits toward any build started within 60 days.",
  },
  {
    q: "Does the AI receptionist sound robotic?",
    a: "You will hear it in the first hour of the workshop, or on your assessment call with your own business details loaded. It answers in your business's voice, follows your rules, and hands off to a human whenever you say so.",
  },
  {
    q: "When and where do workshops run?",
    a: "Saturday afternoons, 1 to 5 PM, in Fort Smith, with Northwest Arkansas sessions as demand grows. The room address goes out with your seat confirmation. Private workshops for one company or one trade are available on request.",
  },
];

const properties = [
  {
    name: "Fort Smith Directory",
    role: "Local directory and lead pipeline for the River Valley",
    host: "fortsmithdirectory.com",
    url: "https://fortsmithdirectory.com",
  },
  {
    name: "NWA Automated",
    role: "Automation practice for Northwest Arkansas businesses",
    host: "nwaautomated.com",
    url: "https://nwaautomated.com",
  },
  {
    name: "Smart Home NWA",
    role: "Residential automation and installation",
    host: "smarthomenwa.com",
    url: "https://smarthomenwa.com",
  },
  {
    name: "Good Garage Co.",
    role: "Garage cleanout and storage systems",
    host: "goodgarageco.com",
    url: "https://goodgarageco.com",
  },
];

// Homepage schema: ProfessionalService + WebSite + FAQPage. The FAQPage
// mirrors the visible FAQ section exactly (schema must match page content).
const homeSchema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "ProfessionalService",
      name: "Arkansas Automated",
      url: "https://arkansasautomated.com",
      description,
      // Real alternative representations of the same operator (Brassfield
      // Ventures), shown on this page in the "We run this playbook on our own
      // properties" section. No invented social profiles (PROTOCOL 10).
      sameAs: properties.map((p) => p.url),
      areaServed: [
        { "@type": "AdministrativeArea", name: "Fort Smith, Arkansas" },
        { "@type": "AdministrativeArea", name: "Northwest Arkansas" },
        { "@type": "State", name: "Arkansas" },
      ],
      serviceType: [
        "AI workshops and training",
        "Workflow automation",
        "AI implementation",
        "CRM integration",
        "Business process automation",
      ],
    },
    {
      "@type": "WebSite",
      name: "Arkansas Automated",
      url: "https://arkansasautomated.com",
    },
    {
      "@type": "FAQPage",
      mainEntity: faqs.map((f) => ({
        "@type": "Question",
        name: f.q,
        acceptedAnswer: { "@type": "Answer", text: f.a },
      })),
    },
  ],
};
---

<Base title={title} description={description} path="/" schema={homeSchema}>
  <SiteNav />

  <main>
    <section class="hero">
      <div class="container hero-grid">
        <div>
          <p class="hero-kicker enter">Practical AI for Arkansas service businesses</p>
          <h1 class="heading-xl enter">Every call answered. Every lead followed up.</h1>
          <p class="body-lg enter enter-2">
            Build a working AI front desk in one Saturday workshop, or let our Arkansas team
            implement and manage it for you.
          </p>
          <div class="hero-ctas enter enter-3">
            <div class="cta-choice">
              <a class="btn btn-primary" href="#workshop-request">Build mine in the workshop</a>
              <span>Fort Smith · Saturdays, 1–5 PM · $497 early bird</span>
            </div>
            <div class="cta-choice">
              <a class="btn btn-secondary" href="#assessment-request">Book a 15-minute fit assessment</a>
              <span>No payment today. We will tell you if the numbers do not make sense.</span>
            </div>
          </div>
          <a class="tool-link enter enter-3" href="/ai-opportunity-map/">Not sure which path fits? Map your next move <span>→</span></a>
        </div>
        <figure class="hero-figure enter enter-2">
          <img
            src="/images/hero-workshop.webp"
            alt="Facilitator demonstrating an AI phone dashboard to business owners seated around a workshop table"
            width="2048"
            height="1062"
            fetchpriority="high"
            decoding="async"
          />
        </figure>
      </div>
    </section>

    <section class="proof-strip" aria-labelledby="proof-strip-title">
      <div class="container proof-strip-grid">
        <div>
          <h2 id="proof-strip-title">See where automation stops before you buy it.</h2>
          <p>We demonstrate the full call path: answer, qualify, book, follow up, and hand off to a person.</p>
        </div>
        <ul>
          <li>Test the prototype live</li>
          <li>Set your own escalation rules</li>
          <li>Keep judgment and exceptions human</li>
        </ul>
      </div>
    </section>

    <section class="section section-tint" id="missed-calls">
      <div class="container">
        <h2 class="heading-lg measure">How many calls went to voicemail last weekend?</h2>
        <p class="body-lg measure" style="margin-top:1rem">
          For a local service business, the leak is never one big line item. It is a dozen small
          handoffs that each cost an hour, repeated every week.
        </p>
        <div class="leak-grid">
          {
            leaks.map((l) => (
              <article class="leak">
                <h3>{l.h}</h3>
                <p>{l.p}</p>
              </article>
            ))
          }
        </div>
      </div>
    </section>

    <section class="section" id="workshop">
      <div class="container">
        <span class="eyebrow">The workshop</span>
        <h2 class="heading-lg measure">One afternoon. Your own AI front desk, working.</h2>
        <p class="body-lg measure" style="margin-top:1rem">
          A half-day, in-person session in Fort Smith. You watch a live AI receptionist work, then
          build your own with help in the room, then call it yourself before you leave.
        </p>

        <div class="workshop-grid">
          <div class="rows">
            {
              agenda.map((a) => (
                <article class="row">
                  <div class="row-n">{a.t}</div>
                  <h3>{a.h}</h3>
                  <p>{a.p}</p>
                </article>
              ))
            }
          </div>
          <figure class="workshop-figure">
            <img
              src="/images/workshop-hands.webp"
              alt="Workshop participant testing his new AI receptionist from his own phone"
              width="1536"
              height="944"
              loading="lazy"
              decoding="async"
            />
            <figcaption>Test call from the room, before you leave.</figcaption>
          </figure>
        </div>

        <div class="facts">
          <div class="fact"><span class="fact-k">When</span> Saturdays, 1 to 5 PM</div>
          <div class="fact"><span class="fact-k">Where</span> Fort Smith, address with confirmation</div>
          <div class="fact"><span class="fact-k">Room</span> Capped at 18 owners</div>
          <div class="fact"><span class="fact-k">Price</span> $497 early bird, $697 standard</div>
          <div class="fact"><span class="fact-k">Second seat</span> $297 for a partner or office manager</div>
        </div>

        <ul class="included">
          {included.map((i) => <li>{i}</li>)}
        </ul>

        <a class="btn btn-primary" href="#workshop-request" style="margin-top:2.5rem">Build mine in the workshop</a>
      </div>
    </section>

    <section class="section section-tint" id="paths">
      <div class="container">
        <h2 class="heading-lg measure">Build it with us—or have us build it.</h2>
        <div class="phases">
          {
            paths.map((p) => (
              <article class="phase">
                <span class="phase-k">{p.k}</span>
                <h3>{p.h}</h3>
                <p>{p.p}</p>
              </article>
            ))
          }
        </div>
        <p class="body-lg measure" style="margin-top:2.25rem;font-size:1rem">
          Need the workflow mapped before a build? The $999 operations audit is available inside
          the done-for-you path. Workshop and audit fees credit toward a build started within 60 days.
        </p>
      </div>
    </section>

    <section class="section" id="done-for-you">
      <div class="container">
        <span class="eyebrow">Done for you</span>
        <h2 class="heading-lg measure">Too busy for a workshop? We come in and build it.</h2>
        <p class="body-lg measure" style="margin-top:1rem">
          For owners who would rather pay for the outcome than sit through the training. We price
          the result, not the tech, and every engagement starts with a free 15-minute assessment
          call.
        </p>
        <div class="rows">
          {
            packages.map((p) => (
              <article class="row row-pkg">
                <div class="row-n row-price">{p.price}</div>
                <h3>{p.h}</h3>
                <p>{p.p}</p>
              </article>
            ))
          }
        </div>
      </div>
    </section>

    <section class="section section-tint" id="boundary">
      <div class="container split">
        <div>
          <h2 class="heading-lg">What we will not automate.</h2>
        </div>
        <div>
          <p class="body-lg">
            Judgment, negotiation, pricing exceptions, and the conversations that decide whether
            somebody trusts your company stay with your people.
          </p>
          <p class="body-lg" style="margin-top:1.1rem">
            Good automation makes that line obvious instead of blurring it. If a system cannot
            state plainly where it stops and a human starts, it is not finished, and we will tell
            you so before the invoice, not after.
          </p>
        </div>
      </div>
    </section>

    <section class="section" id="proof">
      <div class="container">
        <h2 class="heading-lg measure">We run this playbook on our own properties.</h2>
        <p class="body-lg measure" style="margin-top:1rem">
          Arkansas Automated builds and operates the local directories and service sites below. The
          intake, routing, and follow-up systems we install for clients are the ones our own
          revenue depends on. They are live, so you can check them.
        </p>
        <div class="props">
          {
            properties.map((p) => (
              <a class="prop" href={p.url} target="_blank" rel="noopener">
                <span class="prop-name">{p.name}</span>
                <span class="prop-role">{p.role}</span>
                <span class="prop-host">{p.host}</span>
              </a>
            ))
          }
        </div>
      </div>
    </section>

    <section class="section section-tint" id="faq">
      <div class="container faq-wrap">
        <h2 class="heading-lg measure">Questions owners actually ask.</h2>
        <div class="faq-list">
          {
            faqs.map((f) => (
              <details class="faq-item">
                <summary>{f.q}</summary>
                <p>{f.a}</p>
              </details>
            ))
          }
        </div>
      </div>
    </section>

    <section class="section" id="reserve">
      <div class="container">
        <h2 class="heading-lg measure">Choose the next step that fits how you work.</h2>
        <p class="body-lg measure" style="margin-top:1rem">
          The workshop and managed-build paths are separate, so you only answer questions relevant to your request.
        </p>
        <div class="intent-forms">
          <section id="workshop-request" class="intent-form">
            <div class="intent-form-copy">
              <span class="phase-k">Build with us</span>
              <h3>Request a workshop seat</h3>
              <p>Fort Smith, Saturdays from 1–5 PM. We confirm availability, price, date, and the room address by email.</p>
            </div>
            <LeadForm variant="workshop" formId="workshop-form" detailsPlaceholder="Example: after-hours calls or booking estimates." />
          </section>
          <section id="assessment-request" class="intent-form">
            <div class="intent-form-copy">
              <span class="phase-k">Have us build it</span>
              <h3>Request a 15-minute fit assessment</h3>
              <p>Tell us what is breaking now. We will assess whether automation is practical before recommending a paid engagement.</p>
            </div>
            <LeadForm variant="assessment" formId="assessment-form" detailsPlaceholder="Example: missed calls, slow quote follow-up, or duplicate data entry." />
          </section>
        </div>
      </div>
    </section>
  </main>

  <SiteFooter />
</Base>
