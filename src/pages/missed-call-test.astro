---
import Base from "../layouts/Base.astro";
import SiteNav from "../components/SiteNav.astro";
import SiteFooter from "../components/SiteFooter.astro";
import LeadForm from "../components/LeadForm.astro";
import { AA_PUBLIC_PHONE_DISPLAY, AA_PUBLIC_PHONE_HREF } from "../lib/public-phone";

const title = "Free Missed-Call Test | Arkansas Automated";
const description =
  "Andre Brassfield calls your business line after the office is closed and sends a short recording of what happened. Free. Fort Smith and Northwest Arkansas. Not a sales meeting.";

const site = "https://arkansasautomated.com";
const schema = {
  "@context": "https://schema.org",
  "@type": "Service",
  name: "Missed-call test",
  serviceType: "AI consulting",
  provider: { "@type": "ProfessionalService", name: "Arkansas Automated", url: site },
  areaServed: { "@type": "State", name: "Arkansas" },
  description,
  offers: {
    "@type": "Offer",
    price: "0",
    priceCurrency: "USD",
  },
};
---

<Base title={title} description={description} path="/missed-call-test" schema={schema}>
  <SiteNav />
  <main id="main-content" tabindex="-1">
    <section class="hero">
      <div class="container">
        <nav class="crumbs" aria-label="Breadcrumb">
          <a href="/">Home</a><span>/</span>Missed-call test
        </nav>
        <h1 class="heading-xl measure">I call the line after you close.</h1>
        <p class="body-lg measure" style="margin-top:1.15rem">
          Send the business number and the hour the office is empty. I call it.
          You get a short recording of what a customer would have heard. If the line is fine, that is the result.
          This is not a 15-minute sales call.
        </p>
        <p class="body-lg measure" style="margin-top:1rem">
          If the leak is real, the next step is the
          {" "}<a class="text-link" href="/audit">$1,500 leak audit</a>.
          The test itself is free.
        </p>
      </div>
    </section>

    <section class="section section-tint" id="request">
      <div class="container split">
        <div>
          <h2 class="heading-lg">What to send</h2>
          <p class="body-lg" style="margin-top:1rem">
            The number customers call. When the office is closed. Your name, so I know who gets the recording.
          </p>
          <p class="body-lg" style="margin-top:1.1rem">
            Prefer to talk first? Call <a class="text-link" href={AA_PUBLIC_PHONE_HREF}>{AA_PUBLIC_PHONE_DISPLAY}</a>.
          </p>
        </div>
        <LeadForm
          formId="missed-call-test"
          defaultIntent="Missed-call test. Call the business line after hours and send a short recording."
          detailsPlaceholder="The number to call, and when the office is closed. Example: (479) 555-0100, closed after 5."
          submitLabel="Send the number"
          sourceService="missed-call-test"
        />
      </div>
    </section>
  </main>
  <SiteFooter />
</Base>
