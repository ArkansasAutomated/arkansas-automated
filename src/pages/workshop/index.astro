---
import Base from "../../layouts/Base.astro";
import SiteNav from "../../components/SiteNav.astro";
import SiteFooter from "../../components/SiteFooter.astro";
import LeadForm from "../../components/LeadForm.astro";
import { AA_PUBLIC_PHONE_DISPLAY, AA_PUBLIC_PHONE_HREF } from "../../lib/public-phone";

const title = "AI Front Desk workshop wait-list | Fort Smith";
const description =
  "The AI Front Desk workshop in Fort Smith has no date on the calendar yet. Join the wait-list and the next date reaches you before it opens to the public.";

const facts = [
  { label: "Length", value: "One Saturday, four hours" },
  { label: "Where", value: "Central Mall, Fort Smith, upstairs event room" },
  { label: "Size", value: "Capped at 18 owners" },
  { label: "Format", value: "A class, not one to one" },
  { label: "Seat", value: "$497" },
];
---

<Base {title} {description} path="/workshop">
  <SiteNav />
  <main>
    <section class="hero">
      <div class="container">
        <nav class="crumbs" aria-label="Breadcrumb">
          <a href="/">Home</a><span>/</span>Workshop
        </nav>
        <h1 class="heading-xl measure">No date on the calendar yet.</h1>
        <p class="body-lg measure" style="margin-top:1.15rem">
          The AI Front Desk workshop runs in Fort Smith. Nothing is scheduled right now, and we
          would rather tell you than have you check back every week. Join the wait-list and the
          next date reaches you before it opens to the public.
        </p>
        <div class="hero-ctas" style="margin-top:2rem">
          <a class="btn btn-primary" href="#waitlist">Join the wait-list</a>
          <a class="btn btn-secondary" href={AA_PUBLIC_PHONE_HREF}>Call {AA_PUBLIC_PHONE_DISPLAY}</a>
        </div>
      </div>
    </section>

    <section class="section">
      <div class="container">
        <h2 class="heading-lg measure">What the workshop is.</h2>
        <p class="body-lg measure" style="margin-top:1rem">
          One Saturday afternoon in Fort Smith. You work on your own business's front desk with
          help in the room, alongside other owners. It is a class, so bring your business and not
          a delegate.
        </p>
        <dl class="fact-list">
          {facts.map((f) => (
            <div class="fact">
              <dt>{f.label}</dt>
              <dd>{f.value}</dd>
            </div>
          ))}
        </dl>
        <p class="body-lg measure" style="margin-top:1.4rem">
          If a seat is not the right first step, book a 15-minute fit assessment instead. We will
          tell you whether the numbers make sense for your shop, and no payment happens on that
          call.
        </p>
        <div class="hero-ctas" style="margin-top:1.6rem">
          <a class="btn btn-secondary" href="https://book.arkansasautomated.com/book/discovery-call">Book a 15-minute fit assessment</a>
        </div>
      </div>
    </section>

    <section class="section" id="waitlist">
      <div class="container">
        <h2 class="heading-lg measure">Join the wait-list.</h2>
        <p class="body-lg measure" style="margin-top:1rem">
          Add your details and you get the next date before public registration opens. If the date
          does not work for you, say so and we will keep you on the list for the following one.
        </p>
        <div style="margin-top:1.8rem;max-width:34rem">
          <LeadForm variant="waitlist" formId="waitlist" submitLabel="Join the workshop wait-list" />
        </div>
      </div>
    </section>
  </main>
  <SiteFooter />
</Base>

<style>
  .fact-list {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(14rem, 1fr));
    gap: 1rem;
    margin: 1.8rem 0 0;
    padding: 0;
    max-width: 52rem;
  }
  .fact {
    border: 1px solid var(--line);
    background: var(--bg-secondary);
    padding: 0.9rem 1rem;
  }
  .fact dt {
    font-size: 0.75rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    opacity: 0.75;
  }
  .fact dd {
    margin: 0.35rem 0 0;
    font-size: 1.02rem;
  }
</style>
