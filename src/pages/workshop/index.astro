---
import Base from "../../layouts/Base.astro";
import SiteNav from "../../components/SiteNav.astro";
import SiteFooter from "../../components/SiteFooter.astro";
import { AA_PUBLIC_PHONE_DISPLAY, AA_PUBLIC_PHONE_HREF } from "../../lib/public-phone";

const title = "Sep 19 workshop canceled | Arkansas Automated";
const description =
  "The Saturday Sep 19, 2026 AI Front Desk workshop in Fort Smith is canceled. No seats are for sale.";
---

<Base {title} {description} path="/workshop">
  <SiteNav />
  <main>
    <section class="hero">
      <div class="container">
        <nav class="crumbs" aria-label="Breadcrumb">
          <a href="/">Home</a><span>/</span>Workshop
        </nav>
        <h1 class="heading-xl measure">This session is canceled.</h1>
        <p class="body-lg measure" style="margin-top:1.15rem">
          The Saturday Sep 19, 2026 AI Front Desk workshop at Central Mall Fort Smith is off.
          No seats are for sale.
        </p>
        <div class="hero-ctas" style="margin-top:2rem">
          <a class="btn btn-primary" href="https://book.arkansasautomated.com/book/discovery-call">Book a 15-minute fit assessment</a>
          <a class="btn btn-secondary" href={AA_PUBLIC_PHONE_HREF}>Call {AA_PUBLIC_PHONE_DISPLAY}</a>
        </div>
      </div>
    </section>
  </main>
  <SiteFooter />
</Base>
