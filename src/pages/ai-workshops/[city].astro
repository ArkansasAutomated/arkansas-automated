---
/*
 * /ai-workshops/[city] — Locations playbook (programmatic-seo skill).
 *
 * Each page leads with a self-contained answer block, carries unique local
 * copy from src/data/cities.ts, and marks up ProfessionalService + FAQPage +
 * BreadcrumbList. Cross-links to nearby cities and the hub keep the cluster
 * orphan-free.
 */
import Base from "../../layouts/Base.astro";
import SiteNav from "../../components/SiteNav.astro";
import SiteFooter from "../../components/SiteFooter.astro";
import LeadForm from "../../components/LeadForm.astro";
import { cities, cityBySlug } from "../../data/cities";

export function getStaticPaths() {
  return cities.map((c) => ({ params: { city: c.slug } }));
}

const { city: slug } = Astro.params;
const c = cityBySlug(slug);
const nearby = c.nearby.map(cityBySlug);

const title = `AI Workshops and Automation in ${c.name}, Arkansas | Arkansas Automated`;
const description = `AI workshops and done-for-you automation for ${c.name} businesses. Build your AI receptionist in one afternoon, or have us build and run it for you.`;

const ways = [
  {
    n: "Learn",
    h: "The workshop, $497 early bird",
    p: "One Saturday afternoon, hands-on. You watch an AI receptionist work, build your own with help in the room, and call it live before you leave.",
  },
  {
    n: "Audit",
    h: "AI operations audit, $999",
    p: "We map your calls, quotes, scheduling, and invoicing, then hand you a prioritized automation plan with real ROI numbers for your business.",
  },
  {
    n: "Build",
    h: "Done for you, from $2,500 + $497/mo",
    p: "The AI front desk, built and launched for you: 24/7 answering in your business's voice, qualification, booking, and SMS follow-up.",
  },
  {
    n: "Retainer",
    h: "Embedded, from $2,000/mo",
    p: "We come to you. On-site working sessions, a continuous build-out of custom workflows, priority turnaround, and staff training included.",
  },
];

const faqs = [
  {
    q: `Do you run workshops in ${c.name}?`,
    a: c.workshopNote,
  },
  {
    q: "I am not technical. Is this for me?",
    a: "Yes. The workshop is built for owners, not engineers. Everything is no-code, we build step by step together, and the room is capped at 18 so nobody gets left behind. If you can run a smartphone, you can do this.",
  },
  {
    q: "What if I would rather not sit through a workshop?",
    a: "That is exactly what the done-for-you work is for. Start with the free 15-minute assessment call, and if the ROI is there we build and manage everything, including on-site work under the retainer.",
  },
  {
    q: "What does it cost after the workshop?",
    a: "Nothing is required. If you want us to run it, the AI front desk is $2,500 setup plus $497 a month. Larger workflow builds run $1,500 to $5,000 setup. Your seat price credits toward any build started within 60 days.",
  },
];

const site = "https://arkansasautomated.com";
const pageUrl = `${site}/ai-workshops/${c.slug}`;
const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "ProfessionalService",
      name: "Arkansas Automated",
      url: site,
      description: `AI workshops, workflow automation, and AI front desk builds for ${c.name}, Arkansas businesses.`,
      areaServed: { "@type": "City", name: `${c.name}, Arkansas` },
      serviceType: ["AI workshops and training", "Workflow automation", "AI front desk"],
      priceRange: "$497 - $5,000+",
    },
    {
      "@type": "FAQPage",
      mainEntity: faqs.map((f) => ({
        "@type": "Question",
        name: f.q,
        acceptedAnswer: { "@type": "Answer", text: f.a },
      })),
    },
    {
      "@type": "BreadcrumbList",
      itemListElement: [
        { "@type": "ListItem", position: 1, name: "Home", item: `${site}/` },
        { "@type": "ListItem", position: 2, name: "AI workshops in Arkansas", item: `${site}/ai-workshops` },
        { "@type": "ListItem", position: 3, name: c.name, item: pageUrl },
      ],
    },
  ],
};
---

<Base title={title} description={description} path={`/ai-workshops/${c.slug}`} schema={schema}>
  <SiteNav />
  <main>
    <section class="hero">
      <div class="container">
        <nav class="crumbs" aria-label="Breadcrumb">
          <a href="/">Home</a><span>/</span><a href="/ai-workshops">AI workshops</a><span>/</span>{c.name}
        </nav>
        <span class="eyebrow">{c.region}</span>
        <h1 class="heading-xl measure">AI workshops and automation in {c.name}.</h1>
        <p class="body-lg measure" style="margin-top:1.15rem">
          Arkansas Automated runs in-person AI workshops and done-for-you automation builds for
          {" "}{c.name} business owners. Learn to run an AI front desk yourself in one Saturday
          afternoon, or have us build and manage it for you. {c.drive}.
        </p>
        <div class="hero-ctas" style="margin-top:2rem">
          <a class="btn btn-primary" href="#contact">Reserve a seat</a>
          <a class="btn btn-secondary" href="#ways">We build it for you</a>
        </div>
      </div>
    </section>

    <section class="section section-tint">
      <div class="container">
        <h2 class="heading-lg measure">The {c.name} version of the problem.</h2>
        <p class="body-lg measure" style="margin-top:1rem">{c.economy}</p>
        {c.angle.map((p) => (
          <p class="body-lg measure" style="margin-top:1.25rem">{p}</p>
        ))}
      </div>
    </section>

    <section class="section" id="ways">
      <div class="container">
        <h2 class="heading-lg measure">Ways to work with us in {c.name}.</h2>
        <div class="rows">
          {
            ways.map((w) => (
              <article class="row">
                <div class="row-n">{w.n}</div>
                <h3>{w.h}</h3>
                <p>{w.p}</p>
              </article>
            ))
          }
        </div>
        <p class="body-lg measure" style="margin-top:2.25rem;font-size:1rem">
          Workshop and audit fees credit toward a done-for-you build started within 60 days.
          {" "}<a class="text-link" href="/services">See full services and pricing</a>.
        </p>
      </div>
    </section>

    <section class="section section-tint">
      <div class="container split">
        <div>
          <h2 class="heading-lg">Workshops for {c.name} owners.</h2>
        </div>
        <div>
          <p class="body-lg">{c.workshopNote}</p>
          <p class="body-lg" style="margin-top:1.1rem">
            Every seat includes the working prototype you build in the room, 30 days of email
            support, and a credit of the full seat price toward any done-for-you build started
            within 60 days. <a class="text-link" href="/#workshop">What the afternoon covers</a>.
          </p>
        </div>
      </div>
    </section>

    <section class="section">
      <div class="container faq-wrap">
        <h2 class="heading-lg measure">Questions {c.name} owners ask.</h2>
        <div class="faq-list">
          {
            faqs.map((f) => (
              <details class="faq-item">
                <summary>{f.q}</summary>
                <p>{f.a}</p>
              </details>
            ))
          }
        </div>
      </div>
    </section>

    <section class="section section-tint">
      <div class="container">
        <h2 class="heading-md">Also serving</h2>
        <div class="link-chips">
          {nearby.map((n) => <a class="chip" href={`/ai-workshops/${n.slug}`}>{n.name}</a>)}
          <a class="chip chip-strong" href="/ai-workshops">All Arkansas locations</a>
        </div>
      </div>
    </section>

    <section class="section" id="contact">
      <div class="container split">
        <div>
          <h2 class="heading-lg">Start in {c.name}.</h2>
          <p class="body-lg" style="margin-top:1rem">
            One form for everything: workshop seats, the free assessment, and done-for-you
            scoping. Tell us which and we reply from a real address, usually within one
            business day.
          </p>
          <p class="fine-print" style="margin-top:2rem">
            Last updated July 2026. Written by Andre Brassfield, founder of Arkansas Automated.
          </p>
        </div>
        <LeadForm
          variant="workshop"
          defaultIntent="Reserve a workshop seat, $497 early bird"
          sourceCity={c.name}
          detailsPlaceholder={`Example: after-hours calls at my ${c.name} shop, quote follow-up, scheduling.`}
        />
      </div>
    </section>
  </main>
  <SiteFooter />
</Base>
