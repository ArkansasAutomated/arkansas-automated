---
/*
 * /ai-workshops/[city] — Locations playbook (programmatic-seo skill).
 *
 * Each page leads with a self-contained answer block, carries unique local
 * copy from src/data/cities.ts, and marks up ProfessionalService + FAQPage +
 * BreadcrumbList. Cross-links to nearby cities and the hub keep the cluster
 * orphan-free.
 */
import Base from "../../layouts/Base.astro";
import SiteNav from "../../components/SiteNav.astro";
import SiteFooter from "../../components/SiteFooter.astro";
import BookCall from "../../components/BookCall.astro";
import { cities, cityBySlug } from "../../data/cities";

export function getStaticPaths() {
  return cities.map((c) => ({ params: { city: c.slug } }));
}

const { city: slug } = Astro.params;
const c = cityBySlug(slug);
const nearby = c.nearby.map(cityBySlug);

const title = `AI automation in ${c.name}, AR | Arkansas Automated`;
const description = `Front Door sites and done-for-you AI front desks for ${c.name} businesses. Start at $497 or have us build the desk.`;

const ways = [
  {
    n: "Start",
    h: "Front Door site, $497",
    p: "A 5 to 8 page storefront on your domain, live in 7 days after we have your photos and copy. Credits toward an AI front desk started within 60 days.",
  },
  {
    n: "Audit",
    h: "AI operations audit, $999",
    p: "We map your calls, quotes, scheduling, and invoicing, then hand you a prioritized automation plan with real ROI numbers for your business.",
  },
  {
    n: "Build",
    h: "Done for you, from $2,500 + $497/mo",
    p: "The AI front desk, built and launched for you: 24/7 answering in your business's voice, qualification, booking, and SMS follow-up.",
  },
  {
    n: "Retainer",
    h: "Embedded, from $2,000/mo",
    p: "We come to you. On-site working sessions, a continuous build-out of custom workflows, priority turnaround, and staff training included.",
  },
];

const faqs = [
  {
    q: `Do you run public workshops in ${c.name}?`,
    a: "Public workshop seats are not for sale. " + c.workshopNote,
  },
  {
    q: "I am not technical. Is this for me?",
    a: "Yes. We build it. Start with a $497 Front Door site or the free 15-minute fit assessment. You do not sit through a class.",
  },
  {
    q: "What if I would rather not sit through a workshop?",
    a: "You do not have to. Public seats are not for sale. Start with the free 15-minute assessment call, and if the ROI is there we build and manage everything, including on-site work under the retainer.",
  },
  {
    q: "What does it cost?",
    a: "Front Door is $497. The AI front desk is $2,500 setup plus $497 a month. Larger workflow builds run $1,500 to $5,000 setup. Front Door and audit fees credit toward any build started within 60 days.",
  },
];

const site = "https://arkansasautomated.com";
const pageUrl = `${site}/ai-workshops/${c.slug}`;
const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "ProfessionalService",
      name: "Arkansas Automated",
      url: site,
      description: `AI front desks, Front Door sites, and workflow automation for ${c.name}, Arkansas businesses.`,
      areaServed: { "@type": "City", name: `${c.name}, Arkansas` },
      serviceType: ["AI front desk", "Workflow automation", "AI implementation"],
      priceRange: "$497 - $5,000+",
    },
    {
      "@type": "FAQPage",
      mainEntity: faqs.map((f) => ({
        "@type": "Question",
        name: f.q,
        acceptedAnswer: { "@type": "Answer", text: f.a },
      })),
    },
    {
      "@type": "BreadcrumbList",
      itemListElement: [
        { "@type": "ListItem", position: 1, name: "Home", item: `${site}/` },
        { "@type": "ListItem", position: 2, name: "AI workshops in Arkansas", item: `${site}/ai-workshops` },
        { "@type": "ListItem", position: 3, name: c.name, item: pageUrl },
      ],
    },
  ],
};
---

<Base title={title} description={description} path={`/ai-workshops/${c.slug}`} schema={schema}>
  <SiteNav />
  <main id="main-content" tabindex="-1">
    <section class="hero">
      <div class="container">
        <nav class="crumbs" aria-label="Breadcrumb">
          <a href="/">Home</a><span>/</span><a href="/ai-workshops">AI workshops</a><span>/</span>{c.name}
        </nav>
        <span class="eyebrow">{c.region}</span>
        <h1 class="heading-xl measure">AI automation in {c.name}.</h1>
        <p class="body-lg measure" style="margin-top:1.15rem">
          Arkansas Automated builds Front Door sites and done-for-you AI front desks for
          {" "}{c.name} business owners. Public workshop seats are not for sale. {c.drive}.
        </p>
        <div class="hero-ctas" style="margin-top:2rem">
          <a class="btn btn-primary" href="https://book.arkansasautomated.com/book/discovery-call">Book a 15-minute fit assessment</a>
          <a class="btn btn-secondary" href="/services/front-door">Front Door $497</a>
        </div>
      </div>
    </section>

    <section class="section section-tint">
      <div class="container">
        <h2 class="heading-lg measure">The {c.name} version of the problem.</h2>
        <p class="body-lg measure" style="margin-top:1rem">{c.economy}</p>
        {c.angle.map((p) => (
          <p class="body-lg measure" style="margin-top:1.25rem">{p}</p>
        ))}
      </div>
    </section>

    <section class="section" id="ways">
      <div class="container">
        <h2 class="heading-lg measure">Ways to work with us in {c.name}.</h2>
        <div class="rows">
          {
            ways.map((w) => (
              <article class="row">
                <div class="row-n">{w.n}</div>
                <h3>{w.h}</h3>
                <p>{w.p}</p>
              </article>
            ))
          }
        </div>
        <p class="body-lg measure" style="margin-top:2.25rem;font-size:1rem">
          Front Door and audit fees credit toward a done-for-you build started within 60 days.
          {" "}<a class="text-link" href="/services">See full services and pricing</a>.
        </p>
      </div>
    </section>

    <section class="section section-tint">
      <div class="container split">
        <div>
          <h2 class="heading-lg">How we work with {c.name} owners.</h2>
        </div>
        <div>
          <p class="body-lg">{c.workshopNote}</p>
          <p class="body-lg" style="margin-top:1.1rem">
            Public workshop seats are not for sale. Start with Front Door $497 or the free
            fit assessment. {" "}<a class="text-link" href="/services/front-door">See Front Door</a>.
          </p>
        </div>
      </div>
    </section>

    <section class="section">
      <div class="container faq-wrap">
        <h2 class="heading-lg measure">Questions {c.name} owners ask.</h2>
        <div class="faq-list">
          {
            faqs.map((f) => (
              <details class="faq-item">
                <summary>{f.q}</summary>
                <p>{f.a}</p>
              </details>
            ))
          }
        </div>
      </div>
    </section>

    <section class="section section-tint">
      <div class="container">
        <h2 class="heading-md">Also serving</h2>
        <div class="link-chips">
          {nearby.map((n) => <a class="chip" href={`/ai-workshops/${n.slug}`}>{n.name}</a>)}
          <a class="chip chip-strong" href="/ai-workshops">All Arkansas locations</a>
        </div>
      </div>
    </section>

    <section class="section" id="contact">
      <div class="container split">
        <div>
          <h2 class="heading-lg">Start in {c.name}.</h2>
          <p class="body-lg" style="margin-top:1rem">
            One form for everything: Front Door, the free assessment, and done-for-you
            scoping. Tell us which and we reply from a real address, usually within one
            business day.
          </p>
          <p class="fine-print" style="margin-top:2rem">
            Last updated July 2026. Written by Andre Brassfield, founder of Arkansas Automated.
          </p>
        </div>
        <BookCall
          heading={`Pick a time that fits your ${c.name} week`}
          note={`Fifteen minutes, your ${c.name} business details, and a straight answer on whether automation pays for itself. If it does not, we will tell you that too.`}
        />
      </div>
    </section>
  </main>
  <SiteFooter />
</Base>
