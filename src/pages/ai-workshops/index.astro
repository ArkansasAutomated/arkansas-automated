---
/*
 * /ai-workshops — hub for the Locations cluster. Groups all city pages by
 * region, links every spoke (no orphans), and carries ItemList +
 * BreadcrumbList schema.
 */
import Base from "../../layouts/Base.astro";
import SiteNav from "../../components/SiteNav.astro";
import SiteFooter from "../../components/SiteFooter.astro";
import { regions, cities } from "../../data/cities";

const title = "AI Workshops Across Arkansas | Arkansas Automated";
const description =
  "In-person AI workshops and done-for-you automation for business owners across Arkansas: Fort Smith, Northwest Arkansas, Little Rock, and statewide on-site.";

const site = "https://arkansasautomated.com";
const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "ItemList",
      name: "Arkansas cities served by Arkansas Automated",
      itemListElement: cities.map((c, i) => ({
        "@type": "ListItem",
        position: i + 1,
        name: `AI workshops and automation in ${c.name}, Arkansas`,
        url: `${site}/ai-workshops/${c.slug}`,
      })),
    },
    {
      "@type": "BreadcrumbList",
      itemListElement: [
        { "@type": "ListItem", position: 1, name: "Home", item: `${site}/` },
        { "@type": "ListItem", position: 2, name: "AI workshops in Arkansas", item: `${site}/ai-workshops` },
      ],
    },
  ],
};

const byRegion = regions.map((r) => ({
  ...r,
  items: r.slugs.map((s) => cities.find((c) => c.slug === s)!),
}));
---

<Base title={title} description={description} path="/ai-workshops" schema={schema}>
  <SiteNav />
  <main>
    <section class="hero">
      <div class="container">
        <nav class="crumbs" aria-label="Breadcrumb">
          <a href="/">Home</a><span>/</span>AI workshops
        </nav>
        <h1 class="heading-xl measure">AI workshops and automation, across Arkansas.</h1>
        <p class="body-lg measure" style="margin-top:1.15rem">
          Public workshop seats run Saturday afternoons in Fort Smith. Northwest Arkansas sessions
          open as demand builds, and private on-site workshops and done-for-you builds are
          available statewide. Find your city below for the details that apply to you.
        </p>
        <div class="hero-ctas" style="margin-top:2rem">
          <a class="btn btn-primary" href="/#reserve">Reserve a seat</a>
          <a class="btn btn-secondary" href="/services">Done-for-you services</a>
        </div>
      </div>
    </section>

    {byRegion.map((r, idx) => (
      <section class:list={["section", idx % 2 === 0 && "section-tint"]}>
        <div class="container">
          <h2 class="heading-lg measure">{r.name}</h2>
          <div class="city-grid">
            {
              r.items.map((c) => (
                <a class="city-card" href={`/ai-workshops/${c.slug}`}>
                  <span class="prop-name">{c.name}</span>
                  <span class="prop-role">{c.drive}</span>
                  <span class="city-cta">Workshops and automation in {c.name}</span>
                </a>
              ))
            }
          </div>
        </div>
      </section>
    ))}
  </main>
  <SiteFooter />
</Base>
