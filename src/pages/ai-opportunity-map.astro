---
import Base from "../layouts/Base.astro";
import SiteNav from "../components/SiteNav.astro";
import SiteFooter from "../components/SiteFooter.astro";

const title = "AI Opportunity Map | Arkansas Automated";
const description = "Find the parts of your business where AI or automation could create real capacity, clarity, or revenue next.";
---

<Base title={title} description={description} path="/ai-opportunity-map/">
  <SiteNav />
  <main class="map-page">
    <section class="map-hero">
      <div class="container map-hero-grid">
        <div>
          <p class="hero-kicker">A practical field guide for business owners</p>
          <h1 class="heading-xl">Find where work is getting stuck.</h1>
          <p class="body-lg">Answer a few honest questions. We’ll help you see the clearest AI or automation openings in your business, then point you toward the right next move.</p>
          <p class="quiet">No AI readiness score. No generic report. Just useful friction, prioritized.</p>
        </div>
        <div class="map-mark" aria-hidden="true">
          <span class="map-line line-one"></span><span class="map-line line-two"></span><span class="map-line line-three"></span>
          <span class="map-node node-one">01</span><span class="map-node node-two">02</span><span class="map-node node-three">03</span>
          <span class="map-label label-one">friction</span><span class="map-label label-two">leverage</span><span class="map-label label-three">next move</span>
        </div>
      </div>
    </section>

    <section class="map-section section">
      <div class="container">
        <div class="map-shell">
          <div class="map-progress" aria-label="Opportunity Map progress">
            <span class="progress-step active" data-progress="0">01</span><span class="progress-line"></span>
            <span class="progress-step" data-progress="1">02</span><span class="progress-line"></span>
            <span class="progress-step" data-progress="2">03</span><span class="progress-line"></span>
            <span class="progress-step" data-progress="3">04</span>
          </div>

          <form id="opportunity-map" novalidate>
            <div class="map-step active" data-step="0">
              <p class="eyebrow">Start with the business</p>
              <h2>Tell us who is carrying the work.</h2>
              <p class="step-copy">This helps us keep the recommendations grounded in your actual operation.</p>
              <div class="field-grid">
                <label>Your role<input name="role" required placeholder="Owner, operator, office manager…" /></label>
                <label>Business or organization<input name="business" required placeholder="The name people know you by" /></label>
                <label class="full">What kind of business is it?<input name="industry" required placeholder="HVAC, dental, roofing, legal, nonprofit…" /></label>
              </div>
              <button class="btn btn-primary next-button" type="button" data-next>Map the work <span>→</span></button>
            </div>

            <div class="map-step" data-step="1" hidden>
              <p class="eyebrow">Where does work drag?</p>
              <h2>Pick every place where the business gets stuck.</h2>
              <p class="step-copy">Multiple answers are expected. The overlap is often where the best opportunity lives.</p>
              <div class="multi-grid" role="group" aria-label="Business friction points">
                <button class="multi-choice" type="button" data-issue="inquiries" aria-pressed="false"><span class="choice-icon">↗</span><strong>Leads and follow-up</strong><small>Calls, forms, estimates, or callbacks fall through.</small></button>
                <button class="multi-choice" type="button" data-issue="handoffs" aria-pressed="false"><span class="choice-icon">⇄</span><strong>People and tool handoffs</strong><small>Work waits, gets copied, or disappears between owners.</small></button>
                <button class="multi-choice" type="button" data-issue="admin" aria-pressed="false"><span class="choice-icon">≡</span><strong>Repetitive admin</strong><small>The team keeps typing, sorting, summarizing, or rekeying.</small></button>
                <button class="multi-choice" type="button" data-issue="visibility" aria-pressed="false"><span class="choice-icon">◌</span><strong>Operational visibility</strong><small>You cannot see what needs attention until it becomes urgent.</small></button>
              </div>
              <p class="validation" data-validation="issues" hidden>Select at least one place where work drags.</p>
              <div class="step-actions"><button class="btn btn-primary next-button" type="button" data-next>Find the leverage <span>→</span></button><button class="text-button" type="button" data-back>Back</button></div>
            </div>

            <div class="map-step" data-step="2" hidden>
              <p class="eyebrow">What is the drag worth?</p>
              <h2>Give us the rough economics.</h2>
              <p class="step-copy">No spreadsheets required. We only need to know whether this is an annoyance or an expensive constraint.</p>
              <div class="field-grid">
                <label>How often does it happen?<select name="frequency"><option value="low">A few times a week</option><option value="medium">Every day</option><option value="high">Constantly or across the team</option></select></label>
                <label>What would one saved hour or recovered opportunity be worth?<select name="value"><option value="low">Useful, but hard to price</option><option value="medium">A few hundred dollars</option><option value="high">Thousands or recurring revenue</option></select></label>
              </div>
              <div class="step-actions"><button class="btn btn-primary next-button" type="button" data-next>See the opening <span>→</span></button><button class="text-button" type="button" data-back>Back</button></div>
            </div>

            <div class="map-step" data-step="3" hidden>
              <p class="eyebrow">How do you want to move?</p>
              <h2>Choose the kind of help you want.</h2>
              <p class="step-copy">There is no prize for doing it alone. There is also no reason to outsource what your team wants to learn.</p>
              <div class="path-grid" role="group" aria-label="Preferred path">
                <button class="path-choice" type="button" data-path="learn" aria-pressed="false"><strong>Teach us</strong><small>Workshop or education first. We want to understand the pattern and make the first move ourselves.</small></button>
                <button class="path-choice" type="button" data-path="build" aria-pressed="false"><strong>Build it for us</strong><small>We want a focused assessment, implementation, and a system our team can actually use.</small></button>
                <button class="path-choice" type="button" data-path="both" aria-pressed="false"><strong>Learn while we build</strong><small>Guide our team while Arkansas Automated turns the highest-value workflow into something useful.</small></button>
              </div>
              <p class="validation" data-validation="path" hidden>Choose the kind of help that fits.</p>
              <div class="step-actions"><button class="btn btn-primary next-button" type="button" data-result>Show my next move <span>→</span></button><button class="text-button" type="button" data-back>Back</button></div>
            </div>
          </form>

          <section class="map-result" data-result-panel hidden aria-live="polite">
            <div class="result-top"><div><p class="eyebrow" data-result-route>YOUR AI OPPORTUNITY MAP</p><h2>Three openings worth looking at next.</h2><p class="step-copy">This is a working hypothesis based on what you told us, not a generic AI score. Take it into a real conversation.</p></div><div class="signal" data-signal>—</div></div>
            <div class="opportunity-list" data-opportunity-list></div>
            <div class="recommendation"><p class="eyebrow">The best first move</p><p data-recommendation></p></div>
            <div class="capture-block">
              <p class="eyebrow">Keep your map</p>
              <h3>Send this to me and I’ll bring it to the call.</h3>
              <p>Your result becomes a structured starting brief instead of disappearing into a browser tab.</p>
              <form data-map-capture novalidate>
                <div class="capture-grid"><label>Your name<input name="name" required autocomplete="name" /></label><label>Work email<input name="email" type="email" required autocomplete="email" /></label><label>Phone<input name="phone" type="tel" required autocomplete="tel" placeholder="(479) 555-0123" /></label></div>
                <input name="businessName" type="hidden" /><input name="industry" type="hidden" />
                <button class="btn btn-primary" type="submit">Send my opportunity map <span>→</span></button>
                <p class="capture-status" data-capture-status hidden></p>
                <p class="form-legal">By submitting, you agree that Arkansas Automated may contact you about this map and your next step. See our <a href="/privacy">privacy page</a>.</p>
              </form>
            </div>
            <div class="booking-block">
              <p class="eyebrow">Ready to make it concrete?</p>
              <h3>Book the 30-minute opportunity session.</h3>
              <p>Bring the workflow costing you the most. We’ll map the people, tools, exceptions, and first useful move.</p>
              <div id="my-cal-inline-arkansas-automated-initial-consult" class="cal-embed"></div>
            </div>
            <p class="quiet">Your selected business, friction points, and path are carried into the booking URL so the conversation starts with context.</p>
          </section>
        </div>
      </div>
    </section>
  </main>
  <SiteFooter />
</Base>

<script>
  type MapState = { step: number; issues: string[]; path: string; result: boolean };
  const state: MapState = { step: 0, issues: [], path: "", result: false };
  const form = document.querySelector<HTMLFormElement>("#opportunity-map");
  const steps = [...document.querySelectorAll<HTMLElement>("[data-step]")];
  const resultPanel = document.querySelector<HTMLElement>("[data-result-panel]");
  const progress = [...document.querySelectorAll<HTMLElement>("[data-progress]")];
  const opportunityCatalog: Record<string, Array<{ title: string; happening: string; change: string; impact: string; difficulty: string; firstMove: string }>> = {
    dental: [
      { title: "Patient intake + follow-up automation", happening: "Staff manually receive forms → enter information → check missing information → call or text patients → update systems.", change: "Forms are categorized → missing information is flagged → follow-ups are triggered → staff handle exceptions.", impact: "5–10 staff hours/week recovered; fewer missed follow-ups; clearer incomplete-work visibility.", difficulty: "Medium", firstMove: "Map the current intake workflow" },
      { title: "Recall and reactivation workflow", happening: "Patients who are due, overdue, or undecided live in separate lists and depend on memory.", change: "The right patient gets the right reminder at the right time, with a human handoff when needed.", impact: "More consistent recall; less front-desk chasing; a cleaner opportunity queue.", difficulty: "Medium", firstMove: "List the patient segments and handoff rules" },
      { title: "Front-desk knowledge copilot", happening: "The same policy, scheduling, and insurance questions interrupt the team all day.", change: "Staff get a trusted answer pattern and escalation path without improvising every time.", impact: "Fewer interruptions; faster answers; safer consistency across the team.", difficulty: "Low", firstMove: "Collect the 20 questions staff answer most" },
    ],
    default: [
      { title: "Lead intake + follow-up automation", happening: "Requests arrive through calls, forms, email, or messages → someone re-enters the details → follow-up depends on memory.", change: "Requests are categorized → missing information is flagged → next actions are triggered → people handle exceptions.", impact: "Fewer dropped opportunities; recovered staff time; clearer visibility into incomplete work.", difficulty: "Medium", firstMove: "Map the current intake-to-follow-up workflow" },
      { title: "Handoff and exception map", happening: "Work waits between people and tools because ownership and exceptions are unclear.", change: "Each handoff has an owner, a visible state, and a human escalation path.", impact: "Less waiting; fewer duplicate updates; faster decisions when work goes sideways.", difficulty: "Medium", firstMove: "Draw one real job from request to completion" },
      { title: "Team knowledge copilot", happening: "People repeatedly search, summarize, draft, and answer the same operational questions.", change: "The team gets a shared preparation layer with clear limits and human review.", impact: "Fewer interruptions; faster preparation; better reuse of the knowledge you already own.", difficulty: "Low", firstMove: "Collect the 20 repeated questions and tasks" },
    ],
  };

  function setStep(next: number) {
    state.step = next;
    steps.forEach((step, index) => {
      const active = index === next;
      step.hidden = !active;
      step.classList.toggle("active", active);
    });
    progress.forEach((item, index) => item.classList.toggle("active", index <= next));
  }

  function validateStep() {
    if (state.step === 0 && form) {
      const required = ["role", "business", "industry"];
      const valid = required.every((name) => String((form.elements.namedItem(name) as HTMLInputElement)?.value ?? "").trim().length > 0);
      return valid;
    }
    if (state.step === 1) {
      const error = document.querySelector<HTMLElement>('[data-validation="issues"]');
      const valid = state.issues.length > 0;
      if (error) error.hidden = valid;
      return valid;
    }
    return true;
  }

  function chooseIssue(button: HTMLButtonElement) {
    const id = button.dataset.issue ?? "";
    button.classList.toggle("selected");
    const selected = button.classList.contains("selected");
    button.setAttribute("aria-pressed", String(selected));
    state.issues = [...document.querySelectorAll<HTMLButtonElement>(".multi-choice.selected")].map((item) => item.dataset.issue ?? "");
    if (id && !selected) state.issues = state.issues.filter((issue) => issue !== id);
  }

  document.querySelectorAll<HTMLButtonElement>(".multi-choice").forEach((button) => button.addEventListener("click", () => chooseIssue(button)));
  document.querySelectorAll<HTMLButtonElement>(".path-choice").forEach((button) => button.addEventListener("click", () => {
    document.querySelectorAll(".path-choice").forEach((item) => item.classList.remove("selected"));
    button.classList.add("selected");
    button.setAttribute("aria-pressed", "true");
    state.path = button.dataset.path ?? "";
  }));
  document.querySelectorAll<HTMLButtonElement>("[data-back]").forEach((button) => button.addEventListener("click", () => setStep(Math.max(0, state.step - 1))));
  document.querySelectorAll<HTMLButtonElement>("[data-next]").forEach((button) => button.addEventListener("click", () => {
    if (validateStep()) setStep(Math.min(3, state.step + 1));
  }));
  document.querySelector<HTMLButtonElement>("[data-result]")?.addEventListener("click", () => {
    const error = document.querySelector<HTMLElement>('[data-validation="path"]');
    if (!state.path) { if (error) error.hidden = false; return; }
    if (error) error.hidden = true;
    const frequency = (form?.elements.namedItem("frequency") as HTMLSelectElement)?.value ?? "low";
    const value = (form?.elements.namedItem("value") as HTMLSelectElement)?.value ?? "low";
    const industry = ((form?.elements.namedItem("industry") as HTMLInputElement)?.value ?? "").toLowerCase();
    const catalog = industry.includes("dent") ? opportunityCatalog.dental : opportunityCatalog.default;
    const selected = [...new Set(state.issues)];
    const ranked = catalog.slice(0, 3);
    const signal = frequency === "high" || value === "high" ? "HIGH" : frequency === "medium" || value === "medium" ? "MED" : "LOW";
    const route = state.path === "learn" ? "LEARN IT" : state.path === "build" ? "BUILD IT" : "LEARN + BUILD";
    const recommendation = ranked[0]?.firstMove ?? "Map one real workflow from request to completion";
    const list = document.querySelector<HTMLElement>("[data-opportunity-list]");
    list?.replaceChildren(...ranked.map((item, index) => {
      const article = document.createElement("article");
      article.className = "opportunity-item";
      const rank = document.createElement("p"); rank.className = "opportunity-rank"; rank.textContent = `#${index + 1} OPPORTUNITY`;
      const title = document.createElement("h3"); title.textContent = item.title;
      const makeDetail = (label: string, text: string) => { const p = document.createElement("p"); const strong = document.createElement("strong"); strong.textContent = label; p.append(strong, document.createTextNode(text)); return p; };
      const happening = makeDetail("What may be happening now", item.happening);
      const change = makeDetail("What could change", item.change);
      const impact = makeDetail("Potential impact", item.impact);
      const meta = document.createElement("p"); meta.className = "opportunity-meta"; meta.textContent = `Difficulty: ${item.difficulty} · Best first move: ${item.firstMove}`;
      article.append(rank, title, happening, change, impact, meta);
      return article;
    }));
    document.querySelector<HTMLElement>("[data-signal]")!.textContent = signal;
    document.querySelector<HTMLElement>("[data-result-route]")!.textContent = `${route} · YOUR AI OPPORTUNITY MAP`;
    document.querySelector<HTMLElement>("[data-recommendation]")!.textContent = recommendation;
    const business = (form?.elements.namedItem("business") as HTMLInputElement)?.value ?? "";
    const params = new URLSearchParams({ business, industry: (form?.elements.namedItem("industry") as HTMLInputElement)?.value ?? "", issues: selected.join(","), path: state.path });
    history.replaceState({}, "", `${location.pathname}?${params}`);
    const capture = document.querySelector<HTMLFormElement>("[data-map-capture]");
    if (capture) {
      (capture.elements.namedItem("businessName") as HTMLInputElement).value = business;
      (capture.elements.namedItem("industry") as HTMLInputElement).value = industry;
    }
    state.result = true;
    form?.setAttribute("hidden", "true");
    resultPanel?.removeAttribute("hidden");
    resultPanel?.scrollIntoView({ behavior: "smooth", block: "start" });
  });

  document.querySelector<HTMLFormElement>("[data-map-capture]")?.addEventListener("submit", async (event) => {
    event.preventDefault();
    const capture = event.currentTarget as HTMLFormElement;
    const status = capture.querySelector<HTMLElement>("[data-capture-status]");
    const submit = capture.querySelector<HTMLButtonElement>("button[type=submit]");
    const name = String((capture.elements.namedItem("name") as HTMLInputElement)?.value ?? "").trim();
    const email = String((capture.elements.namedItem("email") as HTMLInputElement)?.value ?? "").trim();
    const phone = String((capture.elements.namedItem("phone") as HTMLInputElement)?.value ?? "").trim();
    const business = String((capture.elements.namedItem("businessName") as HTMLInputElement)?.value ?? "").trim();
    const industry = String((capture.elements.namedItem("industry") as HTMLInputElement)?.value ?? "").trim();
    if (!name || !email || phone.replace(/\D/g, "").length < 7) { if (status) { status.hidden = false; status.textContent = "Your name, work email, and a valid phone number are required."; } return; }
    if (submit) { submit.disabled = true; submit.textContent = "Sending…"; }
    const params = new URLSearchParams(location.search);
    const payload = {
      type: "automation_assessment",
      businessName: business,
      name,
      email,
      phone,
      spokeDomain: "arkansasautomated.com",
      sourcePath: location.pathname,
      details: `AI Opportunity Map: ${params.get("issues") ?? ""}`,
      "bot-field": "",
      extra: {
        industry,
        issues: params.get("issues"),
        preferredPath: params.get("path"),
        mapSignal: document.querySelector<HTMLElement>("[data-signal]")?.textContent ?? null,
        capturedAt: new Date().toISOString(),
        source: "ai-opportunity-map",
      },
    };
    try {
      const response = await fetch("https://fortsmithdirectory.com/api/public/leads", { method: "POST", headers: { "Content-Type": "text/plain" }, body: JSON.stringify(payload) });
      if (!response.ok) throw new Error("lead endpoint rejected request");
      if (status) { status.hidden = false; status.dataset.kind = "ok"; status.textContent = "Your map is saved. Bring it to the opportunity session below."; }
      if (submit) submit.textContent = "Map saved";
    } catch {
      if (status) { status.hidden = false; status.dataset.kind = "error"; status.textContent = "We could not save the map right now. You can still book the session below."; }
      if (submit) { submit.disabled = false; submit.textContent = "Send my opportunity map →"; }
    }
  });
</script>

<script type="text/javascript">
  (function (C, A, L) { let p = function (a, ar) { a.q.push(ar); }; let d = C.document; C.Cal = C.Cal || function () { let cal = C.Cal; let ar = arguments; if (!cal.loaded) { cal.ns = {}; cal.q = cal.q || []; d.head.appendChild(d.createElement("script")).src = A; cal.loaded = true; } if (ar[0] === L) { const api = function () { p(api, arguments); }; const namespace = ar[1]; api.q = api.q || []; if (typeof namespace === "string") { cal.ns[namespace] = cal.ns[namespace] || api; p(cal.ns[namespace], ar); p(cal, ["initNamespace", namespace]); } else p(cal, ar); return; } p(cal, ar); }; })(window, "https://app.cal.com/embed/embed.js", "init");
  Cal("init", "arkansas-automated-initial-consult", { origin: "https://app.cal.com" });
  Cal.config = Cal.config || {};
  Cal.config.forwardQueryParams = true;
  Cal.ns["arkansas-automated-initial-consult"]("inline", { elementOrSelector: "#my-cal-inline-arkansas-automated-initial-consult", config: { layout: "month_view", useSlotsViewOnSmallScreen: "true" }, calLink: "andre-brassfield-97stra/arkansas-automated-initial-consult" });
  Cal.ns["arkansas-automated-initial-consult"]("ui", { hideEventTypeDetails: false, layout: "month_view" });
</script>

<style>
  .map-page { background: var(--bg-primary); }
  .map-hero { padding: clamp(4rem, 8vw, 8rem) 0 4rem; border-bottom: 1px solid var(--line); }
  .map-hero-grid { display: grid; gap: 3rem; align-items: center; }
  @media (min-width: 860px) { .map-hero-grid { grid-template-columns: 1.1fr .9fr; } }
  .map-hero h1 { max-width: 11ch; margin: .5rem 0 1.25rem; }
  .map-hero .body-lg { max-width: 39rem; }
  .quiet { color: var(--text-muted); font-size: .86rem; margin-top: 1rem; }
  .map-mark { min-height: 300px; position: relative; border: 1px solid var(--line); border-radius: var(--radius-lg); background: var(--bg-secondary); overflow: hidden; }
  .map-line { position: absolute; height: 1px; background: var(--accent-line); transform-origin: left center; }
  .line-one { width: 70%; left: 12%; top: 30%; transform: rotate(18deg); }.line-two { width: 54%; left: 27%; top: 52%; transform: rotate(-22deg); }.line-three { width: 45%; left: 35%; top: 65%; transform: rotate(18deg); }
  .map-node { position: absolute; width: 54px; height: 54px; border: 1px solid var(--accent); color: var(--accent); border-radius: 50%; display: grid; place-items: center; font-family: var(--font-heading); font-weight: 800; background: var(--bg-primary); }
  .node-one { left: 9%; top: 20%; }.node-two { left: 62%; top: 43%; }.node-three { right: 8%; bottom: 12%; background: var(--accent); color: var(--accent-ink); }
  .map-label { position: absolute; color: var(--text-muted); font-size: .72rem; letter-spacing: .14em; text-transform: uppercase; }.label-one { left: 8%; top: 43%; }.label-two { left: 64%; top: 65%; }.label-three { right: 8%; bottom: 5%; }
  .map-section { padding-top: 3rem; }.map-shell { max-width: 920px; margin: 0 auto; border: 1px solid var(--line); border-radius: var(--radius-lg); background: var(--bg-secondary); padding: clamp(1.4rem, 4vw, 3.2rem); }
  .map-progress { display: flex; align-items: center; gap: .75rem; margin-bottom: 3rem; color: var(--text-muted); font-size: .75rem; font-weight: 600; letter-spacing: .12em; }.progress-line { height: 1px; flex: 1; background: var(--line); }.progress-step.active { color: var(--accent); }
  .map-step h2, .map-result h2 { font-size: clamp(1.8rem, 4vw, 3rem); max-width: 18ch; margin-bottom: .75rem; }.step-copy { color: var(--text-secondary); max-width: 56ch; }.field-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 1rem; margin-top: 2rem; }.field-grid .full { grid-column: 1/-1; }label { display: grid; gap: .45rem; color: var(--text-secondary); font-size: .88rem; }input, select { width: 100%; border: 1px solid var(--line); border-radius: var(--radius-sm); background: var(--bg-primary); color: var(--text-primary); padding: .9rem 1rem; font: inherit; }input:focus, select:focus { border-color: var(--accent); outline: 2px solid var(--accent-soft); }
  .next-button { margin-top: 2rem; }.next-button span { font-size: 1.2em; }.text-button { margin-left: 1rem; border: 0; background: transparent; color: var(--text-secondary); cursor: pointer; font: inherit; }.step-actions { display: flex; align-items: center; }.multi-grid, .path-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 1rem; margin-top: 2rem; }.multi-choice, .path-choice { text-align: left; border: 1px solid var(--line); border-radius: var(--radius-md); background: var(--bg-primary); color: var(--text-primary); padding: 1.2rem; cursor: pointer; transition: border-color var(--transition-fast), background var(--transition-fast), transform var(--transition-fast); }.multi-choice:hover, .path-choice:hover, .multi-choice.selected, .path-choice.selected { border-color: var(--accent); background: var(--accent-soft); transform: translateY(-2px); }.multi-choice strong, .path-choice strong { display: block; font-family: var(--font-heading); font-size: 1.1rem; }.multi-choice small, .path-choice small { display: block; color: var(--text-secondary); line-height: 1.45; margin-top: .4rem; }.choice-icon { color: var(--accent); font-size: 1.4rem; display: block; margin-bottom: .8rem; }.validation { color: #ff947a; font-size: .85rem; margin-top: 1rem; }.map-result { border-top: 1px solid var(--line); padding-top: 2rem; }.result-top { display: flex; justify-content: space-between; gap: 2rem; }.signal { color: var(--accent); font-family: var(--font-heading); font-size: 2.6rem; font-weight: 800; }.opportunity-list { display: grid; grid-template-columns: 1fr 1fr; gap: 1px; background: var(--line); margin-top: 2rem; border: 1px solid var(--line); }.opportunity-item { background: var(--bg-primary); padding: 1.25rem; }.opportunity-item h3 { font-size: 1.05rem; margin-bottom: .65rem; }.opportunity-item p { color: var(--text-secondary); font-size: .9rem; margin-top: .75rem; }.opportunity-item p strong { display: block; color: var(--text-primary); font-size: .75rem; letter-spa