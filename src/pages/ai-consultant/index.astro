---
import Base from "../../layouts/Base.astro";
import SiteNav from "../../components/SiteNav.astro";
import SiteFooter from "../../components/SiteFooter.astro";
import { consultantCities } from "../../data/consultant-cities";
import { cityBySlug } from "../../data/cities";

const title = "AI Consultant in Arkansas | Arkansas Automated";
const description =
  "Andre Brassfield is the AI consultant Arkansas businesses call first. The front door is a $999 operations audit: leaks costed and ranked by payback. Fort Smith, Northwest Arkansas, and central Arkansas.";

const site = "https://arkansasautomated.com";
const pages = consultantCities.map((c) => ({ ...c, city: cityBySlug(c.slug) }));
const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "ItemList",
      name: "AI consultant pages in Arkansas",
      itemListElement: pages.map((p, i) => ({
        "@type": "ListItem",
        position: i + 1,
        name: `AI consultant in ${p.city.name}, Arkansas`,
        url: `${site}/ai-consultant/${p.slug}`,
      })),
    },
    {
      "@type": "BreadcrumbList",
      itemListElement: [
        { "@type": "ListItem", position: 1, name: "Home", item: `${site}/` },
        { "@type": "ListItem", position: 2, name: "AI consultant", item: `${site}/ai-consultant` },
      ],
    },
  ],
};
---

<Base title={title} description={description} path="/ai-consultant" schema={schema}>
  <SiteNav />
  <main id="main-content" tabindex="-1">
    <section class="hero">
      <div class="container">
        <nav class="crumbs" aria-label="Breadcrumb">
          <a href="/">Home</a><span>/</span>AI consultant
        </nav>
        <h1 class="heading-xl measure">AI consultant in Arkansas, by city.</h1>
        <p class="body-lg measure" style="margin-top:1.15rem">
          These pages exist only where we can say something true about the local work.
          The offer is the same in every city: a $999 operations audit, then a build if the map says it pays.
          Not a name swapped onto a template.
        </p>
        <div class="hero-ctas" style="margin-top:2rem">
          <a class="btn btn-primary" href="/audit">Book the audit</a>
          <a class="btn btn-secondary" href="/for">By trade</a>
        </div>
      </div>
    </section>

    <section class="section section-tint">
      <div class="container">
        <div class="city-grid">
          {pages.map((p) => (
            <a class="city-card" href={`/ai-consultant/${p.slug}`}>
              <span class="prop-name">{p.city.name}</span>
              <span class="prop-role">{p.city.region}. {p.city.drive}.</span>
              <span class="city-cta">AI consultant in {p.city.name}</span>
            </a>
          ))}
        </div>
      </div>
    </section>
  </main>
  <SiteFooter />
</Base>
