---
/*
 * /ai-consultant/[city] — seven cities, each with a hand-written local angle.
 * An audit is not a search term in every Arkansas town. Cities without a
 * consultantCities entry do not get a page.
 */
import Base from "../../layouts/Base.astro";
import SiteNav from "../../components/SiteNav.astro";
import SiteFooter from "../../components/SiteFooter.astro";
import BookCall from "../../components/BookCall.astro";
import { consultantCities, consultantCityBySlug } from "../../data/consultant-cities";
import { cityBySlug } from "../../data/cities";
import { serviceBySlug } from "../../data/services";

export function getStaticPaths() {
  return consultantCities.map((c) => ({ params: { city: c.slug } }));
}

const { city: slug } = Astro.params;
const local = consultantCityBySlug(slug);
const c = cityBySlug(slug);
const audit = serviceBySlug("operations-audit");
const nearby = c.nearby
  .map((s) => consultantCities.find((x) => x.slug === s))
  .filter((x): x is NonNullable<typeof x> => Boolean(x))
  .map((x) => cityBySlug(x.slug));

const title = `AI consultant in ${c.name}, AR | Arkansas Automated`;
const description = `AI consultant for ${c.name} businesses. ${audit.price} operations audit: leaks costed and ranked by payback. ${c.drive}.`;
const answer = `An AI consultant for a ${c.name} business starts with a free missed-call test, then a $1,500 leak audit if the recording shows a real leak. Arkansas Automated spends ninety minutes on the real process and hands back a written map, costed and ranked by payback. The full fee comes off the first fix.`;

const site = "https://arkansasautomated.com";
const pageUrl = `${site}/ai-consultant/${c.slug}`;
const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Service",
      name: `AI consultant in ${c.name}, Arkansas`,
      serviceType: "AI consulting",
      provider: { "@type": "ProfessionalService", name: "Arkansas Automated", url: site },
      areaServed: { "@type": "City", name: `${c.name}, Arkansas` },
      description: answer,
      offers: {
        "@type": "Offer",
        price: "1500",
        priceCurrency: "USD",
        url: `${site}/audit`,
      },
    },
    {
      "@type": "BreadcrumbList",
      itemListElement: [
        { "@type": "ListItem", position: 1, name: "Home", item: `${site}/` },
        { "@type": "ListItem", position: 2, name: "AI consultant", item: `${site}/ai-consultant` },
        { "@type": "ListItem", position: 3, name: c.name, item: pageUrl },
      ],
    },
  ],
};
---

<Base title={title} description={description} path={`/ai-consultant/${c.slug}`} schema={schema}>
  <SiteNav />
  <main id="main-content" tabindex="-1">
    <section class="hero">
      <div class="container">
        <nav class="crumbs" aria-label="Breadcrumb">
          <a href="/">Home</a><span>/</span><a href="/ai-consultant">AI consultant</a><span>/</span>{c.name}
        </nav>
        <h1 class="heading-xl measure">AI consultant in {c.name}, Arkansas.</h1>
        <p class="body-lg measure" style="margin-top:1.15rem">{answer}</p>
        <p class="body-lg measure" style="margin-top:1rem">{c.economy}</p>
        <div class="hero-ctas" style="margin-top:2rem">
          <a class="btn btn-primary" href="/audit">Book the audit</a>
          <a class="btn btn-secondary" href={`/ai-receptionist/${c.slug}`}>AI receptionist in {c.name}</a>
        </div>
      </div>
    </section>

    <section class="section section-tint">
      <div class="container">
        <h2 class="heading-lg measure">What the work looks like in {c.name}.</h2>
        {local.local.map((p) => (
          <p class="body-lg measure" style="margin-top:1.15rem">{p}</p>
        ))}
      </div>
    </section>

    <section class="section">
      <div class="container split">
        <div>
          <h2 class="heading-lg">What the audit watches first.</h2>
        </div>
        <div>
          <p class="body-lg">{local.watch}</p>
          <p class="body-lg" style="margin-top:1.1rem">
            {c.drive}. The session is ninety minutes. The deliverable is the written map on the
            {" "}<a class="text-link" href="/audit">audit page</a>, at {audit.price}.
            If the map says the phone is the leak, the
            {" "}<a class="text-link" href={`/ai-receptionist/${c.slug}`}>receptionist build</a>
            is the usual next step. If it says the site is the leak, the
            {" "}<a class="text-link" href="/services/visibility-install">Visibility Install</a>
            is a named build, not the front door.
          </p>
        </div>
      </div>
    </section>

    {nearby.length > 0 && (
      <section class="section section-tint">
        <div class="container">
          <h2 class="heading-md">Nearby</h2>
          <div class="link-chips">
            {nearby.map((n) => (
              <a class="chip" href={`/ai-consultant/${n.slug}`}>{n.name}</a>
            ))}
            <a class="chip chip-strong" href="/ai-consultant">All consultant cities</a>
          </div>
        </div>
      </section>
    )}

    <section class="section" id="contact">
      <div class="container split">
        <div>
          <h2 class="heading-lg">Book it from {c.name}.</h2>
          <p class="body-lg" style="margin-top:1rem">
            The calendar does not charge the audit. We confirm scope, then you decide.
          </p>
        </div>
        <BookCall
          heading={`Book the ${c.name} audit call`}
          body="Pick a time. The audit is $1,500. This booking does not take payment."
          ctaLabel="Pick a time"
          note={`${c.drive}. The free start is the missed-call test, not this calendar.`}
        />
      </div>
    </section>
  </main>
  <SiteFooter />
</Base>
