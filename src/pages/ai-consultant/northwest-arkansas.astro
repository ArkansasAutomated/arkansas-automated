---
import Base from "../../layouts/Base.astro";
import SiteNav from "../../components/SiteNav.astro";
import SiteFooter from "../../components/SiteFooter.astro";
import BookCall from "../../components/BookCall.astro";

const title = "AI Consultant in Northwest Arkansas | Arkansas Automated";
const description =
  "AI consultant for Rogers, Fayetteville, and Bentonville. The front door is a free missed-call test, then a $1,500 leak audit. One page for Northwest Arkansas, not a city template.";

const site = "https://arkansasautomated.com";
const schema = {
  "@context": "https://schema.org",
  "@type": "Service",
  name: "AI consultant in Northwest Arkansas",
  serviceType: "AI consulting",
  provider: { "@type": "ProfessionalService", name: "Arkansas Automated", url: site },
  areaServed: [
    { "@type": "City", name: "Rogers, Arkansas" },
    { "@type": "City", name: "Fayetteville, Arkansas" },
    { "@type": "City", name: "Bentonville, Arkansas" },
  ],
  description,
  offers: {
    "@type": "Offer",
    price: "1500",
    priceCurrency: "USD",
    url: `${site}/audit`,
  },
};
---

<Base title={title} description={description} path="/ai-consultant/northwest-arkansas" schema={schema}>
  <SiteNav />
  <main id="main-content" tabindex="-1">
    <section class="hero">
      <div class="container">
        <nav class="crumbs" aria-label="Breadcrumb">
          <a href="/">Home</a><span>/</span><a href="/ai-consultant">AI consultant</a><span>/</span>Northwest Arkansas
        </nav>
        <h1 class="heading-xl measure">AI consultant in Northwest Arkansas.</h1>
        <p class="body-lg measure" style="margin-top:1.15rem">
          Rogers, Fayetteville, and Bentonville are one market for this work. The offer is the same in each town:
          a free missed-call test, then a $1,500 leak audit if the recording shows a real leak.
        </p>
        <div class="hero-ctas" style="margin-top:2rem">
          <a class="btn btn-primary" href="/missed-call-test">Get the missed-call test</a>
          <a class="btn btn-secondary" href="/audit">See the audit</a>
        </div>
      </div>
    </section>

    <section class="section section-tint">
      <div class="container">
        <h2 class="heading-lg measure">What the leak looks like up here.</h2>
        <p class="body-lg measure" style="margin-top:1.15rem">
          Rogers shops are often paying for the call already. A map pack or a lead vendor that rings out is money spent to lose the job.
          The audit prices that gap before anyone buys a tool.
        </p>
        <p class="body-lg measure" style="margin-top:1.15rem">
          Fayetteville has two seasons that break a front desk: the school year, and the summer turnover.
          Property managers, cleaners, and HVAC shops get hit in the same window. The useful question is which process breaks first, not whether AI works.
        </p>
        <p class="body-lg measure" style="margin-top:1.15rem">
          Bentonville has vendor offices that answer on the second ring, and local shops that run on the owner's cell phone.
          We work with the second group. The audit times the handoffs a customer will notice.
        </p>
      </div>
    </section>

    <section class="section" id="contact">
      <div class="container split">
        <div>
          <h2 class="heading-lg">About an hour from Fort Smith.</h2>
          <p class="body-lg" style="margin-top:1rem">
            Home base is Fort Smith. Northwest Arkansas is a regular trip, not a Houston agency with a city page.
          </p>
        </div>
        <BookCall
          heading="Book the audit call"
          body="The audit is $1,500. This calendar does not charge it. If you want the free test first, use the missed-call form."
          ctaLabel="Pick a time"
          note="Say Northwest Arkansas in the notes so the drive is on the calendar."
        />
      </div>
    </section>
  </main>
  <SiteFooter />
</Base>
