---
/*
 * Format for a published audit teardown. No client story until an owner
 * permits one, or until a job can be anonymized without inventing numbers.
 */
import Base from "../../layouts/Base.astro";
import SiteNav from "../../components/SiteNav.astro";
import SiteFooter from "../../components/SiteFooter.astro";

const title = "How an audit teardown is written | Arkansas Automated";
const description =
  "The format for a published Arkansas Automated audit teardown: the process watched, the cuts ranked by payback, and what we would not automate. No client story is published until the owner says yes.";

const sections = [
  {
    h: "The process watched",
    p: "Calls, estimates, follow-up, and the back office, timed as they actually run. Not a software tour.",
  },
  {
    h: "Cuts ranked by payback",
    p: "Each cut names the tool, the cost, and the staff impact. The first one is the one that pays for the next.",
  },
  {
    h: "What we would not automate",
    p: "Judgment, pricing exceptions, and anything a public page cannot make compliant. That list is part of the deliverable, not a footnote.",
  },
];

const site = "https://arkansasautomated.com";
const schema = {
  "@context": "https://schema.org",
  "@type": "Article",
  headline: "How an audit teardown is written",
  description,
  author: { "@type": "Person", name: "Andre Brassfield", url: `${site}/about` },
  publisher: { "@type": "Organization", name: "Arkansas Automated", url: site },
  mainEntityOfPage: `${site}/learn/audit-teardown`,
};
---

<Base title={title} description={description} path="/learn/audit-teardown" schema={schema}>
  <SiteNav />
  <main id="main-content" tabindex="-1">
    <section class="hero">
      <div class="container">
        <nav class="crumbs" aria-label="Breadcrumb">
          <a href="/">Home</a><span>/</span><a href="/learn">Learn</a><span>/</span>Audit teardown
        </nav>
        <h1 class="heading-xl measure">How an audit teardown is written.</h1>
        <p class="body-lg measure" style="margin-top:1.15rem">
          One published teardown a week is the proof plan. None are up yet.
          This page is the format, not a client result. A teardown lands here when the owner
          permits it, or when it can be anonymized without inventing numbers.
        </p>
      </div>
    </section>

    <section class="section section-tint">
      <div class="container">
        <div class="rows">
          {sections.map((s, idx) => (
            <article class="row">
              <div class="row-n">{String(idx + 1).padStart(2, "0")}</div>
              <h2>{s.h}</h2>
              <p>{s.p}</p>
            </article>
          ))}
        </div>
        <p class="body-lg measure" style="margin-top:2rem">
          The paid version of this document is the
          {" "}<a class="text-link" href="/audit">$999 operations audit</a>.
          This page will link each published teardown as it exists. It will not host a sample with made-up savings.
        </p>
      </div>
    </section>
  </main>
  <SiteFooter />
</Base>
