    kind: "AI, done for you",
    price: "$2,500 setup + $497/mo",
    unit: "Flat. Unlimited calls and minutes.",
    books: "Yes, onto your calendar",
    src: `${site}/pricing.md`,
  },
  {
    name: "Goodcall",
    kind: "AI, self-serve",
