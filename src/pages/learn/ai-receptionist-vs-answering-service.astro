---
/*
 * /learn/ai-receptionist-vs-answering-service — named-vendor comparison.
 *
 * Vendor prices below were read off the vendor's own pricing page on
 * 2026-09-22 and are cited with an outbound link. Do not add a price without
 * re-checking the source and bumping `priceChecked`. Machine-readable copy:
 * src/data/citation-hub/vendor-pricing-verified.csv
 */
import Base from "../../layouts/Base.astro";
import SiteNav from "../../components/SiteNav.astro";
import SiteFooter from "../../components/SiteFooter.astro";

const title = "AI Receptionist vs Answering Service: 2026 Prices From 8 Named Vendors | Arkansas Automated";
const description =
  "An AI receptionist costs $497 a month flat in Arkansas; named answering services cost $1,380 to $2,100 a month at 300 calls. Ruby, PATLive, AnswerConnect, Abby, Smith.ai, Goodcall, Dialzara, and Slang AI compared on published 2026 pricing.";

const priceChecked = "September 22, 2026";
const site = "https://arkansasautomated.com";
const pageUrl = `${site}/learn/ai-receptionist-vs-answering-service`;

const vendors = [
