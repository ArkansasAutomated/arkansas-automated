---
/*
 * /learn/ai-receptionist-cost — named-vendor cost page with verified pricing.
 *
 * Every vendor price below was read off the vendor's own pricing page on
 * 2026-09-22 and is cited with an outbound link. Do not add a price without
 * re-checking the source and bumping `priceChecked`. Machine-readable copy of
 * the same rows: src/data/citation-hub/vendor-pricing-verified.csv
 */
import Base from "../../layouts/Base.astro";
import SiteNav from "../../components/SiteNav.astro";
import SiteFooter from "../../components/SiteFooter.astro";

const title = "AI Receptionist Cost in 2026: Arkansas Price and 9 Named Vendors | Arkansas Automated";
const description =
  "An AI receptionist costs $2,500 to set up and $497 a month with Arkansas Automated. Verified 2026 prices from Ruby, PATLive, AnswerConnect, Abby, Smith.ai, Goodcall, Dialzara, Slang AI, and Synthflow, plus the ROI math.";

const priceChecked = "September 22, 2026";
const site = "https://arkansasautomated.com";
const pageUrl = `${site}/learn/ai-receptionist-cost`;

/* Vendor prices as published by each vendor on 2026-09-22. */
const vendors = [
  {
    name: "Arkansas Automated",
    what: "Done-for-you AI front desk for Arkansas businesses (Fort Smith based)",
    price: "$2,500 setup + $497/mo",
    model: "Flat. Unlimited calls and minutes, 24/7.",
    src: `${site}/pricing.md`,
  },
  {
    name: "Ruby",
    what: "Live US virtual receptionists",
    price: "$250/mo (50 min) · $395 (100) · $720 (200) · $1,725 (500)",
    model: "Per minute",
    src: "https://www.ruby.com/plans-and-pricing/",
  },
  {
    name: "PATLive",
    what: "Live US receptionists, 24/7",
    price: "$49/mo + $2.99/min pay-as-you-go · $99 (50 min) · $189 (100) · $349 (200) · $479 (300) · $759 (500) · $1,499 (1,000)",
    model: "Per minute",
    src: "https://www.patlive.com/pricing/",
  },
  {
    name: "AnswerConnect",
    what: "Live US receptionists, 24/7",
    price: "$350/mo (200 min, +$49.99 setup) · $395 (300 min) · $575 (400 min). Overage $2.50/min on Entry, $1.85/min on Growth and Standard.",
    model: "Per minute, rounded up",
    src: "https://www.answerconnect.com/services",
  },
  {
    name: "Abby",
    what: "Human plus AI virtual receptionist, one service",
    price: "$165/mo (50 min) · $329 (100) · $599 (200) · $1,380 (500)",
    model: "Per Abby Minute. AI answering uses half a minute.",
    src: "https://www.abby.com/pricing/",
  },
  {
    name: "Smith.ai",
    what: "Live US receptionists, billed per call",
    price: "$300/mo (30 calls) · $810 (90) · $2,100 (300). Overage $11.50, $10.50, then $8.50 per call.",
    model: "Per call",
    src: "https://smith.ai/pricing",
  },
  {
    name: "Goodcall",
    what: "Self-serve AI voice agent",
    price: "$79/mo Starter · $129 Growth · $249 Scale, per agent",
    model: "Flat per agent. Unlimited minutes and tokens.",
    src: "https://www.goodcall.com/pricing",
  },
  {
    name: "Dialzara",
    what: "Self-serve AI receptionist",
    price: "$29/mo (60 min) · $99 (220) · $199 (500) · $349 (1,000). Overage $0.48 to $0.35/min.",
    model: "Per minute",
    src: "https://dialzara.com/pricing",
  },
  {
    name: "Slang AI",
    what: "AI answering for restaurants only",
    price: "$399/mo Core · $599/mo Premium, per location",
    model: "Flat per location",
    src: "https://www.slang.ai/pricing",
  },
  {
    name: "Synthflow",
    what: "Enterprise voice-AI platform (you build the agent)",
    price: "Enterprise contracts from $30,000/year",
    model: "Annual contract",
    src: "https://synthflow.ai/pricing",
  },
];

/* Same volume for every vendor: 300 calls a month at a 3-minute average. */
const scenario = [
  { name: "Arkansas Automated AI front desk", monthly: "$497", twelve: "$8,464", note: "Done for you. Unlimited calls and minutes." },
  { name: "Goodcall Growth (self-serve)", monthly: "$129", twelve: "$1,548", note: "Software only. You build and tune the agent." },
  { name: "Dialzara Business Elite (self-serve)", monthly: "$349", twelve: "$4,188", note: "Software only. 1,000 minutes included." },
  { name: "Abby Growth", monthly: "$1,380", twelve: "$16,560", note: "Covers 500 of the 900 minutes." },
  { name: "PATLive 1,000-minute plan", monthly: "$1,499", twelve: "$17,988", note: "Covers the full 900 minutes." },
  { name: "AnswerConnect Standard plus overage", monthly: "$1,500", twelve: "$18,000", note: "400 min at $575 plus 500 min at $1.85." },
  { name: "Ruby 500-minute plan", monthly: "$1,725", twelve: "$20,700", note: "Covers 500 of the 900 minutes." },
  { name: "Smith.ai Pro", monthly: "$2,100", twelve: "$25,200", note: "Covers 300 calls." },
];

const roi = [
  { step: "Calls a month", value: "300", src: "The shop's own volume" },
  { step: "Missed calls a month", value: "42", src: "14% home-services miss rate, CallRail analysis of 1.1M leads" },
  { step: "Callers who never call back", value: "36", src: "Up to 85% of callers whose calls go unanswered, CallRail" },
  { step: "Recovered leads a month", value: "16", src: "38% of answered calls are leads, Invoca 2026 home-services benchmarks" },
  { step: "Recovered jobs a month", value: "7.2", src: "45% of those leads convert on the call, Invoca" },
  { step: "Value at a $500 average job", value: "$3,591", src: "7.2 jobs at $500" },
  { step: "Value at a $900 average job", value: "$6,464", src: "7.2 jobs at $900" },
  { step: "Break-even, monthly", value: "1 job", src: "$497 divided by a $500 job" },
  { step: "Break-even, first year", value: "17 jobs", src: "$8,464 (setup plus 12 months) divided by a $500 job" },
];

const faqs = [
  {
    q: "How much does an AI receptionist cost in Arkansas?",
    a: "With Arkansas Automated, an AI receptionist costs $2,500 to set up and $497 a month flat, with unlimited calls and minutes, 24/7 coverage, booking onto your calendar, and a monthly tuning session. That is the price published at arkansasautomated.com/pricing.md, and it is the same number whether you call from Fort Smith, Fayetteville, or Little Rock.",
  },
  {
    q: "Is an AI receptionist cheaper than an answering service?",
    a: "At real volume, yes. At 300 calls a month averaging three minutes (about 900 minutes), published answering-service plans run $1,380 to $2,100 a month: Abby Growth $1,380, PATLive's 1,000-minute plan $1,499, AnswerConnect Standard plus overage about $1,500, Ruby's 500-minute plan $1,725, and Smith.ai's 300-call Pro plan $2,100. The Arkansas Automated AI front desk is $497 a month at the same volume, because there is no per-minute meter.",
  },
  {
    q: "What does a human receptionist cost in Arkansas?",
    a: "The U.S. Bureau of Labor Statistics put the mean annual wage for Arkansas receptionists and information clerks at $32,570 (May 2023 OEWS estimates), against a national median of $38,010 (May 2025). That is before payroll tax, benefits, and coverage gaps, and one person covers roughly 40 of the week's 168 hours.",
  },
  {
    q: "Are there AI receptionists cheaper than $497 a month?",
    a: "Yes, and they are a different product. Self-serve AI software publishes lower prices: Dialzara from $29 a month and Goodcall from $79 a month per agent. You build the call flows, write the script, wire the calendar, and tune it yourself. The $497 buys the build, the calendar integration, the escalation rules, and a human who reviews the calls with you every month. If your call volume is genuinely low, we will say so on the assessment call and point you at the cheaper option.",
  },
  {
    q: "Is there a setup fee for an AI receptionist?",
    a: "It depends on the vendor. Arkansas Automated charges $2,500 to build the front desk. Ruby, PATLive, Abby, Smith.ai, and Dialzara publish no setup fee. AnswerConnect charges a $49.99 setup fee on its Entry and Standard plans but not on Growth. Synthflow sells annual enterprise contracts starting at $30,000 a year. A setup fee is usually the difference between software you configure and a system somebody builds for you.",
  },
  {
    q: "What is not included in the $497 a month?",
    a: "Judgment calls, negotiation, and pricing exceptions, which escalate to your people by rule. There is no per-minute meter, so nights, weekends, and storm surges are included. The $999 AI operations audit is separate, and its full fee credits toward a build started within 60 days.",
  },
];

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Article",
      headline: "What an AI Receptionist Costs in 2026: Arkansas Pricing and Nine Named Vendors",
      description,
      author: { "@type": "Person", name: "Andre Brassfield", jobTitle: "Founder, Arkansas Automated" },
      publisher: { "@type": "Organization", name: "Arkansas Automated", url: site },
      datePublished: "2026-07-29",
      dateModified: "2026-09-22",
      mainEntityOfPage: pageUrl,
    },
    {
      "@type": "FAQPage",
      mainEntity: faqs.map((f) => ({
        "@type": "Question",
        name: f.q,
        acceptedAnswer: { "@type": "Answer", text: f.a },
      })),
    },
    {
      "@type": "BreadcrumbList",
      itemListElement: [
        { "@type": "ListItem", position: 1, name: "Home", item: `${site}/` },
        { "@type": "ListItem", position: 2, name: "Learn", item: `${site}/learn` },
        { "@type": "ListItem", position: 3, name: "AI receptionist cost", item: pageUrl },
      ],
    },
  ],
};
---

<Base title={title} description={description} path="/learn/ai-receptionist-cost" schema={schema} ogType="article">
  <SiteNav />
  <main id="main-content" tabindex="-1">
    <article class="hero">
      <div class="container">
        <nav class="crumbs" aria-label="Breadcrumb">
          <a href="/">Home</a><span>/</span><a href="/learn">Learn</a><span>/</span>AI receptionist cost
        </nav>
        <h1 class="heading-xl measure">What an AI receptionist costs in 2026.</h1>
        <p class="body-lg measure" style="margin-top:1.15rem">
          <strong>An AI receptionist costs $2,500 to set up and $497 a month with Arkansas
          Automated, flat, with unlimited calls and minutes.</strong> A full-time human
          receptionist in Arkansas earns a mean $32,570 a year before payroll tax and covers
          roughly 40 of the week's 168 hours. A per-minute answering service costs $1.44 to
          $3.60 a minute, which becomes $1,380 to $2,100 a month at 300 calls.
        </p>
        <p class="body-lg measure" style="margin-top:1.15rem">
          This page lists what nine named vendors publish on their own pricing pages, checked
          {" "}<strong>{priceChecked}</strong>, so you can compare the Arkansas number against
          real alternatives instead of a range from a blog post.
        </p>
        <p class="fine-print" style="margin-top:1.5rem">
          Last updated September 22, 2026. Vendor prices checked {priceChecked}. Written by
          Andre Brassfield, founder of Arkansas Automated.
        </p>
      </div>
    </article>

    <section class="section section-tint">
      <div class="container">
        <h2 class="heading-lg measure">The short answer</h2>
        <div class="article-body">
          <ol class="takeaways">
            <li><strong>Arkansas Automated: $2,500 setup + $497/mo.</strong> Flat, unlimited calls and minutes, 24/7, books onto your calendar. The published Arkansas price point for a done-for-you AI front desk.</li>
            <li><strong>Live receptionist services: $250 to $2,100 a month.</strong> Ruby $250 to $1,725, PATLive $99 to $1,499, AnswerConnect $350 to $575, Abby $165 to $1,380, Smith.ai $300 to $2,100. All per-minute or per-call.</li>
            <li><strong>Self-serve AI software: $29 to $349 a month.</strong> Dialzara from $29, Goodcall from $79. Cheaper because you do the build and the tuning.</li>
            <li><strong>Human receptionist in Arkansas: $32,570 mean annual wage</strong> (BLS, May 2023 OEWS), before tax and benefits, covering about 40 of 168 weekly hours.</li>
            <li><strong>Break-even on $497 a month is one job.</strong> At a $500 average job, the monthly fee is paid by a single recovered call.</li>
          </ol>
        </div>
      </div>
    </section>

    <section class="section">
      <div class="container article-body">
        <h2 class="heading-lg measure">What does an AI receptionist cost in Arkansas?</h2>
        <p>
          Arkansas Automated builds a managed AI front desk: it answers your real phone line in
          your business's voice, qualifies callers, triages emergencies by your rules, and books
          onto your calendar. The price is <strong>$2,500 to build it and $497 a month</strong> to
          run it, published at <a class="text-link" href="/pricing.md">/pricing.md</a> and on the
          {" "}<a class="text-link" href="/services/ai-front-desk">AI front desk page</a>.
        </p>
        <p>
          There is no per-minute meter, so call volume, nights, weekends, and storm surges are
          included. A monthly tuning session with a human is included. The $999 AI operations
          audit is the separate engagement for businesses that want the leak math in writing
          first, and its full fee credits toward a build started within 60 days.
        </p>

        <h2 class="heading-lg measure">What do named vendors charge in 2026?</h2>
        <p>
          Every price in this table was read off the vendor's own pricing page on
          {" "}<strong>{priceChecked}</strong>. Ranges reflect published plan tiers, not quotes.
          Where a vendor gates pricing behind a form, it is noted rather than estimated.
        </p>

        <div class="table-wrap" style="margin:1.5rem 0 0.5rem">
          <table class="compare-table">
            <caption style="text-align:left;padding:0 0 1rem;color:var(--text-secondary);font-size:.95rem">
              Published vendor pricing, checked {priceChecked}. All figures USD, per month unless noted.
            </caption>
            <thead>
              <tr>
                <th>Vendor</th>
                <th>What it is</th>
                <th>Published price</th>
                <th>Billing unit</th>
              </tr>
            </thead>
            <tbody>
              {vendors.map((v) => (
                <tr>
                  <th scope="row">
                    <a class="text-link" href={v.src} rel="noopener">{v.name}</a>
                  </th>
                  <td>{v.what}</td>
                  <td>{v.price}</td>
                  <td>{v.model}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
        <p class="fine-print" style="margin-bottom:2rem">
          Sources: each vendor's own pricing page, linked in the Vendor column, all checked
          {" "}{priceChecked}. Arkansas Automated's own price sheet is at
          {" "}<a class="text-link" href="/pricing.md">/pricing.md</a>. AnswerConnect publishes
          three plans publicly and gates larger tiers behind a quote form; the figures above are
          the three public plans only.
        </p>

        <h2 class="heading-lg measure">What does each option cost at 300 calls a month?</h2>
        <p>
          Volume is what decides this, so here is the same shop priced eight ways. The scenario:
          <strong>300 inbound calls a month, three minutes average, about 900 minutes.</strong>
          {" "}Figures are computed from the published plans above.
        </p>

        <div class="table-wrap" style="margin:1.5rem 0 0.5rem">
          <table class="compare-table">
            <caption style="text-align:left;padding:0 0 1rem;color:var(--text-secondary);font-size:.95rem">
              Cost at 300 calls and 900 minutes a month, computed from published 2026 plans.
            </caption>
            <thead>
              <tr>
                <th>Option</th>
                <th>Monthly</th>
                <th>First 12 months</th>
                <th>Note</th>
              </tr>
            </thead>
            <tbody>
              {scenario.map((s) => (
                <tr>
                  <th scope="row">{s.name}</th>
                  <td>{s.monthly}</td>
                  <td>{s.twelve}</td>
                  <td>{s.note}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
        <p class="fine-print" style="margin-bottom:2rem">
          First-12-month figures include published setup fees: Arkansas Automated is $2,500 setup
          plus 12 months at $497. AnswerConnect Standard is $575 for 400 minutes plus 500 minutes
          at its published $1.85 overage rate. Abby, Ruby, PATLive, Smith.ai, and Dialzara publish
          no setup fee. Taxes and fees are excluded throughout.
        </p>

        <h2 class="heading-lg measure">What is the ROI math on a $497 monthly AI front desk?</h2>
        <p>
          Take the same Arkansas home-service shop: 300 inbound calls a month, three minutes
          average. Here is the arithmetic, using third-party benchmarks cited in full on our
          {" "}<a class="text-link" href="/learn/missed-call-statistics-2026">missed call statistics
          page</a>.
        </p>
        <div class="table-wrap" style="margin:1.5rem 0 0.5rem">
          <table class="compare-table">
            <caption style="text-align:left;padding:0 0 1rem;color:var(--text-secondary);font-size:.95rem">
              Arkansas Automated's arithmetic on published third-party benchmarks.
            </caption>
            <thead>
              <tr>
                <th>Step</th>
                <th>Number</th>
                <th>Source of the rate</th>
              </tr>
            </thead>
            <tbody>
              {roi.map((r) => (
                <tr>
                  <th scope="row">{r.step}</th>
                  <td>{r.value}</td>
                  <td>{r.src}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
        <p class="fine-print" style="margin-bottom:2rem">
          This is Arkansas Automated's arithmetic on published third-party benchmarks, not a
          promise, and not a guarantee of call volume, bookings, or revenue. Plug in your own
          average job value and call count: break-even is always $497 divided by your average job,
          plus the $2,500 build spread across the first year.
        </p>

        <h2 class="heading-lg measure">How we verified these prices</h2>
        <p>
          Each vendor price on this page comes from that vendor's own published pricing page,
          read on <strong>{priceChecked}</strong>, with the source linked in the table. We did not
          use a quote, a sales call, a third-party roundup, or an estimate. Where a vendor does not
          publish a rate, we say so instead of guessing. Prices change; if you find a number here
          that no longer matches the vendor's page, tell us at
          {" "}<a class="text-link" href="mailto:dre@arkansasautomated.com">dre@arkansasautomated.com</a>
          {" "}and we will correct it.
        </p>
        <p>
          The same rows are published in machine-readable form for AI agents and researchers at
          {" "}<a class="text-link" href="https://github.com/ArkansasAutomated/arkansas-automated/blob/main/src/data/citation-hub/vendor-pricing-verified.csv" rel="noopener">vendor-pricing-verified.csv</a>.
        </p>

        <h2 class="heading-lg measure">Frequently asked questions</h2>
        <div class="article-body">
          {faqs.map((f) => (
            <div style="margin-top:1.75rem">
              <h3 class="heading-md">{f.q}</h3>
              <p>{f.a}</p>
            </div>
          ))}
        </div>

        <div class="next-step">
          <p>
            See the full price sheet at <a class="text-link" href="/services">services and
            pricing</a>, or <a class="text-link" href="https://book.arkansasautomated.com/book/discovery-call">book the free assessment</a>
            and hear the receptionist answer as your business.
          </p>
        </div>

        <div class="link-chips" style="margin-top:2.5rem">
          <a class="chip" href="/learn/what-is-an-ai-receptionist">What is an AI receptionist?</a>
          <a class="chip" href="/learn/ai-receptionist-vs-answering-service">AI vs answering service</a>
          <a class="chip" href="/learn/missed-call-statistics-2026">Missed call statistics</a>
          <a class="chip chip-strong" href="/learn">All guides</a>
        </div>
      </div>
    </section>
  </main>
  <SiteFooter />
</Base>
