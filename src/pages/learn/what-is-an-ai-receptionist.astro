---
/*
 * /learn/what-is-an-ai-receptionist — Glossary playbook. Definition-first
 * structure for "what is" queries, Article + FAQPage schema.
 */
import Base from "../../layouts/Base.astro";
import SiteNav from "../../components/SiteNav.astro";
import SiteFooter from "../../components/SiteFooter.astro";

const title = "What Is an AI Receptionist? | Arkansas Automated";
const description =
  "An AI receptionist is software that answers your business phone around the clock, qualifies callers, and books jobs. What it does, what it costs, and where it stops.";

const faqs = [
  {
    q: "Is an AI receptionist the same as a chatbot?",
    a: "No. A chatbot lives on your website and types. An AI receptionist answers your actual phone line, speaks, listens, and takes action: booking appointments, answering questions from your script, and escalating to a human by your rules.",
  },
  {
    q: "Will my customers know they are talking to AI?",
    a: "They will know it is fast, consistent, and always available. Modern voice systems handle natural speech, interruptions, and Arkansas accents well. You hear yours on a live call before it ever takes a real customer call, so you decide with your own ears.",
  },
  {
    q: "What can an AI receptionist not do?",
    a: "Judgment. Negotiation, pricing exceptions, upset-customer rescue, and the conversations that decide whether somebody trusts your company stay with your people. A good system states plainly where it stops and hands off.",
  },
];

const site = "https://arkansasautomated.com";
const pageUrl = `${site}/learn/what-is-an-ai-receptionist`;
const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Article",
      headline: "What Is an AI Receptionist?",
      description,
      author: { "@type": "Person", name: "Andre Brassfield", jobTitle: "Founder, Arkansas Automated" },
      publisher: { "@type": "Organization", name: "Arkansas Automated", url: site },
      datePublished: "2026-07-29",
      dateModified: "2026-07-29",
      mainEntityOfPage: pageUrl,
    },
    {
      "@type": "FAQPage",
      mainEntity: faqs.map((f) => ({
        "@type": "Question",
        name: f.q,
        acceptedAnswer: { "@type": "Answer", text: f.a },
      })),
    },
    {
      "@type": "BreadcrumbList",
      itemListElement: [
        { "@type": "ListItem", position: 1, name: "Home", item: `${site}/` },
        { "@type": "ListItem", position: 2, name: "Learn", item: `${site}/learn` },
        { "@type": "ListItem", position: 3, name: "What is an AI receptionist?", item: pageUrl },
      ],
    },
  ],
};
---

<Base title={title} description={description} path="/learn/what-is-an-ai-receptionist" schema={schema} ogType="article">
  <SiteNav />
  <main>
    <article class="hero">
      <div class="container">
        <nav class="crumbs" aria-label="Breadcrumb">
          <a href="/">Home</a><span>/</span><a href="/learn">Learn</a><span>/</span>What is an AI receptionist?
        </nav>
        <h1 class="heading-xl measure">What is an AI receptionist?</h1>
        <p class="body-lg measure" style="margin-top:1.15rem">
          An AI receptionist is software that answers your business phone around the clock. It
          greets the caller in your business's voice, answers questions from a script you
          approve, qualifies the inquiry, books the job onto your real calendar, and hands off
          to a human whenever your rules say so. It costs a fraction of a hire and never misses
          a call.
        </p>
        <p class="fine-print" style="margin-top:1.5rem">
          Last updated July 2026. Written by Andre Brassfield, founder of Arkansas Automated.
        </p>
      </div>
    </article>

    <section class="section section-tint">
      <div class="container article-body">
        <h2 class="heading-lg measure">What it actually does on a call</h2>
        <p>
          On a live call, an AI receptionist does five things in order. It greets the caller
          with your business name and your script. It listens and answers common questions:
          hours, service area, pricing ranges you have approved. It qualifies the caller with
          the questions you would ask, like whether the situation is an emergency or what
          service they need. It books the job or appointment into your real availability. And
          it escalates to a human the moment your rules say to, whether that is a gas smell, a
          VIP customer, or anything the system is unsure about.
        </p>
        <p>
          After the call it does the office work: an SMS confirmation to the caller, a summary
          and recording to you, and the intake details pushed into whatever you use to run the
          schedule, from a Google Calendar to ServiceTitan.
        </p>

        <h2 class="heading-lg measure">What it costs in Arkansas</h2>
        <p>
          A full-time receptionist in Arkansas runs $2,500 to $3,500 a month before payroll tax,
          and covers 40 hours of a 168-hour week. An AI front desk from Arkansas Automated is
          $2,500 to set up plus $497 a month, covers all 168 hours, and answers every call on
          the first ring. For most small shops the math settles itself with one or two booked
          jobs a month that voicemail would have lost.
        </p>

        <h2 class="heading-lg measure">Where it stops</h2>
        <p>
          An AI receptionist is intake, not judgment. It should never negotiate price, rescue an
          upset customer, or improvise beyond its script. The systems we build state plainly
          where they stop and a human starts, and you test those boundaries on live calls before
          launch. If a vendor cannot tell you where their system stops, do not let it answer
          your phone.
        </p>

        <div class="next-step">
          <p>
            Want to hear one before you decide? <a class="text-link" href="/#reserve">Book the
            free 15-minute assessment</a> and we will load your business details so you can call
            it yourself. Or <a class="text-link" href="/#workshop">build your own in the Saturday
            workshop</a>, $497 early bird.
          </p>
        </div>
      </div>
    </section>

    <section class="section">
      <div class="container faq-wrap">
        <h2 class="heading-lg measure">Common questions</h2>
        <div class="faq-list">
          {
            faqs.map((f) => (
              <details class="faq-item">
                <summary>{f.q}</summary>
                <p>{f.a}</p>
              </details>
            ))
          }
        </div>
        <div class="link-chips" style="margin-top:2.5rem">
          <a class="chip" href="/learn/ai-receptionist-vs-answering-service">AI receptionist vs answering service</a>
          <a class="chip" href="/learn/ai-receptionist-cost">What an AI receptionist costs</a>
          <a class="chip chip-strong" href="/learn">All guides</a>
        </div>
      </div>
    </section>
  </main>
  <SiteFooter />
</Base>
