---
/*
 * /booking-software — landing page for AA Book, our booking software.
 * Framework follows routemize.com (Dre directive 2026-09-19): hero with
 * trial + price anchor, old way / new way, how it works, industries,
 * pricing card, FAQ, final CTA. Priced at a 7-day free trial, then
 * $39/month. Copy is scoped to what the product actually ships — no
 * claims the repo cannot back: PROTOCOL 10.
 */
import Base from "../layouts/Base.astro";
import SiteNav from "../components/SiteNav.astro";
import SiteFooter from "../components/SiteFooter.astro";
import LeadForm from "../components/LeadForm.astro";
import BookCall from "../components/BookCall.astro";

const title = "AA Book — Instant Booking Software for Service Businesses | Arkansas Automated";
const description =
  "Customers book their own slots, jobs land on your real calendar, deposits get collected, and every job routes to the right tech. 7-day free trial, then $39 a month.";

const site = "https://arkansasautomated.com";

const features = [
  {
    h: "Your own booking link and pages",
    p: "A booking page per service — estimates, tune-ups, consultations. Put the link on your website, text it to a customer, post it. They pick a real open slot in seconds, no call needed.",
  },
  {
    h: "Drive-time-aware scheduling",
    p: "Route coverage is built in. Bookings cluster by part of town instead of zig-zagging the county, so the day stays tight.",
  },
  {
    h: "Your real calendar, not a second one",
    p: "Two-way Google Calendar sync. What books on your page lands on your calendar, and busy times block themselves so you never get double-booked.",
  },
  {
    h: "Payments and deposits at booking",
    p: "Collect payment or a deposit when they book, so no-shows stop costing you the drive.",
  },
  {
    h: "Confirmations and reminders",
    p: "Automatic confirmations and reminders go out from the system — the follow-up happens even when the shop is slammed.",
  },
  {
    h: "Rules that pre-qualify customers",
    p: "You decide what books itself and what needs your yes. No more tire-kickers holding a slot.",
  },
  {
    h: "Lead routing to the right tech",
    p: "Bookings and leads route by service area and trade, so the right crew gets the job instead of it sitting in a shared inbox.",
  },
  {
    h: "A price book for the trades",
    p: "Service pricing lives in the system, fail-closed — if a trade or service is not priced, it does not quote a number it cannot back up.",
  },
  {
    h: "Answered calls become booked jobs",
    p: "Pair it with our AI receptionist: after-hours and overflow calls get answered, qualified, and dropped onto your booking page as real jobs.",
  },
];

const oldWay = ["Does Tuesday work?", "No.", "Wednesday?", "I'm busy.", "Friday??", "…"];

const steps = [
  { n: "1", h: "Set your service area", p: "Where you're willing to drive. People inside it can book. People outside can't." },
  { n: "2", h: "Set your rules", p: "Pre-qualify every customer — interior repaint books itself, drywall patch asks you first." },
  { n: "3", h: "Set your hours", p: "When you take jobs. It reads your real Google Calendar too, so you never get double-booked." },
  { n: "4", h: "Someone wants to book you", p: "They open your link, the system checks their address against your area, rules, and live calendar." },
  { n: "5", h: "They pick a real slot", p: "Confirmations and reminders go out, the deposit is collected if you require one, and the job routes to the right tech." },
];

const trades = [
  "Painting", "Roofing", "HVAC", "Plumbing", "Electrical", "Landscaping",
  "Pressure Washing", "Fencing", "Concrete & Epoxy", "Decks & Patios",
  "Remodeling", "Cleaning", "Pest Control", "Handyman", "Flooring",
  "Windows & Doors", "Gutters", "Siding",
];

const faqs = [
  {
    q: "What is AA Book?",
    a: "AA Book is instant booking software for service businesses, built by Arkansas Automated. Customers self-book real open slots on your booking pages, jobs land on your Google Calendar, deposits are collected at booking, reminders go out automatically, and every job routes to the right person for the trade and service area.",
  },
  {
    q: "How is this different from Calendly or a booking plugin?",
    a: "Generic schedulers treat every appointment the same. AA Book is built for field service: it knows service areas, routes jobs to the right technician, carries a price book per trade, pre-qualifies who can book, and hands overflow calls from the AI receptionist straight onto the calendar. One system instead of a scheduler duct-taped to a form plugin.",
  },
  {
    q: "Does it work with my calendar?",
    a: "Yes. AA Book syncs two-way with Google Calendar. Availability, bookings, and busy times stay consistent on both sides.",
  },
  {
    q: "Can it answer the phone too?",
    a: "Yes — pair AA Book with our AI receptionist. After-hours and overflow calls get answered, qualified, and booked onto the same calendar, so a night call becomes a morning job instead of a missed one.",
  },
  {
    q: "How much does it cost?",
    a: "Every plan starts with a 7-day free trial. After the trial it's $39 a month, flat — your booking pages, drive-time-aware scheduling, calendar sync, payments and deposits, reminders, and lead routing included. Cancel any time.",
  },
  {
    q: "How long does setup take?",
    a: "About ten minutes. You set your service area, your booking rules, and your availability, then drop your booking link on your website or send it by text. The free 15-minute assessment walks you through it with your real services loaded.",
  },
];

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Service",
      name: "AA Book booking software",
      serviceType: "Online booking and scheduling software for service businesses",
      provider: { "@type": "ProfessionalService", name: "Arkansas Automated", url: site },
      areaServed: { "@type": "State", name: "Arkansas" },
      description,
      offers: {
        "@type": "Offer",
        price: "39.00",
        priceCurrency: "USD",
        description: "7-day free trial, then $39 per month.",
      },
    },
    {
      "@type": "FAQPage",
      mainEntity: faqs.map((f) => ({
        "@type": "Question",
        name: f.q,
        acceptedAnswer: { "@type": "Answer", text: f.a },
      })),
    },
    {
      "@type": "BreadcrumbList",
      itemListElement: [
        { "@type": "ListItem", position: 1, name: "Home", item: site },
        { "@type": "ListItem", position: 2, name: "AA Book booking software", item: `${site}/booking-software` },
      ],
    },
  ],
};
---

<Base {title} {description} path="/booking-software" {schema} ogImage="/og-aa-book.png">
  <SiteNav />

  <main>
    {/* Hero — trial CTA + price anchor, Routemize framework */}
    <section class="hero">
      <div class="container">
        <nav class="crumbs" aria-label="Breadcrumb">
          <a href="/">Home</a> <span aria-hidden="true">/</span> <span>AA Book</span>
        </nav>
        <span class="eyebrow">Instant booking, built for the trades · 7-day free trial</span>
        <h1 class="heading-xl measure">A better booking experience for you and your customers.</h1>
        <p class="body-lg measure" style="margin-top:1.15rem">
          AA Book is scheduling software built for Arkansas service businesses. Customers
          <strong>book their own slots</strong>, jobs land on your real calendar, deposits get
          collected, and every job routes to the right tech. Backed by a local team you actually
          call when something breaks.
        </p>
        <div class="hero-ctas" style="margin-top:2rem">
          <a class="btn btn-primary" href="#trial">Start free trial</a>
          <a class="btn btn-secondary" href="#how">See how it works</a>
        </div>
        <p class="fine-print" style="margin-top:1.25rem">
          <strong>$39/mo</strong> after your trial · 7-day free trial · cancel any time
        </p>
      </div>
    </section>

    {/* Old way vs new way */}
    <section class="section section-tint" id="trial">
      <div class="container split">
        <div>
          <h2 class="heading-lg measure">Same customer. Two different endings.</h2>
          <p class="body-lg" style="margin-top:1rem">
            One of these takes four days. The other takes ten seconds.
          </p>
          <div style="margin-top:2rem">
            <p><strong>The old way · phone tag</strong></p>
            <p class="body-lg" style="margin-top:0.5rem">
              {oldWay.map((line, i) => (
                <>
                  {i > 0 && <br />}
                  <span>{line}</span>
                </>
              ))}
            </p>
            <p style="margin-top:1rem">4 days of texting. <strong>She booked the other guy.</strong></p>
          </div>
          <div style="margin-top:2rem">
            <p><strong>The new way · send a link</strong></p>
            <p class="body-lg" style="margin-top:0.5rem">
              "Can you give us a price?" → "Sure — pick a time 👇" → <strong>Booked Tuesday.</strong>
            </p>
            <p style="margin-top:1rem">10 seconds. And it's on your route.</p>
          </div>
          <p class="body-lg" style="margin-top:2rem">
            You didn't lose that customer on price. <strong>You lost it on speed.</strong>
          </p>
        </div>
        <div>
          <LeadForm
            formId="trial"
            defaultIntent="Start my 7-day free trial of AA Book"
            detailsPlaceholder="Example: we take bookings by phone and text and lose track of them. We want customers booking their own slots."
            submitLabel="Start my 7-day free trial"
          />
        </div>
      </div>
    </section>

    {/* How it works */}
    <section class="section" id="how">
      <div class="container">
        <h2 class="heading-lg measure">Five things happen. You set the first three once.</h2>
        <p class="body-lg measure" style="margin-top:1rem">
          Then it runs by itself, every time someone wants to book you.
        </p>
        <ul class="included" style="margin-top:2rem">
          {steps.map((s) => (
            <li>
              <strong>{s.n}. {s.h}.</strong> {s.p}
            </li>
          ))}
        </ul>
      </div>
    </section>

    {/* What it does */}
    <section class="section section-tint">
      <div class="container">
        <h2 class="heading-lg measure">What's included.</h2>
        <ul class="included" style="margin-top:2rem">
          {features.map((f) => (
            <li>
              <strong>{f.h}.</strong> {f.p}
            </li>
          ))}
        </ul>
        <div class="link-chips">
          <a class="chip" href="/fix/missed-calls">Missed calls</a>
          <a class="chip" href="/fix/no-shows">No-shows</a>
          <a class="chip" href="/ai-receptionist">AI receptionist</a>
          <a class="chip" href="/for">By industry</a>
        </div>
      </div>
    </section>

    {/* Industries */}
    <section class="section">
      <div class="container">
        <h2 class="heading-lg measure">One booking engine. Every trade.</h2>
        <p class="body-lg measure" style="margin-top:1rem">
          If your team drives to jobs, AA Book books them. A few of the trades it's built for:
        </p>
        <div class="link-chips" style="margin-top:1.5rem">
          {trades.map((t) => <span class="chip">{t}</span>)}
        </div>
        <p class="fine-print" style="margin-top:1.5rem">
          Don't see yours? If you schedule work by phone or text today, AA Book works for you.
        </p>
      </div>
    </section>

    {/* Pricing — 7-day trial, then $39/mo */}
    <section class="section section-tint" id="pricing">
      <div class="container">
        <h2 class="heading-lg measure">$39 a month. One booked job pays for it many times over.</h2>
        <div class="split" style="margin-top:2rem; align-items:start">
          <div>
            <span class="eyebrow">Starter</span>
            <p style="font-size:3rem; font-weight:700; margin:0.5rem 0 0; line-height:1">
              $39<span style="font-size:1rem; font-weight:400; color:var(--text-muted)">/mo</span>
            </p>
            <p class="body-lg" style="margin-top:0.5rem">For one person booking jobs. 7-day free trial, then $39 a month. Cancel any time.</p>
            <ul class="included" style="margin-top:1.5rem">
              <li>Your own booking link and pages</li>
              <li>Drive-time-aware scheduling and route coverage</li>
              <li>Service area and booking rules</li>
              <li>Two-way Google Calendar sync</li>
              <li>Payments and deposits at booking</li>
              <li>Confirmations and reminders</li>
              <li>Lead routing by trade and service area</li>
            </ul>
            <p class="fine-print" style="margin-top:1rem">
              Got a team? Ask us about multi-tech routing on your assessment call.
            </p>
          </div>
          <div>
            <LeadForm
              formId="pricing-trial"
              defaultIntent="Start my 7-day free trial of AA Book"
              detailsPlaceholder="Example: we run 2 trucks and want customers booking their own slots."
              submitLabel="Start my 7-day free trial"
            />
          </div>
        </div>
      </div>
    </section>

    {/* FAQ */}
    <section class="section">
      <div class="container faq-wrap">
        <h2 class="heading-lg measure">Common questions.</h2>
        <div class="faq-list" style="margin-top:1.5rem">
          {faqs.map((f) => (
            <details class="faq-item">
              <summary>{f.q}</summary>
              <p>{f.a}</p>
            </details>
          ))}
        </div>
      </div>
    </section>

    {/* Final CTA */}
    <section class="section section-tint" id="contact">
      <div class="container split">
        <div>
          <h2 class="heading-lg">Get your booking link live this week.</h2>
          <p class="body-lg" style="margin-top:1rem">
            Start with the free 15-minute assessment — we load your real services, walk your
            booking flow, and switch your 7-day trial on. Nothing is due at that call. Pick a
            time on the calendar and it is confirmed immediately.
          </p>
          <p class="fine-print" style="margin-top:2rem">
            Last updated September 2026. Written by Andre Brassfield, founder of Arkansas Automated.
          </p>
        </div>
        <BookCall
          heading="Pick your own time"
          note="Fifteen minutes. We load your real services, walk your booking flow, and switch your 7-day trial on. Nothing is due at that call."
        />
      </div>
    </section>
  </main>
  <SiteFooter />
</Base>
