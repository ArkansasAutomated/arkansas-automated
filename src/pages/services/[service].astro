---
/* /services/[service] — one deep page per engagement type. */
import Base from "../../layouts/Base.astro";
import SiteNav from "../../components/SiteNav.astro";
import SiteFooter from "../../components/SiteFooter.astro";
import BookCall from "../../components/BookCall.astro";
import { services, serviceBySlug } from "../../data/services";
import { AA_PUBLIC_PHONE_DISPLAY, AA_PUBLIC_PHONE_HREF } from "../../lib/public-phone";
import { FRONT_DOOR_START_URL } from "../../lib/front-door-checkout";

export function getStaticPaths() {
  return services
    .filter((s) => s.slug !== "visibility-install")
    .map((s) => ({ params: { service: s.slug } }));
}

const { service: slug } = Astro.params;
const s = serviceBySlug(slug);

const title = `${s.name === "Embedded automation retainer" ? "Automation retainer" : s.name} in Arkansas | Arkansas Automated`;
const description = `${s.tagline} ${s.price}.`;

const site = "https://arkansasautomated.com";
const pageUrl = `${site}/services/${s.slug}`;
const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Service",
      name: s.name,
      provider: { "@type": "ProfessionalService", name: "Arkansas Automated", url: site },
      areaServed: { "@type": "State", name: "Arkansas" },
      description: s.answer,
    },
    {
      "@type": "FAQPage",
      mainEntity: s.faqs.map((f) => ({
        "@type": "Question",
        name: f.q,
        acceptedAnswer: { "@type": "Answer", text: f.a },
      })),
    },
    {
      "@type": "BreadcrumbList",
      itemListElement: [
        { "@type": "ListItem", position: 1, name: "Home", item: `${site}/` },
        { "@type": "ListItem", position: 2, name: "Services", item: `${site}/services` },
        { "@type": "ListItem", position: 3, name: s.name, item: pageUrl },
      ],
    },
  ],
};
const others = services.filter((x) => x.slug !== s.slug);
const isFrontDoor = s.slug === "front-door";
const payUrl = isFrontDoor ? FRONT_DOOR_START_URL : "";
---

<Base title={title} description={description} path={`/services/${s.slug}`} schema={schema}>
  <SiteNav />
  <main id="main-content" tabindex="-1">
    <section class="hero">
      <div class="container">
        <nav class="crumbs" aria-label="Breadcrumb">
          <a href="/">Home</a><span>/</span><a href="/services">Services</a><span>/</span>{s.name}
        </nav>
        <span class="eyebrow">{s.price}</span>
        <h1 class="heading-xl measure">{s.name}.</h1>
        <p class="body-lg measure" style="margin-top:1.15rem">{s.answer}</p>
        <div class="hero-ctas" style="margin-top:2rem">
          {payUrl ? (
            <>
              <a class="btn btn-primary" href={payUrl}>Pay $197 to start</a>
              <a class="btn btn-secondary" href="#contact">Questions first</a>
            </>
          ) : isFrontDoor ? (
            <>
              <a class="btn btn-primary" href="https://book.arkansasautomated.com/book/discovery-call">Book the free assessment</a>
              <a class="btn btn-secondary" href={AA_PUBLIC_PHONE_HREF}>Call {AA_PUBLIC_PHONE_DISPLAY}</a>
            </>
          ) : (
            <>
              <a class="btn btn-primary" href="https://book.arkansasautomated.com/book/discovery-call">Book the free assessment</a>
              <a class="btn btn-secondary" href="/services/front-door">Front Door $497</a>
            </>
          )}
        </div>
      </div>
    </section>

    <section class="section section-tint">
      <div class="container">
        <h2 class="heading-lg measure">What is included.</h2>
        <ul class="included">
          {s.includes.map((i) => <li>{i}</li>)}
        </ul>
        {payUrl && (
          <div class="form-note" style="margin-top:1.5rem">
            <p>$197 to start, $300 when you approve staging. Card only. No Affirm or Afterpay.</p>
            <a class="btn btn-primary" href={payUrl} style="margin-top:1.25rem">Pay $197 to start</a>
          </div>
        )}
      </div>
    </section>

    <section class="section">
      <div class="container">
        <h2 class="heading-lg measure">How the work runs.</h2>
        <div class="rows">
          {
            s.process.map((p, idx) => (
              <article class="row">
                <div class="row-n">{String(idx + 1).padStart(2, "0")}</div>
                <h3>{p.h}</h3>
                <p>{p.p}</p>
              </article>
            ))
          }
        </div>
      </div>
    </section>

    <section class="section section-tint">
      <div class="container faq-wrap">
        <h2 class="heading-lg measure">Straight answers.</h2>
        <div class="faq-list">
          {
            s.faqs.map((f) => (
              <details class="faq-item">
                <summary>{f.q}</summary>
                <p>{f.a}</p>
              </details>
            ))
          }
        </div>
      </div>
    </section>

    <section class="section">
      <div class="container">
        <h2 class="heading-md">Other ways to work with us</h2>
        <div class="link-chips">
          {others.map((o) => <a class="chip" href={`/services/${o.slug}`}>{o.name}</a>)}
          <a class="chip chip-strong" href="/ai-workshops">Workshops by city</a>
        </div>
      </div>
    </section>

    <section class="section section-tint" id="contact">
      <div class="container split">
        <div>
          <h2 class="heading-lg">{payUrl ? "Pay $197 to start, or ask a question." : "Start with the free assessment."}</h2>
          <p class="body-lg" style="margin-top:1rem">
            {payUrl
              ? "Card checkout for the Front Door start. $497 total. The $300 balance is due only after you approve staging in writing."
              : "Fifteen minutes, your business details, and a straight answer on whether this pays for itself in your operation. No payment due now; we reply from a real address."}
          </p>
          {payUrl && (
            <a class="btn btn-primary" href={payUrl} style="margin-top:1.25rem">Pay $197 to start</a>
          )}
          <p class="fine-print" style="margin-top:2rem">
            Last updated July 2026. Written by Andre Brassfield, founder of Arkansas Automated.
          </p>
        </div>
        <BookCall
          heading="Pick a time on the live calendar"
          note={`Fifteen minutes on the ${s.name.toLowerCase()} for your business, and a straight answer on whether it pays for itself. No payment due now.`}
        />
      </div>
    </section>
  </main>
  <SiteFooter />
</Base>
