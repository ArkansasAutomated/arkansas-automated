---
/* /services/[service] — one deep page per engagement type. */
import Base from "../../layouts/Base.astro";
import SiteNav from "../../components/SiteNav.astro";
import SiteFooter from "../../components/SiteFooter.astro";
import LeadForm from "../../components/LeadForm.astro";
import { services, serviceBySlug } from "../../data/services";

export function getStaticPaths() {
  return services.map((s) => ({ params: { service: s.slug } }));
}

const { service: slug } = Astro.params;
const s = serviceBySlug(slug);

const title = `${s.name} in Arkansas | Arkansas Automated`;
const description = `${s.tagline} ${s.price}. Serving Fort Smith, Northwest Arkansas, and statewide.`;

const site = "https://arkansasautomated.com";
const pageUrl = `${site}/services/${s.slug}`;
const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Service",
      name: s.name,
      provider: { "@type": "ProfessionalService", name: "Arkansas Automated", url: site },
      areaServed: { "@type": "State", name: "Arkansas" },
      description: s.answer,
    },
    {
      "@type": "FAQPage",
      mainEntity: s.faqs.map((f) => ({
        "@type": "Question",
        name: f.q,
        acceptedAnswer: { "@type": "Answer", text: f.a },
      })),
    },
    {
      "@type": "BreadcrumbList",
      itemListElement: [
        { "@type": "ListItem", position: 1, name: "Home", item: `${site}/` },
        { "@type": "ListItem", position: 2, name: "Services", item: `${site}/services` },
        { "@type": "ListItem", position: 3, name: s.name, item: pageUrl },
      ],
    },
  ],
};
const others = services.filter((x) => x.slug !== s.slug);
---

<Base title={title} description={description} path={`/services/${s.slug}`} schema={schema}>
  <SiteNav />
  <main>
    <section class="hero">
      <div class="container">
        <nav class="crumbs" aria-label="Breadcrumb">
          <a href="/">Home</a><span>/</span><a href="/services">Services</a><span>/</span>{s.name}
        </nav>
        <span class="eyebrow">{s.price}</span>
        <h1 class="heading-xl measure">{s.name}.</h1>
        <p class="body-lg measure" style="margin-top:1.15rem">{s.answer}</p>
        <div class="hero-ctas" style="margin-top:2rem">
          <a class="btn btn-primary" href="#contact">Book the free assessment</a>
          <a class="btn btn-secondary" href="/#workshop">Or learn it in the workshop</a>
        </div>
      </div>
    </section>

    <section class="section section-tint">
      <div class="container">
        <h2 class="heading-lg measure">What is included.</h2>
        <ul class="included">
          {s.includes.map((i) => <li>{i}</li>)}
        </ul>
      </div>
    </section>

    <section class="section">
      <div class="container">
        <h2 class="heading-lg measure">How the work runs.</h2>
        <div class="rows">
          {
            s.process.map((p, idx) => (
              <article class="row">
                <div class="row-n">{String(idx + 1).padStart(2, "0")}</div>
                <h3>{p.h}</h3>
                <p>{p.p}</p>
              </article>
            ))
          }
        </div>
      </div>
    </section>

    <section class="section section-tint">
      <div class="container faq-wrap">
        <h2 class="heading-lg measure">Straight answers.</h2>
        <div class="faq-list">
          {
            s.faqs.map((f) => (
              <details class="faq-item">
                <summary>{f.q}</summary>
                <p>{f.a}</p>
              </details>
            ))
          }
        </div>
      </div>
    </section>

    <section class="section">
      <div class="container">
        <h2 class="heading-md">Other ways to work with us</h2>
        <div class="link-chips">
          {others.map((o) => <a class="chip" href={`/services/${o.slug}`}>{o.name}</a>)}
          <a class="chip chip-strong" href="/ai-workshops">Workshops by city</a>
        </div>
      </div>
    </section>

    <section class="section section-tint" id="contact">
      <div class="container split">
        <div>
          <h2 class="heading-lg">Start with the free assessment.</h2>
          <p class="body-lg" style="margin-top:1rem">
            Fifteen minutes, your business details, and a straight answer on whether this pays
            for itself in your operation. No payment due now; we reply from a real address.
          </p>
          <p class="fine-print" style="margin-top:2rem">
            Last updated July 2026. Written by Andre Brassfield, founder of Arkansas Automated.
          </p>
        </div>
        <LeadForm
          defaultIntent="Talk done-for-you or retainer"
          sourceService={s.name}
          detailsPlaceholder={`Example: I want to talk about the ${s.name.toLowerCase()} for my business.`}
        />
      </div>
    </section>
  </main>
  <SiteFooter />
</Base>
