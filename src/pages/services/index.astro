---
import Base from "../../layouts/Base.astro";
import SiteNav from "../../components/SiteNav.astro";
import SiteFooter from "../../components/SiteFooter.astro";

const title = "Prices | Arkansas Automated";
const description =
  "Free missed-call test. Leak audit $1,500, credited in full toward the first fix. First fix from $2,500. Advisor retainer from $2,000 a month. Strategy and roadmap from $7,500.";

const ladder = [
  {
    name: "Missed-call test",
    price: "Free",
    p: "I call the line after the office is closed and send a short recording of what happened.",
    href: "/missed-call-test",
  },
  {
    name: "Leak audit",
    price: "$1,500",
    p: "Ninety minutes. A written map, every leak costed, ranked by payback. The full fee comes off the first fix.",
    href: "/audit",
  },
  {
    name: "First fix",
    price: "From $2,500",
    p: "The one cut at the top of the map. Scoped before the check is written.",
    href: "/audit",
  },
  {
    name: "Advisor retainer",
    price: "From $2,000/mo",
    p: "The map stays current and the systems stay running.",
    href: "/forward-deployed-ai-engineer",
  },
  {
    name: "Strategy and roadmap",
    price: "From $7,500",
    p: "For a company with 25 or more people. The roadmap comes before any build.",
    href: "/audit",
  },
];

const site = "https://arkansasautomated.com";
const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "ItemList",
      name: "Arkansas Automated prices",
      itemListElement: ladder.map((s, i) => ({
        "@type": "ListItem",
        position: i + 1,
        name: `${s.name}, ${s.price}`,
        url: `${site}${s.href}`,
      })),
    },
    {
      "@type": "BreadcrumbList",
      itemListElement: [
        { "@type": "ListItem", position: 1, name: "Home", item: `${site}/` },
        { "@type": "ListItem", position: 2, name: "Prices", item: `${site}/services` },
      ],
    },
  ],
};
---

<Base title={title} description={description} path="/services" schema={schema}>
  <SiteNav />
  <main id="main-content" tabindex="-1">
    <section class="hero">
      <div class="container">
        <nav class="crumbs" aria-label="Breadcrumb">
          <a href="/">Home</a><span>/</span>Prices
        </nav>
        <h1 class="heading-xl measure">The prices are on the page.</h1>
        <p class="body-lg measure" style="margin-top:1.15rem">
          Start with the missed-call test. If the recording shows a leak, the audit is $1,500
          and that fee comes off the first fix. There is no free sales call, and there is no $497 website.
        </p>
        <div class="hero-ctas" style="margin-top:2rem">
          <a class="btn btn-primary" href="/missed-call-test">Get the missed-call test</a>
          <a class="btn btn-secondary" href="/audit">See the audit</a>
        </div>
      </div>
    </section>

    <section class="section section-tint">
      <div class="container">
        <div class="rows">
          {ladder.map((s) => (
            <article class="row row-pkg">
              <div class="row-n row-price">{s.price}</div>
              <h3><a class="text-link-plain" href={s.href}>{s.name}</a></h3>
              <p>{s.p}</p>
            </article>
          ))}
        </div>
        <p class="body-lg measure" style="margin-top:2.25rem;font-size:1rem">
          Machine-readable pricing for AI agents lives at
          {" "}<a class="text-link" href="/pricing.md">/pricing.md</a>.
        </p>
      </div>
    </section>
  </main>
  <SiteFooter />
</Base>
