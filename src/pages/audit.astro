---
import Base from "../layouts/Base.astro";
import SiteNav from "../components/SiteNav.astro";
import SiteFooter from "../components/SiteFooter.astro";
import BookCall from "../components/BookCall.astro";
import { serviceBySlug } from "../data/services";
import { AA_PUBLIC_PHONE_DISPLAY, AA_PUBLIC_PHONE_HREF } from "../lib/public-phone";

const s = serviceBySlug("operations-audit");
const title = "AI Operations Audit in Arkansas | Arkansas Automated";
const description =
  "The AI operations audit is $999. Ninety minutes in the operation, then a written map of every leak, costed and ranked by payback. The fee credits toward a build started within 60 days. No checkout on this page.";

const site = "https://arkansasautomated.com";
const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Service",
      name: s.name,
      serviceType: "AI operations audit",
      provider: { "@type": "ProfessionalService", name: "Arkansas Automated", url: site },
      areaServed: { "@type": "State", name: "Arkansas" },
      description: s.answer,
      offers: {
        "@type": "Offer",
        price: "999",
        priceCurrency: "USD",
        description: "Flat fee. Credits toward a done-for-you build started within 60 days.",
      },
    },
    {
      "@type": "FAQPage",
      mainEntity: s.faqs.map((f) => ({
        "@type": "Question",
        name: f.q,
        acceptedAnswer: { "@type": "Answer", text: f.a },
      })),
    },
    {
      "@type": "BreadcrumbList",
      itemListElement: [
        { "@type": "ListItem", position: 1, name: "Home", item: `${site}/` },
        { "@type": "ListItem", position: 2, name: "Audit", item: `${site}/audit` },
      ],
    },
  ],
};
---

<Base title={title} description={description} path="/audit" schema={schema}>
  <SiteNav />
  <main id="main-content" tabindex="-1">
    <section class="hero">
      <div class="container">
        <nav class="crumbs" aria-label="Breadcrumb">
          <a href="/">Home</a><span>/</span>Audit
        </nav>
        <span class="eyebrow">{s.price}</span>
        <h1 class="heading-xl measure">The AI operations audit.</h1>
        <p class="body-lg measure" style="margin-top:1.15rem">{s.answer}</p>
        <div class="hero-ctas" style="margin-top:2rem">
          <a class="btn btn-primary" href="#book">Book the audit call</a>
          <a class="btn btn-secondary" href={AA_PUBLIC_PHONE_HREF}>Call {AA_PUBLIC_PHONE_DISPLAY}</a>
        </div>
      </div>
    </section>

    <section class="section section-tint">
      <div class="container">
        <h2 class="heading-lg measure">What happens.</h2>
        <div class="rows">
          {s.process.map((step, idx) => (
            <article class="row">
              <div class="row-n">{String(idx + 1).padStart(2, "0")}</div>
              <h3>{step.h}</h3>
              <p>{step.p}</p>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="section">
      <div class="container">
        <h2 class="heading-lg measure">What you get.</h2>
        <div class="leak-grid">
          {s.includes.map((item) => (
            <article class="leak">
              <p>{item}</p>
            </article>
          ))}
        </div>
        <p class="body-lg measure" style="margin-top:1.5rem">
          The catalog page with the same price is
          {" "}<a class="text-link" href="/services/operations-audit">/services/operations-audit</a>.
          This page is the front door. The numbers do not differ.
        </p>
      </div>
    </section>

    <section class="section section-tint">
      <div class="container split">
        <div>
          <h2 class="heading-lg">Medical and dental.</h2>
        </div>
        <div>
          <p class="body-lg">
            Scheduling intake is not a clinical record. Public marketing pages do not establish
            compliance. Before any patient data moves, the practice and its advisers approve the
            data, the vendors, the access, and the human review. We do not start that work from
            this page.
          </p>
          <p class="body-lg" style="margin-top:1.1rem">
            Read the <a class="text-link" href="/automation-guardrails">automation guardrails</a>
            and the <a class="text-link" href="/for/dentists">dental page</a> before you book if
            the practice handles patient information.
          </p>
        </div>
      </div>
    </section>

    <section class="section">
      <div class="container faq-wrap">
        <h2 class="heading-lg measure">Questions before you book.</h2>
        <div class="faq-list">
          {s.faqs.map((f) => (
            <details class="faq-item">
              <summary>{f.q}</summary>
              <p>{f.a}</p>
            </details>
          ))}
          <details class="faq-item">
            <summary>Who should be in the room?</summary>
            <p>The owner, and whoever actually touches the phones, the estimates, or the books. A tour of the software without those people is a tour, not an audit.</p>
          </details>
          <details class="faq-item">
            <summary>What access do you need?</summary>
            <p>None before the working session. We watch the work as it runs and ask where the last ten jobs went. System access comes later, and only if you hire a build.</p>
          </details>
          <details class="faq-item">
            <summary>What if I do not want a build?</summary>
            <p>Then you keep the map. Build with someone else, or build nothing. The plan is yours either way. Payment is not taken on this page.</p>
          </details>
        </div>
      </div>
    </section>

    <section class="section section-tint" id="book">
      <div class="container split">
        <div>
          <h2 class="heading-lg">Book the call. Pay later, if you want the map.</h2>
          <p class="body-lg" style="margin-top:1rem">
            The calendar is the existing discovery call. It does not charge the $999.
            If the audit is the wrong shape, we say so on the call.
          </p>
        </div>
        <BookCall
          heading="Book the audit call"
          body="Pick a time on the live calendar. The audit is $999. This booking does not take payment."
          ctaLabel="Pick a time"
          note="Ninety minutes after we confirm scope. If a free 15-minute look is enough, say that in the notes and we will keep it to fifteen."
        />
      </div>
    </section>
  </main>
  <SiteFooter />
</Base>
