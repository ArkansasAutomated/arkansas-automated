---
import Base from "../layouts/Base.astro";
import SiteNav from "../components/SiteNav.astro";
import SiteFooter from "../components/SiteFooter.astro";
import { AA_PUBLIC_PHONE_DISPLAY, AA_PUBLIC_PHONE_HREF } from "../lib/public-phone";
const title = "Contact Arkansas Automated | Rogers and Fort Smith";
const description = "Call (479) 282-3121 or email dre@arkansasautomated.com. Arkansas Automated serves Rogers and Fort Smith.";
---
<Base title={title} description={description} path="/contact">
  <SiteNav />
  <main id="main-content" tabindex="-1"><section class="section"><div class="container article-body">
    <nav class="crumbs" aria-label="Breadcrumb"><a href="/">Home</a><span>/</span><span>Contact</span></nav>
    <h1 class="heading-lg">Talk with Arkansas Automated.</h1>
    <p class="body-lg">The front door is the $999 operations audit. Book the call, or start with Front Door if the storefront is the leak.</p>
    <div class="link-chips"><a class="chip chip-strong" href="/audit">Book the audit</a><a class="chip" href="/services/front-door">Front Door $497</a><a class="chip" href="https://book.arkansasautomated.com/book/discovery-call">Book a time</a></div>
    <h2 class="heading-md">Call</h2>
    <p><a class="text-link" href={AA_PUBLIC_PHONE_HREF}>{AA_PUBLIC_PHONE_DISPLAY}</a></p>
    <h2 class="heading-md">Service area</h2>
    <p>Rogers and Fort Smith, plus the rest of Arkansas. <a class="text-link" href="/ai-receptionist/rogers">Rogers</a>. <a class="text-link" href="/ai-receptionist/fort-smith">Fort Smith</a>.</p>
    <h2 class="heading-md">Email</h2>
    <p><a class="text-link" href="mailto:dre@arkansasautomated.com">dre@arkansasautomated.com</a></p>
    <p class="fine-print">We usually reply within one business day.</p>
  </div></section></main>
  <SiteFooter />
</Base>
