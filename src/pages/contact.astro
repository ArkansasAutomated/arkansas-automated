---
import Base from "../layouts/Base.astro";
import SiteNav from "../components/SiteNav.astro";
import SiteFooter from "../components/SiteFooter.astro";
import { AA_PUBLIC_PHONE_DISPLAY, AA_PUBLIC_PHONE_HREF } from "../lib/public-phone";
const title = "Contact Arkansas Automated";
const description = "Contact Arkansas Automated about an AI workshop, automation assessment, or done-for-you implementation.";
---
<Base title={title} description={description} path="/contact">
  <SiteNav />
  <main id="main-content" tabindex="-1"><section class="section"><div class="container article-body">
    <nav class="crumbs" aria-label="Breadcrumb"><a href="/">Home</a><span>/</span><span>Contact</span></nav>
    <h1 class="heading-lg">Talk with Arkansas Automated.</h1>
    <p class="body-lg">For workshop seats and implementation assessments, use the relevant request form so we receive the context needed to respond.</p>
    <div class="link-chips"><a class="chip chip-strong" href="https://book.arkansasautomated.com/book/front-desk-workshop">Request a workshop seat</a><a class="chip chip-strong" href="/#assessment-request">Request a fit assessment</a></div>
    <h2 class="heading-md">Call</h2>
    <p><a class="text-link" href={AA_PUBLIC_PHONE_HREF}>{AA_PUBLIC_PHONE_DISPLAY}</a></p>
    <h2 class="heading-md">Email</h2>
    <p><a class="text-link" href="mailto:dre@arkansasautomated.com">dre@arkansasautomated.com</a></p>
    <p class="fine-print">We usually reply within one business day. Workshop is at Central Mall, Fort Smith, upstairs event room.</p>
  </div></section></main>
  <SiteFooter />
</Base>
