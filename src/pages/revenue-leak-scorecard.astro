---
/*
 * /revenue-leak-scorecard: 12-question self-audit.
 * The dollar figure is the canon formula only.
 * No benchmark claim. No phone number in this file.
 */
import Base from "../layouts/Base.astro";
import SiteNav from "../components/SiteNav.astro";
import SiteFooter from "../components/SiteFooter.astro";

const title = "Revenue Leak Scorecard — Free 12-Question Self-Audit for Home Service Businesses";
const description =
  "Free Revenue Leak Scorecard for home service businesses: 12 questions, a Leak Score, and the yearly dollar leak.";

const site = "https://arkansasautomated.com";
const path = "/revenue-leak-scorecard";
const pageUrl = `${site}${path}`;
const schema = {
  "@context": "https://schema.org",
  "@type": "WebPage",
  name: "The Revenue Leak Scorecard",
  description,
  url: pageUrl,
  datePublished: "2026-09-25",
  mainEntityOfPage: pageUrl,
};
---

<Base title={title} description={description} path={path} schema={schema}>
  <SiteNav />
  <main id="main-content" tabindex="-1" class="rls-page">
    <section class="rls-hero">
      <div class="container">
        <p class="eyebrow">Free self-audit</p>
        <h1>The Revenue Leak Scorecard</h1>
        <p class="rls-promise">
          Answer 12 questions about how the business handles calls, follow-up, and bookings. You get a Leak Score and the dollar figure leaking out per year.
        </p>
        <p class="rls-quiet">Your numbers only. Nothing here is a quote, and nothing here is a benchmark against other shops.</p>
      </div>
    </section>

    <section class="section">
      <div class="container">
        <form class="rls-shell" id="rls-quiz" novalidate>
          <label class="rls-trade">
            Trade
            <select name="trade" id="rls-trade" required>
              <option value="">Select a trade</option>
              <option>HVAC</option>
              <option>Plumbing</option>
              <option>Electrical</option>
              <option>Roofing</option>
              <option>Dental</option>
              <option>Med spa</option>
              <option>Other</option>
            </select>
          </label>

          <div class="rls-quiz">
            <fieldset class="rls-q">
              <legend>Inbound calls per day</legend>
              <label>Calls per day<input name="callsPerDay" type="number" min="0" step="1" inputmode="numeric" required /></label>
            </fieldset>
            <fieldset class="rls-q">
              <legend>Percent of calls missed</legend>
              <label>Missed calls, percent<input name="missedPercent" type="number" min="0" max="100" step="any" inputmode="decimal" required /></label>
            </fieldset>
            <fieldset class="rls-q">
              <legend>Percent of calls arriving after hours</legend>
              <label>After-hours calls, percent<input name="afterHoursPercent" type="number" min="0" max="100" step="any" inputmode="decimal" required /></label>
            </fieldset>
            <fieldset class="rls-q">
              <legend>Average job value in dollars</legend>
              <label>
                Average job value
                <input name="jobValue" id="rls-job" type="number" min="0" step="any" inputmode="decimal" placeholder="enter your average job value" required />
              </label>
              <p class="rls-estimate" data-rls-estimate hidden>industry estimate</p>
            </fieldset>
            <fieldset class="rls-q">
              <legend>Close rate on answered calls, percent</legend>
              <label>Close rate, percent<input name="closeRatePercent" type="number" min="0" max="100" step="any" inputmode="decimal" required /></label>
            </fieldset>
            <fieldset class="rls-q">
              <legend>Response time to web/form leads</legend>
              <label>
                Response time
                <select name="speedToLead" required>
                  <option value="">Select a response time</option>
                  <option>under 5 min</option>
                  <option>under 1 hour</option>
                  <option>same day</option>
                  <option>next day+</option>
                </select>
              </label>
            </fieldset>
            <fieldset class="rls-q">
              <legend>No-show rate, percent</legend>
              <label>No-show rate, percent<input name="noShowPercent" type="number" min="0" max="100" step="any" inputmode="decimal" required /></label>
            </fieldset>
            <fieldset class="rls-q">
              <legend>Follow-up process for unsold estimates</legend>
              <label>
                Follow-up process
                <select name="followUp" required>
                  <option value="">Select a follow-up process</option>
                  <option>none</option>
                  <option>manual</option>
                  <option>automated</option>
                </select>
              </label>
            </fieldset>
            <fieldset class="rls-q">
              <legend>Review-request process</legend>
              <label>
                Review-request process
                <select name="reviewRequest" required>
                  <option value="">Select a review-request process</option>
                  <option>none</option>
                  <option>manual</option>
                  <option>automated</option>
                </select>
              </label>
            </fieldset>
            <fieldset class="rls-q">
              <legend>Number of trucks, chairs, or locations</legend>
              <label>Trucks, chairs, or locations<input name="units" type="number" min="0" step="1" inputmode="numeric" required /></label>
            </fieldset>
            <fieldset class="rls-q">
              <legend>Current monthly spend on answering/front desk, dollars</legend>
              <label>Monthly answering or front-desk spend<input name="monthlySpend" type="number" min="0" step="any" inputmode="decimal" required /></label>
            </fieldset>
            <fieldset class="rls-q">
              <legend>Who answers the phone when you're on a job?</legend>
              <label>
                Who answers
                <select name="whoAnswers" required>
                  <option value="">Select who answers</option>
                  <option>office staff</option>
                  <option>owner</option>
                  <option>voicemail</option>
                  <option>no one consistent</option>
                </select>
              </label>
            </fieldset>
          </div>

          <button class="btn btn-primary" type="submit">See the Leak Score</button>
        </form>

        <section class="rls-results" data-rls-results hidden aria-live="polite" tabindex="-1">
          <h2>Your Leak Score</h2>
          <div data-rls-missing hidden>
            <p>A number from an empty field would be made up. Still needed:</p>
            <ul data-rls-missing-list></ul>
          </div>
          <div data-rls-computed hidden>
            <p class="rls-score" data-rls-score></p>
            <p data-rls-band></p>
            <div data-rls-figure>
              <p data-rls-dollars></p>
              <p>This is an estimate, not a quote.</p>
            </div>
            <div data-rls-leaks></div>
            <div class="rls-bridge">
              <p data-rls-bridge></p>
              <p><a class="text-link" href="/marketing/">See your install options</a></p>
              <p><a class="text-link" href="/booking-software/">Book a 15-minute fit assessment</a></p>
            </div>
            <form class="rls-capture" data-rls-lead novalidate>
              <h3>Email this scorecard</h3>
              <label>
                Email
                <input name="email" type="email" autocomplete="email" required />
              </label>
              <button class="btn btn-primary" type="submit">Send the scorecard</button>
              <p class="rls-status" data-rls-status hidden role="status"></p>
              <p class="rls-legal">By submitting, you agree that Arkansas Automated may contact you about this scorecard. See our <a href="/privacy">privacy page</a>.</p>
            </form>
          </div>
        </section>
      </div>
    </section>
  </main>
  <SiteFooter />
</Base>

<script>
  import { HUB_LEADS_URL } from "../lib/hub";

  /*
   * Leak Score weights. Auditable. Start at 100. 100 means no visible leak.
   * Bands: BAND_TIGHT_MIN 80, BAND_LEAKING_MIN 50, BAND_OPEN_MIN 0.
   *
   * Point deductions, then clamped to 0-100:
   * MISSED_CALL_MAX 28, linear with missed percent.
   * AFTER_HOURS_MAX 16, linear with after-hours percent, only with no office coverage.
   * SPEED_UNDER_5 0, SPEED_UNDER_HOUR 6, SPEED_SAME_DAY 12, SPEED_NEXT_DAY 18.
   * FOLLOW_AUTO 0, FOLLOW_MANUAL 8, FOLLOW_NONE 14.
   * REVIEW_AUTO 0, REVIEW_MANUAL 4, REVIEW_NONE 8.
   * NO_SHOW_MAX 10, linear with no-show percent.
   * PHONE_OFFICE 0, PHONE_OWNER 4, PHONE_VOICEMAIL 8, PHONE_NONE 10.
   *
   * Dollar ranking uses the same inputs. The displayed annualized figure is
   * exactly (calls/day * missed% * close rate * average job value) * 12.
   * Percents are entered as 0-100 and applied as fractions.
   * Other leak dollars are ranking weights on those inputs, not recovery promises.
   * After-hours dollars use that shape with the after-hours percent, and only
   * when coverage is not office staff.
   * Speed factors of (calls/day * close rate * job value * 12): 0, 0.05, 0.12, 0.22.
   * Follow-up factors of unsold work, calls/day * (1 - missed) * (1 - close) * job * 12:
   * none 0.25, manual 0.10, automated 0.
   * Review factors of booked work, calls/day * (1 - missed) * close * job * 12:
   * none 0.06, manual 0.02, automated 0.
   * No-show dollars = booked work * no-show percent.
   * Phone-owner factors of (calls/day * close rate * job value * 12):
   * office staff 0, owner 0.08, voicemail 0.15, no one consistent 0.20.
   */
  const BAND_TIGHT_MIN = 80;
  const BAND_LEAKING_MIN = 50;
  const BAND_OPEN_MIN = 0;
  const MISSED_CALL_MAX = 28;
  const AFTER_HOURS_MAX = 16;
  const SPEED_UNDER_5 = 0;
  const SPEED_UNDER_HOUR = 6;
  const SPEED_SAME_DAY = 12;
  const SPEED_NEXT_DAY = 18;
  const FOLLOW_AUTO = 0;
  const FOLLOW_MANUAL = 8;
  const FOLLOW_NONE = 14;
  const REVIEW_AUTO = 0;
  const REVIEW_MANUAL = 4;
  const REVIEW_NONE = 8;
  const NO_SHOW_MAX = 10;
  const PHONE_OFFICE = 0;
  const PHONE_OWNER = 4;
  const PHONE_VOICEMAIL = 8;
  const PHONE_NONE = 10;
  const SPEED_DOLLAR = { "under 5 min": 0, "under 1 hour": 0.05, "same day": 0.12, "next day+": 0.22 };
  const FOLLOW_DOLLAR = { automated: 0, manual: 0.1, none: 0.25 };
  const REVIEW_DOLLAR = { automated: 0, manual: 0.02, none: 0.06 };
  const PHONE_DOLLAR = { "office staff": 0, owner: 0.08, voicemail: 0.15, "no one consistent": 0.2 };
  const TRADE_JOB_DEFAULTS = { HVAC: 700, Dental: 3247 };
  const MAIL_TO = "dre@arkansasautomated.com";

  const quiz = document.querySelector("#rls-quiz");
  const tradeSelect = document.querySelector("#rls-trade");
  const jobInput = document.querySelector("#rls-job");
  const estimateLabel = document.querySelector("[data-rls-estimate]");
  const results = document.querySelector("[data-rls-results]");
  const missingWrap = document.querySelector("[data-rls-missing]");
  const missingList = document.querySelector("[data-rls-missing-list]");
  const computed = document.querySelector("[data-rls-computed]");
  const scoreEl = document.querySelector("[data-rls-score]");
  const bandEl = document.querySelector("[data-rls-band]");
  const dollarsEl = document.querySelector("[data-rls-dollars]");
  const leaksEl = document.querySelector("[data-rls-leaks]");
  const bridgeEl = document.querySelector("[data-rls-bridge]");
  const leadForm = document.querySelector("[data-rls-lead]");
  let snapshot = null;
  let appliedDefault = "";

  function money(value) {
    return new Intl.NumberFormat("en-US", { style: "currency", currency: "USD", maximumFractionDigits: 0 }).format(value);
  }

  function field(name) {
    return quiz?.elements.namedItem(name);
  }

  function readRaw(name) {
    const el = field(name);
    return el && "value" in el ? String(el.value).trim() : "";
  }

  function readNumber(name) {
    const raw = readRaw(name);
    if (raw === "") return { raw, empty: true, value: NaN };
    const value = Number(raw);
    return { raw, empty: false, value };
  }

  function syncJobDefault() {
    const trade = tradeSelect?.value ?? "";
    const preset = TRADE_JOB_DEFAULTS[trade];
    if (!jobInput || !estimateLabel) return;
    if (preset) {
      jobInput.value = String(preset);
      appliedDefault = trade;
      estimateLabel.hidden = false;
      return;
    }
    if (appliedDefault) {
      jobInput.value = "";
      appliedDefault = "";
    }
    estimateLabel.hidden = true;
  }

  tradeSelect?.addEventListener("change", syncJobDefault);
  jobInput?.addEventListener("input", () => {
    const preset = TRADE_JOB_DEFAULTS[tradeSelect?.value ?? ""];
    const matches = Boolean(preset && Number(jobInput.value) === preset);
    if (estimateLabel) estimateLabel.hidden = !matches;
    if (!matches) appliedDefault = "";
  });

  function bandName(score) {
    if (score >= BAND_TIGHT_MIN) return "Tight";
    if (score >= BAND_LEAKING_MIN) return "Leaking";
    return "Open";
  }

  function leakSection(item) {
    const section = document.createElement("section");
    section.className = "rls-leak";
    const title = document.createElement("h3");
    title.textContent = item.title;
    const cost = document.createElement("p");
    cost.textContent = `What it costs, from your numbers: ${money(item.dollars)} a year.`;
    const why = document.createElement("p");
    why.textContent = item.why;
    const fix = document.createElement("p");
    fix.textContent = `Fix category: ${item.fix}`;
    section.append(title, cost, why, fix);
    return section;
  }

  function showMissing(items) {
    snapshot = null;
    if (missingList) {
      missingList.replaceChildren(...items.map((text) => {
        const li = document.createElement("li");
        li.textContent = text;
        return li;
      }));
    }
    if (missingWrap) missingWrap.hidden = false;
    if (computed) computed.hidden = true;
    if (leaksEl) leaksEl.replaceChildren();
    if (results) {
      results.hidden = false;
      results.focus();
    }
  }

  quiz?.addEventListener("submit", (event) => {
    event.preventDefault();
    const missing = [];
    const trade = readRaw("trade");
    const calls = readNumber("callsPerDay");
    const missed = readNumber("missedPercent");
    const afterHours = readNumber("afterHoursPercent");
    const job = readNumber("jobValue");
    const closeRate = readNumber("closeRatePercent");
    const speed = readRaw("speedToLead");
    const noShow = readNumber("noShowPercent");
    const followUp = readRaw("followUp");
    const reviewRequest = readRaw("reviewRequest");
    const units = readNumber("units");
    const spend = readNumber("monthlySpend");
    const whoAnswers = readRaw("whoAnswers");

    if (!trade) missing.push("Trade is not selected.");
    if (calls.empty || calls.value === 0) missing.push("Inbound calls per day is empty or 0, so a dollar figure would be made up.");
    else if (!Number.isFinite(calls.value) || calls.value < 0) missing.push("Inbound calls per day needs a number above 0.");
    if (missed.empty) missing.push("Percent of calls missed is empty.");
    else if (!Number.isFinite(missed.value) || missed.value < 0 || missed.value > 100) missing.push("Percent of calls missed has to be from 0 to 100.");
    if (afterHours.empty) missing.push("Percent of calls arriving after hours is empty.");
    else if (!Number.isFinite(afterHours.value) || afterHours.value < 0 || afterHours.value > 100) missing.push("Percent of calls arriving after hours has to be from 0 to 100.");
    if (job.empty || job.value === 0) missing.push("Average job value is empty or 0, so a dollar figure would be made up.");
    else if (!Number.isFinite(job.value) || job.value < 0) missing.push("Average job value needs a number above 0.");
    if (closeRate.empty) missing.push("Close rate is empty.");
    else if (!Number.isFinite(closeRate.value) || closeRate.value < 0 || closeRate.value > 100) missing.push("Close rate has to be from 0 to 100.");
    if (!speed) missing.push("Response time to web/form leads is not selected.");
    if (noShow.empty) missing.push("No-show rate is empty.");
    else if (!Number.isFinite(noShow.value) || noShow.value < 0 || noShow.value > 100) missing.push("No-show rate has to be from 0 to 100.");
    if (!followUp) missing.push("Follow-up process for unsold estimates is not selected.");
    if (!reviewRequest) missing.push("Review-request process is not selected.");
    if (units.empty || units.value === 0) missing.push("Number of trucks, chairs, or locations is empty or 0.");
    else if (!Number.isFinite(units.value) || units.value < 0) missing.push("Number of trucks, chairs, or locations needs a number above 0.");
    if (spend.empty) missing.push("Current monthly spend on answering/front desk is empty.");
    else if (!Number.isFinite(spend.value) || spend.value < 0) missing.push("Current monthly spend on answering/front desk needs a number, or 0 if you spend nothing.");
    if (!whoAnswers) missing.push("Who answers the phone when you're on a job is not selected.");
    if (missing.length) {
      showMissing(missing);
      return;
    }

    const missedRate = missed.value / 100;
    const afterRate = afterHours.value / 100;
    const close = closeRate.value / 100;
    const noShowRate = noShow.value / 100;
    const uncovered = whoAnswers !== "office staff";
    const answeredBooked = calls.value * (1 - missedRate) * close * job.value * 12;
    const unsold = calls.value * (1 - missedRate) * (1 - close) * job.value * 12;
    const callBase = calls.value * close * job.value * 12;
    const annualLeak = calls.value * missedRate * close * job.value * 12;

    const speedPoints = { "under 5 min": SPEED_UNDER_5, "under 1 hour": SPEED_UNDER_HOUR, "same day": SPEED_SAME_DAY, "next day+": SPEED_NEXT_DAY }[speed] ?? SPEED_NEXT_DAY;
    const followPoints = { automated: FOLLOW_AUTO, manual: FOLLOW_MANUAL, none: FOLLOW_NONE }[followUp] ?? FOLLOW_NONE;
    const reviewPoints = { automated: REVIEW_AUTO, manual: REVIEW_MANUAL, none: REVIEW_NONE }[reviewRequest] ?? REVIEW_NONE;
    const phonePoints = { "office staff": PHONE_OFFICE, owner: PHONE_OWNER, voicemail: PHONE_VOICEMAIL, "no one consistent": PHONE_NONE }[whoAnswers] ?? PHONE_NONE;
    const deductions = (missedRate * MISSED_CALL_MAX)
      + (uncovered ? afterRate * AFTER_HOURS_MAX : 0)
      + speedPoints
      + followPoints
      + reviewPoints
      + (noShowRate * NO_SHOW_MAX)
      + phonePoints;
    const score = Math.max(BAND_OPEN_MIN, Math.min(100, Math.round(100 - deductions)));

    const leaks = [
      {
        title: "Missed calls",
        dollars: annualLeak,
        why: "Calls that never reach a person do not get a chance to book. This line uses your missed share, close rate, and job value.",
        fix: "missed-call text-back",
      },
      {
        title: "After-hours calls with no coverage",
        dollars: uncovered ? calls.value * afterRate * close * job.value * 12 : 0,
        why: uncovered
          ? "Those calls arrive outside staffed hours, and the answer you selected is not office coverage."
          : "Office staff is the coverage you selected, so this line is not priced as an uncovered after-hours leak.",
        fix: "AI receptionist",
      },
      {
        title: "Slow response to web and form leads",
        dollars: callBase * (SPEED_DOLLAR[speed] ?? 0),
        why: "Web and form leads sit in the response bucket you selected. This dollar line is a ranking weight on your call volume and close rate, not a published study.",
        fix: "missed-call text-back",
      },
      {
        title: "No automated follow-up on unsold estimates",
        dollars: unsold * (FOLLOW_DOLLAR[followUp] ?? 0),
        why: followUp === "automated"
          ? "You marked follow-up as automated, so this line is not priced as an open leak."
          : "Unsold estimates have no automated next step, so they depend on someone remembering.",
        fix: "missed-call text-back",
      },
      {
        title: "No automated review requests",
        dollars: answeredBooked * (REVIEW_DOLLAR[reviewRequest] ?? 0),
        why: reviewRequest === "automated"
          ? "You marked review requests as automated, so this line is not priced as an open leak."
          : "Review requests are not automated, so they depend on someone remembering after the job.",
        fix: "review engine",
      },
      {
        title: "No-shows",
        dollars: answeredBooked * noShowRate,
        why: "Booked jobs that do not show still consume the slot. This line uses your no-show percent on booked work from your numbers.",
        fix: "reminder automation",
      },
      {
        title: "Nobody owning the phone",
        dollars: callBase * (PHONE_DOLLAR[whoAnswers] ?? 0),
        why: whoAnswers === "office staff"
          ? "Office staff owns the phone in your answer, so this line is not priced as an open leak."
          : "The person on the job is also the person expected to answer, or nobody consistent is.",
        fix: "AI receptionist",
      },
    ].filter((item) => item.dollars > 0).sort((a, b) => b.dollars - a.dollars).slice(0, 3);

    const answers = {
      trade,
      callsPerDay: calls.raw,
      missedPercent: missed.raw,
      afterHoursPercent: afterHours.raw,
      jobValue: job.raw,
      closeRatePercent: closeRate.raw,
      speedToLead: speed,
      noShowPercent: noShow.raw,
      followUp,
      reviewRequest,
      units: units.raw,
      monthlySpend: spend.raw,
      whoAnswers,
    };
    snapshot = { trade, score, leakEstimate: Math.round(annualLeak), answers, topFix: leaks[0]?.fix ?? "" };

    if (scoreEl) scoreEl.textContent = `Leak Score ${score} of 100.`;
    if (bandEl) bandEl.textContent = `${bandName(score)}. 100 means no visible leak on these questions.`;
    if (dollarsEl) dollarsEl.textContent = `${money(snapshot.leakEstimate)} a year from missed calls on the formula (calls/day x missed percent x close rate x average job value) x 12.`;
    if (leaksEl) {
      leaksEl.replaceChildren(...leaks.map(leakSection));
      if (!leaks.length) {
        const note = document.createElement("p");
        note.textContent = "None of these inputs priced a leak above zero, so there is no top-three dollar ranking to show.";
        leaksEl.append(note);
      }
    }
    if (bridgeEl) {
      const top = leaks[0] ? ` The top leak on these numbers is ${leaks[0].title.toLowerCase()}, and the fix category is ${leaks[0].fix}.` : "";
      bridgeEl.textContent = `Your scorecard shows ~${money(snapshot.leakEstimate)}/yr leaking.${top} The fix for your top leak is a done-for-you system we install in 7 days. It is $497 one-time.`;
    }
    if (missingWrap) missingWrap.hidden = true;
    if (computed) computed.hidden = false;
    if (results) {
      results.hidden = false;
      results.focus();
    }
  });

  function showLeadStatus(kind, text, mailtoHref) {
    const status = leadForm?.querySelector("[data-rls-status]");
    if (!status) return;
    status.hidden = false;
    status.dataset.kind = kind;
    status.setAttribute("role", kind === "error" ? "alert" : "status");
    status.replaceChildren();
    const note = document.createElement("p");
    note.textContent = text;
    status.append(note);
    if (mailtoHref) {
      const link = document.createElement("a");
      link.href = mailtoHref;
      link.textContent = "Email this score instead";
      status.append(link);
    }
  }

  function mailtoFallback(email) {
    const body = [
      `Email: ${email}`,
      `Trade: ${snapshot?.trade ?? ""}`,
      `Score: ${snapshot?.score ?? ""}`,
      `Leak estimate: ${snapshot?.leakEstimate ?? ""}`,
      `Answers: ${JSON.stringify(snapshot?.answers ?? {})}`,
    ].join("\n");
    return `mailto:${MAIL_TO}?subject=${encodeURIComponent("Revenue Leak Scorecard")}&body=${encodeURIComponent(body)}`;
  }

  leadForm?.addEventListener("submit", async (event) => {
    event.preventDefault();
    const status = leadForm.querySelector("[data-rls-status]");
    const submit = leadForm.querySelector("button[type=submit]");
    const email = String(leadForm.elements.namedItem("email")?.value ?? "").trim();
    if (!snapshot) {
      showLeadStatus("error", "Score the quiz before sending. An empty result is not a lead.");
      return;
    }
    if (!email || !email.includes("@")) {
      showLeadStatus("error", "An email is required before this can be sent.");
      return;
    }
    const payload = {
      email,
      source: "revenue-leak-scorecard",
      trade: snapshot.trade,
      score: snapshot.score,
      "leak estimate": snapshot.leakEstimate,
      answers: snapshot.answers,
    };
    const mail = mailtoFallback(email);
    if (!HUB_LEADS_URL) {
      showLeadStatus("error", "The lead form is not configured on this build. Email the score instead so it is not lost.", mail);
      return;
    }
    if (submit) {
      submit.disabled = true;
      submit.textContent = "Sending";
    }
    try {
      const response = await fetch(HUB_LEADS_URL, {
        method: "POST",
        headers: { "Content-Type": "text/plain" },
        body: JSON.stringify(payload),
      });
      if (!response.ok) throw new Error("lead endpoint rejected request");
      if (status) {
        status.hidden = false;
        status.dataset.kind = "ok";
        status.setAttribute("role", "status");
        status.textContent = "Saved. We have the score and the answers you entered.";
      }
      if (submit) submit.textContent = "Scorecard saved";
    } catch {
      showLeadStatus("error", "That did not go through, and we do not want to lose the score. Email it instead.", mail);
      if (submit) {
        submit.disabled = false;
        submit.textContent = "Send the scorecard";
      }
    }
  });
</script>

