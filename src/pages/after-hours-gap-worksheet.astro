---
/*
 * /after-hours-gap-worksheet: 5 inputs, annual after-hours gap.
 * Trade job defaults are industry estimates, not facts. No phone number in this file.
 */
import Base from "../layouts/Base.astro";
import SiteNav from "../components/SiteNav.astro";
import SiteFooter from "../components/SiteFooter.astro";

const title = "After-Hours Gap Worksheet — How Much Revenue Do You Lose When You're Closed?";
const description =
  "The After-Hours Gap Worksheet turns five answers into the revenue that arrives while you are closed.";

const site = "https://arkansasautomated.com";
const path = "/after-hours-gap-worksheet";
const pageUrl = `${site}${path}`;
const schema = {
  "@context": "https://schema.org",
  "@type": "WebPage",
  name: "The After-Hours Gap Worksheet",
  description,
  url: pageUrl,
  datePublished: "2026-09-27",
  mainEntityOfPage: pageUrl,
};
---

<Base title={title} description={description} path={path} schema={schema}>
  <SiteNav />
  <main id="main-content" tabindex="-1" class="ahg-page">
    <section class="ahg-hero">
      <div class="container">
        <p class="eyebrow">After-hours worksheet</p>
        <h1>The After-Hours Gap Worksheet</h1>
        <p class="ahg-promise">
          Your business is open roughly 50 hours a week, but customers call all 168. Answer 5 questions and see the revenue that arrives while nobody is there.
        </p>
      </div>
    </section>

    <section class="section">
      <div class="container">
        <form class="ahg-shell" id="ahg-calc" novalidate>
          <label class="ahg-trade">
            Trade
            <select name="trade" id="ahg-trade">
              <option value="">Select a trade</option>
              <option>HVAC</option>
              <option>Plumbing</option>
              <option>Electrical</option>
              <option>Roofing</option>
              <option>Dental</option>
              <option>Med spa</option>
              <option>Other</option>
            </select>
          </label>
          <p class="ahg-quiet">The trade only fills the job value. It does not run the math.</p>

          <div class="ahg-inputs">
            <fieldset>
              <legend>Hours open per week</legend>
              <label>
                Hours open per week
                <input class="ahg-in" name="hoursOpenPerWeek" id="ahg-open" type="number" min="0" step="any" inputmode="decimal" value="50" />
              </label>
            </fieldset>
            <fieldset>
              <legend>Calls per week</legend>
              <label>
                Calls per week
                <input class="ahg-in" name="callsPerWeek" type="number" min="0" step="any" inputmode="decimal" placeholder="calls in a typical week" />
              </label>
            </fieldset>
            <fieldset>
              <legend>Percent of calls arriving after hours</legend>
              <label>
                Percent of calls arriving after hours
                <input class="ahg-in" name="afterHoursPercent" id="ahg-after" type="number" min="0" max="100" step="any" inputmode="decimal" value="28.5" />
              </label>
              <p class="ahg-estimate" data-ahg-after-estimate>industry estimate</p>
              <p class="ahg-quiet">
                <span data-ahg-cite-pct>The prefilled percent</span> of calls to small businesses arrive after hours (NextPhone analysis of 1,446,980 calls, retrieved 2026-09-22).
              </p>
            </fieldset>
            <fieldset>
              <legend>Average job value in dollars</legend>
              <label>
                Average job value in dollars
                <input class="ahg-in" name="jobValue" id="ahg-job" type="number" min="0" step="any" inputmode="decimal" placeholder="enter your average job value" />
              </label>
              <p class="ahg-estimate" data-ahg-job-estimate hidden>industry estimate</p>
            </fieldset>
            <fieldset>
              <legend>Close rate on after-hours calls, percent</legend>
              <label>
                Close rate on after-hours calls, percent
                <input class="ahg-in" name="closeRatePercent" type="number" min="0" max="100" step="any" inputmode="decimal" placeholder="your close rate on answered calls" />
              </label>
            </fieldset>
          </div>
        </form>

        <section class="ahg-results" data-ahg-results aria-live="polite">
          <h2>After-hours revenue gap</h2>
          <p data-ahg-uncovered></p>
          <p data-ahg-calls></p>
          <p data-ahg-gap></p>
          <p>This is an estimate, not a quote.</p>
          <p class="ahg-quiet" data-ahg-waiting>The gap stays at $0 until every worksheet field has a valid number.</p>
        </section>

        <form class="ahg-capture" data-ahg-lead novalidate>
          <h3>Full 1-page report</h3>
          <p>
            The report is the gap number, the uncovered hours math, where those calls go instead, and the 90-second fix overview. It renders on this page after you submit. This form does not send the report by email.
          </p>
          <label>
            Email
            <input name="email" type="email" autocomplete="email" required />
          </label>
          <button class="btn btn-primary" type="submit">Show the report</button>
          <p class="ahg-status" data-ahg-status hidden role="status"></p>
          <p class="ahg-legal">By submitting, you agree that Arkansas Automated may contact you about this worksheet. See our <a href="/privacy">privacy page</a>.</p>
        </form>

        <section class="ahg-report" data-ahg-report hidden tabindex="-1">
          <h2>Your 1-page report</h2>
          <p data-ahg-report-gap></p>
          <p>This is an estimate, not a quote.</p>
          <h3>Uncovered hours</h3>
          <p data-ahg-report-hours></p>
          <p data-ahg-report-calls></p>
          <p>Uncovered hours per week is 168 minus hours open, and never below 0. That count is not multiplied into the gap. The gap uses calls per week, the after-hours percent, the close rate, and the job value, times 52.</p>
          <h3>Where those calls go instead</h3>
          <p>
            An after-hours call does not wait until you open. It goes to voicemail, to the next shop that picks up, or it ends. This page does not split that into shares. It prices the after-hours share you entered, at the close rate and job value you entered.
          </p>
          <h3>The 90-second fix overview</h3>
          <p>
            The gap in this number is calls that arrive while you are closed. The fix runs when you are closed: a done-for-you AI receptionist, installed in 7 days. It is $497 one-time. That price is the install. It is not a claim that this worksheet number returns.
          </p>
          <p><a class="text-link" href="/marketing/">See your install options</a></p>
          <p>Want the full picture (missed calls, follow-up, no-shows)? Take the 12-question <a class="text-link" href="/revenue-leak-scorecard/">Revenue Leak Scorecard</a>.</p>
          <p>Just the missed-call number? Use the <a class="text-link" href="/missed-call-cost-calculator/">60-second calculator</a>.</p>
        </section>
      </div>
    </section>
  </main>
  <SiteFooter />
</Base>

<script>
  import { HUB_LEADS_URL } from "../lib/hub";

  /*
   * Uncovered hours per week = max(0, 168 - hours open).
   * After-hours calls per week = calls/week x after-hours percent / 100.
   * Estimated annual after-hours revenue gap =
   * calls/week x after% / 100 x close% / 100 x avg job value x 52.
   * The gap is 0 when any input is empty or invalid.
   * Displayed dollars are that product, rounded to the nearest dollar.
   *
   * Trade job defaults (industry estimates, editable, not facts):
   * HVAC 700. Dental 3247. Every other trade stays empty.
   * The after-hours percent default is the input's own value attribute.
   */
  const TRADE_JOB_DEFAULTS = {
    HVAC: 700,
    Dental: 3247,
  };
  const MAIL_TO = "dre@arkansasautomated.com";
  const HOURS_IN_WEEK = 168;

  const calc = document.querySelector("#ahg-calc");
  const tradeSelect = document.querySelector("#ahg-trade");
  const afterInput = document.querySelector("#ahg-after");
  const jobInput = document.querySelector("#ahg-job");
  const afterEstimate = document.querySelector("[data-ahg-after-estimate]");
  const jobEstimate = document.querySelector("[data-ahg-job-estimate]");
  const citePct = document.querySelector("[data-ahg-cite-pct]");
  const uncoveredEl = document.querySelector("[data-ahg-uncovered]");
  const callsEl = document.querySelector("[data-ahg-calls]");
  const gapEl = document.querySelector("[data-ahg-gap]");
  const waitingEl = document.querySelector("[data-ahg-waiting]");
  const leadForm = document.querySelector("[data-ahg-lead]");
  const report = document.querySelector("[data-ahg-report]");
  const reportGap = document.querySelector("[data-ahg-report-gap]");
  const reportHours = document.querySelector("[data-ahg-report-hours]");
  const reportCalls = document.querySelector("[data-ahg-report-calls]");

  let snapshot = null;
  let appliedDefault = "";
  let sending = false;

  if (citePct && afterInput) citePct.textContent = `${afterInput.defaultValue}%`;

  function money(value) {
    return new Intl.NumberFormat("en-US", { style: "currency", currency: "USD", maximumFractionDigits: 0 }).format(value);
  }

  function plain(value) {
    return new Intl.NumberFormat("en-US", { maximumFractionDigits: 2 }).format(value);
  }

  function field(name) {
    return calc?.elements.namedItem(name);
  }

  function readRaw(name) {
    const el = field(name);
    return el && "value" in el ? String(el.value).trim() : "";
  }

  function parseBounded(raw, max) {
    if (raw === "") return null;
    const value = Number(raw);
    if (!Number.isFinite(value) || value < 0) return null;
    if (max != null && value > max) return null;
    return value;
  }

  function syncAfterLabel() {
    if (!afterInput || !afterEstimate) return;
    const matches = afterInput.value.trim() !== "" && Number(afterInput.value) === Number(afterInput.defaultValue);
    afterEstimate.hidden = !matches;
  }

  function syncJobDefault() {
    const trade = tradeSelect?.value ?? "";
    const preset = TRADE_JOB_DEFAULTS[trade];
    if (!jobInput || !jobEstimate) return;
    if (preset) {
      jobInput.value = String(preset);
      appliedDefault = trade;
      jobEstimate.hidden = false;
      return;
    }
    if (appliedDefault) {
      jobInput.value = "";
      appliedDefault = "";
    }
    jobEstimate.hidden = true;
  }

  function hideJobEstimateIfEdited() {
    const preset = TRADE_JOB_DEFAULTS[tradeSelect?.value ?? ""];
    const matches = Boolean(preset && Number(jobInput?.value) === preset);
    if (jobEstimate) jobEstimate.hidden = !matches;
    if (!matches) appliedDefault = "";
  }

  function resetSubmit() {
    const submit = leadForm?.querySelector("button[type=submit]");
    if (!submit || sending) return;
    submit.disabled = false;
    submit.textContent = "Show the report";
  }

  function render() {
    const openRaw = readRaw("hoursOpenPerWeek");
    const callsRaw = readRaw("callsPerWeek");
    const afterRaw = readRaw("afterHoursPercent");
    const jobRaw = readRaw("jobValue");
    const closeRaw = readRaw("closeRatePercent");

    const open = parseBounded(openRaw);
    const calls = parseBounded(callsRaw);
    const after = parseBounded(afterRaw, 100);
    const job = parseBounded(jobRaw);
    const close = parseBounded(closeRaw, 100);
    const complete = open != null && calls != null && after != null && job != null && close != null;
    const uncovered = open == null ? null : Math.max(0, HOURS_IN_WEEK - open);
    const afterCalls = calls == null || after == null ? null : calls * (after / 100);
    const annual = complete ? calls * (after / 100) * (close / 100) * job * 52 : 0;
    const rounded = Math.round(annual);

    const hoursLine = uncovered == null
      ? "Uncovered hours per week: 0."
      : `A week has ${HOURS_IN_WEEK} hours; open ${plain(open)} means ${plain(uncovered)} hours uncovered.`;
    const callsLine = `After-hours calls per week: ${plain(afterCalls ?? 0)}.`;
    const gapLine = `Estimated annual after-hours revenue gap: ${money(rounded)}.`;

    snapshot = complete
      ? {
          complete: true,
          trade: readRaw("trade"),
          hoursOpenPerWeek: openRaw,
          callsPerWeek: callsRaw,
          afterHoursPercent: afterRaw,
          jobValue: jobRaw,
          closeRatePercent: closeRaw,
          uncoveredHours: uncovered,
          afterHoursCalls: afterCalls,
          result: rounded,
          hoursLine,
          callsLine,
          gapLine,
        }
      : null;

    if (uncoveredEl) uncoveredEl.textContent = hoursLine;
    if (callsEl) callsEl.textContent = callsLine;
    if (gapEl) gapEl.textContent = gapLine;
    if (waitingEl) waitingEl.hidden = complete;
    if (report) report.hidden = true;
    if (reportGap) reportGap.textContent = gapLine;
    if (reportHours) reportHours.textContent = hoursLine;
    if (reportCalls) reportCalls.textContent = callsLine;
    resetSubmit();
  }

  tradeSelect?.addEventListener("change", () => {
    syncJobDefault();
    render();
  });
  afterInput?.addEventListener("input", () => {
    syncAfterLabel();
    render();
  });
  jobInput?.addEventListener("input", () => {
    hideJobEstimateIfEdited();
    render();
  });
  calc?.querySelectorAll(".ahg-in").forEach((input) => {
    if (input === afterInput || input === jobInput) return;
    input.addEventListener("input", render);
  });
  calc?.addEventListener("submit", (event) => {
    event.preventDefault();
    render();
  });

  function showLeadStatus(kind, text, mailtoHref) {
    const status = leadForm?.querySelector("[data-ahg-status]");
    if (!status) return;
    status.hidden = false;
    status.dataset.kind = kind;
    status.setAttribute("role", kind === "error" ? "alert" : "status");
    status.replaceChildren();
    const note = document.createElement("p");
    note.textContent = text;
    status.append(note);
    if (mailtoHref) {
      const link = document.createElement("a");
      link.href = mailtoHref;
      link.textContent = "Email this result instead";
      status.append(link);
    }
  }

  function mailtoFallback(email, record) {
    const body = [
      `Email: ${email}`,
      `Trade: ${record?.trade ?? ""}`,
      `Hours open per week: ${record?.hoursOpenPerWeek ?? ""}`,
      `Calls per week: ${record?.callsPerWeek ?? ""}`,
      `Percent of calls arriving after hours: ${record?.afterHoursPercent ?? ""}`,
      `Average job value: ${record?.jobValue ?? ""}`,
      `Close rate on after-hours calls, percent: ${record?.closeRatePercent ?? ""}`,
      `Uncovered hours: ${record?.uncoveredHours ?? ""}`,
      `After-hours calls per week: ${record?.afterHoursCalls ?? ""}`,
      `Result: ${record?.result ?? ""}`,
    ].join("\n");
    return `mailto:${MAIL_TO}?subject=${encodeURIComponent("After-Hours Gap Worksheet")}&body=${encodeURIComponent(body)}`;
  }

  leadForm?.addEventListener("submit", async (event) => {
    event.preventDefault();
    const status = leadForm.querySelector("[data-ahg-status]");
    const submit = leadForm.querySelector("button[type=submit]");
    const email = String(leadForm.elements.namedItem("email")?.value ?? "").trim();
    if (!snapshot?.complete) {
      showLeadStatus("error", "Fill the worksheet before sending. An empty result is not a lead.");
      return;
    }
    const submitted = snapshot;
    if (!email || !email.includes("@")) {
      showLeadStatus("error", "An email is required before this can be sent.");
      return;
    }
    const payload = {
      email,
      source: "after-hours-gap-worksheet",
      trade: submitted.trade,
      hoursOpenPerWeek: submitted.hoursOpenPerWeek,
      callsPerWeek: submitted.callsPerWeek,
      afterHoursPercent: submitted.afterHoursPercent,
      jobValue: submitted.jobValue,
      closeRatePercent: submitted.closeRatePercent,
      uncoveredHours: submitted.uncoveredHours,
      afterHoursCalls: submitted.afterHoursCalls,
      result: submitted.result,
    };
    const mail = mailtoFallback(email, submitted);
    if (!HUB_LEADS_URL) {
      showLeadStatus("error", "The lead form is not configured on this build. Email the result instead so it is not lost.", mail);
      return;
    }
    if (submit) {
      submit.disabled = true;
      submit.textContent = "Sending";
    }
    sending = true;
    try {
      const response = await fetch(HUB_LEADS_URL, {
        method: "POST",
        headers: { "Content-Type": "text/plain" },
        body: JSON.stringify(payload),
      });
      if (!response.ok) throw new Error("lead endpoint rejected request");
      if (status) {
        status.hidden = false;
        status.dataset.kind = "ok";
        status.setAttribute("role", "status");
        status.textContent = "Saved. The report is on this page.";
      }
      if (submit) submit.textContent = "Report saved";
      if (reportGap) reportGap.textContent = submitted.gapLine;
      if (reportHours) reportHours.textContent = submitted.hoursLine;
      if (reportCalls) reportCalls.textContent = submitted.callsLine;
      if (report) {
        report.hidden = false;
        report.focus();
      }
    } catch {
      showLeadStatus("error", "That did not go through, and we do not want to lose the result. Email it instead.", mail);
      if (submit) {
        submit.disabled = false;
        submit.textContent = "Show the report";
      }
    } finally {
      sending = false;
    }
  });

  render();
</script>

<style>
  .ahg-page { background: var(--bg-primary); }
  .ahg-hero { padding: clamp(4rem, 8vw, 7rem) 0 2.5rem; border-bottom: 1px solid var(--line); }
  .ahg-hero h1 { max-width: 18ch; margin: .4rem 0 1rem; }
  .ahg-promise { max-width: 42rem; font-size: 1.15rem; line-height: 1.5; }
  .ahg-quiet { color: var(--text-muted); max-width: 40rem; margin-top: .75rem; }
  .ahg-shell, .ahg-results, .ahg-capture, .ahg-report { max-width: 820px; margin: 2rem auto 0; }
  .ahg-trade, .ahg-inputs label, .ahg-capture label { display: grid; gap: .4rem; color: var(--text-secondary); font-size: .9rem; }
  .ahg-inputs { display: grid; gap: 1rem; margin: 1.5rem 0; }
  .ahg-page fieldset { border: 1px solid var(--line); border-radius: var(--radius-md); background: var(--bg-secondary); padding: 1rem 1.1rem 1.15rem; }
  .ahg-page legend { font-family: var(--font-heading); font-weight: 700; padding: 0 .25rem; }
  .ahg-page input, .ahg-page select { width: 100%; border: 1px solid var(--line); border-radius: var(--radius-sm); background: var(--bg-primary); color: var(--text-primary); padding: .85rem 1rem; font: inherit; }
  .ahg-page input:focus, .ahg-page select:focus { border-color: var(--accent); outline: 2px solid var(--accent); outline-offset: 1px; }
  .ahg-estimate { margin: .55rem 0 0; color: var(--text-muted); font-size: .8rem; letter-spacing: .04em; text-transform: lowercase; }
  .ahg-results, .ahg-report { border-top: 1px solid var(--line); padding-top: 2rem; }
  .ahg-report:focus { outline: none; }
  .ahg-results p, .ahg-report p { color: var(--text-secondary); margin-top: .45rem; }
  .ahg-capture { margin-top: 1.5rem; padding: 1.2rem; border: 1px solid var(--line); border-left: 2px solid var(--accent); border-radius: var(--radius-md); background: var(--bg-primary); }
  .ahg-capture h3, .ahg-report h3 { margin-bottom: .75rem; }
  .ahg-status { margin-top: .8rem; }
  .ahg-status[data-kind="error"] { color: #8b3d2a; }
  .ahg-status a { display: inline-block; margin-top: .35rem; text-decoration: underline; }
  .ahg-legal { color: var(--text-muted); font-size: .76rem; margin-top: .7rem; }
  .ahg-page .btn { margin-top: .5rem; }
</style>
