---
import Base from "../layouts/Base.astro";
import SiteNav from "../components/SiteNav.astro";
import SiteFooter from "../components/SiteFooter.astro";

const title = "About Arkansas Automated | Practical AI for Arkansas Businesses";
const description = "Arkansas Automated helps local service-business owners build or implement practical AI front desks and workflow automation.";
---

<Base title={title} description={description} path="/about">
  <SiteNav />
  <main id="main-content" tabindex="-1">
    <section class="section">
      <div class="container article-body">
        <nav class="crumbs" aria-label="Breadcrumb"><a href="/">Home</a><span>/</span><span>About</span></nav>
        <h1 class="heading-lg">Automation built by Arkansas operators.</h1>
        <p class="body-lg">Arkansas Automated helps service-business owners answer calls, follow up with leads, and move information between the tools they already use.</p>
        <h2 class="heading-md">Two ways to work with us</h2>
        <p>Owners can build and test an AI front desk in a live workshop, or ask us to assess, implement, and manage the workflow. The workshop is for owners who want control and understanding. The managed path is for owners who want the outcome without becoming the system administrator.</p>
        <h2 class="heading-md">We operate what we recommend</h2>
        <p>Our related properties include <a class="text-link" href="https://fortsmithdirectory.com">Fort Smith Directory</a>, <a class="text-link" href="https://nwaautomated.com">NWA Automated</a>, <a class="text-link" href="https://smarthomenwa.com">Smart Home NWA</a>, and <a class="text-link" href="https://goodgarageco.com">Good Garage Co.</a>. These businesses give us first-hand experience with local intake, routing, follow-up, and field-service operations.</p>
        <h2 class="heading-md">Where automation stops</h2>
        <p>Judgment, negotiation, pricing exceptions, and trust-building conversations stay with people. Read our <a class="text-link" href="/automation-guardrails">automation guardrails</a> for the operating principles we use.</p>
        <h2 class="heading-md">About the name</h2>
        <p>Arkansas Automated is operated by Brassfield Ventures LLC, based in Fort Smith, Arkansas. We are an AI and automation services company. We are not affiliated with Arkansas Automated Security, LLC of Mayflower, Arkansas, which is a separate security and alarm installation business.</p>
        <div class="next-step"><a class="btn btn-primary" href="/services/visibility-install">Visibility Install</a></div>
      </div>
    </section>
  </main>
  <SiteFooter />
</Base>
