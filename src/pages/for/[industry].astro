---
/*
 * /for/[industry] — Personas playbook (programmatic-seo skill). Trade-specific
 * leaks, automate-first items, and FAQs from src/data/industries.ts, with
 * Service + FAQPage + BreadcrumbList schema.
 *
 * GEO prompt-matching pass (teardown fix #4): the title keeps the indexed head
 * phrase "AI for {Trade} in Arkansas" verbatim as the prefix, then carries the
 * question an owner actually types into an assistant. The H1 is the same
 * question, and the `automate` section below it is the answer.
 */
import Base from "../../layouts/Base.astro";
import SiteNav from "../../components/SiteNav.astro";
import SiteFooter from "../../components/SiteFooter.astro";
import BookCall from "../../components/BookCall.astro";
import { industries, industryBySlug } from "../../data/industries";

export function getStaticPaths() {
  return industries.map((i) => ({ params: { industry: i.slug } }));
}

const { industry: slug } = Astro.params;
const ind = industryBySlug(slug);
const display = ind.name.charAt(0).toUpperCase() + ind.name.slice(1);
const seoName =
  ({ landscapers: "Landscapers", "medical-clinics": "Medical Clinics" } as Record<string, string>)[ind.slug] ?? display;

const title = `AI for ${seoName} in Arkansas: what should you automate first?`;
const description = `${ind.intent}. Front Door sites and done-for-you automation for Arkansas ${ind.name.toLowerCase()}.`;

const sharedFaqs = [
  {
    q: "Do you run public workshops, or is this done for you?",
    a: "Done for you. Public workshop seats are not for sale. The front door is the $999 operations audit: a written map of the leaks, ranked by payback, credited toward a build started within 60 days. A Front Door site is $497 if the storefront is the first leak.",
  },
  {
    q: "Can you build and manage it for me?",
    a: "That is the done-for-you path. The audit prices it. If the map says it pays, we build, launch, and manage the system. Larger operations move to the embedded retainer, from $2,000 a month.",
  },
];

const faqs = [...ind.faqs, ...sharedFaqs];
const otherTrades = industries.filter((i) => i.slug !== ind.slug).slice(0, 5);

const site = "https://arkansasautomated.com";
const pageUrl = `${site}/for/${ind.slug}`;
const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Service",
      name: `AI automation for ${ind.name}`,
      provider: { "@type": "ProfessionalService", name: "Arkansas Automated", url: site },
      areaServed: { "@type": "State", name: "Arkansas" },
      description: ind.intent,
    },
    {
      "@type": "FAQPage",
      mainEntity: faqs.map((f) => ({
        "@type": "Question",
        name: f.q,
        acceptedAnswer: { "@type": "Answer", text: f.a },
      })),
    },
    {
      "@type": "BreadcrumbList",
      itemListElement: [
        { "@type": "ListItem", position: 1, name: "Home", item: `${site}/` },
        { "@type": "ListItem", position: 2, name: "Industries", item: `${site}/for` },
        { "@type": "ListItem", position: 3, name: display, item: pageUrl },
      ],
    },
  ],
};
---

<Base title={title} description={description} path={`/for/${ind.slug}`} schema={schema}>
  <SiteNav />
  <main id="main-content" tabindex="-1">
    <section class="hero">
      <div class="container">
        <nav class="crumbs" aria-label="Breadcrumb">
          <a href="/">Home</a><span>/</span><a href="/for">Industries</a><span>/</span>{display}
        </nav>
        <h1 class="heading-xl measure">What should {ind.name} in Arkansas automate first?</h1>
        <p class="body-lg measure" style="margin-top:1.15rem">{ind.angle}</p>
        <div class="hero-ctas" style="margin-top:2rem">
          <a class="btn btn-primary" href="/audit">Book the audit</a>
          <a class="btn btn-secondary" href="/services">See prices</a>
        </div>
      </div>
    </section>

    <section class="section section-tint">
      <div class="container">
        <h2 class="heading-lg measure">Where a {ind.singular} loses the week.</h2>
        <div class="leak-grid">
          {
            ind.leaks.map((l) => (
              <article class="leak">
                <h3>{l.h}</h3>
                <p>{l.p}</p>
              </article>
            ))
          }
        </div>
      </div>
    </section>

    <section class="section">
      <div class="container">
        <h2 class="heading-lg measure">What to automate first.</h2>
        <p class="body-lg measure" style="margin-top:1rem">
          In this order. Each one pays for the next, and none of them requires new staff.
        </p>
        <div class="rows">
          {
            ind.automate.map((a, idx) => (
              <article class="row">
                <div class="row-n">{String(idx + 1).padStart(2, "0")}</div>
                <h3>{a.h}</h3>
                <p>{a.p}</p>
              </article>
            ))
          }
        </div>
      </div>
    </section>

    <section class="section section-tint">
      <div class="container split">
        <div>
          <h2 class="heading-lg">Learn it, or hand it to us.</h2>
        </div>
        <div>
          <p class="body-lg">
            The front door is the $999 operations audit. It times the leaks on this page and ranks
            them by payback. Public workshop seats are not for sale. If the map says the storefront
            is first, Front Door is $497. If it says the phone is first, the AI front desk is
            $2,500 plus $497 a month. Workflow builds run $1,500 to $5,000 setup.
          </p>
          <p class="body-lg" style="margin-top:1.1rem">
            <a class="text-link" href="/audit">Book the audit</a>.
            {" "}<a class="text-link" href="/services">See full services and pricing</a>.
          </p>
        </div>
      </div>
    </section>

    {(ind.slug === "dentists" || ind.slug === "medical-clinics") && (
      <section class="section">
        <div class="container split">
          <div>
            <h2 class="heading-lg">What we will not touch from this page.</h2>
          </div>
          <div>
            <p class="body-lg">
              Scheduling intake is not a clinical record. Public marketing pages do not establish
              compliance. Before any patient data moves, the practice and its advisers approve the
              data, the vendors, the access, and the human review.
            </p>
            <p class="body-lg" style="margin-top:1.1rem">
              The audit can time verification, billing follow-up, and missed new-patient calls
              without taking a chart. Read the
              {" "}<a class="text-link" href="/automation-guardrails">automation guardrails</a>
              before you book if patient information is in play.
            </p>
          </div>
        </div>
      </section>
    )}

    <section class="section">
      <div class="container faq-wrap">
        <h2 class="heading-lg measure">Questions {ind.name} ask us.</h2>
        <div class="faq-list">
          {
            faqs.map((f) => (
              <details class="faq-item">
                <summary>{f.q}</summary>
                <p>{f.a}</p>
              </details>
            ))
          }
        </div>
      </div>
    </section>

    <section class="section section-tint">
      <div class="container">
        <h2 class="heading-md">We also build for</h2>
        <div class="link-chips">
          {otherTrades.map((i) => (
            <a class="chip" href={`/for/${i.slug}`}>{i.name.charAt(0).toUpperCase() + i.name.slice(1)}</a>
          ))}
          <a class="chip chip-strong" href="/for">All industries</a>
        </div>
      </div>
    </section>

    <section class="section" id="contact">
      <div class="container split">
        <div>
          <h2 class="heading-lg">Start with the free assessment.</h2>
          <p class="body-lg" style="margin-top:1rem">
            Fifteen minutes, your business details, and a straight answer on whether automation
            pays for itself in your operation. If it does not, we will tell you that too.
          </p>
          <p class="fine-print" style="margin-top:2rem">
            Last updated July 2026. Written by Andre Brassfield, founder of Arkansas Automated.
          </p>
        </div>
        <BookCall
          heading="Pick your own time"
          note={`Fifteen minutes on ${ind.name} operations: missed calls while on jobs, quote follow-up for your ${ind.singular}, and whether automation pays for itself. If it does not, we will say so.`}
        />
      </div>
    </section>
  </main>
  <SiteFooter />
</Base>
