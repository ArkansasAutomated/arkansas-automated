---
/*
 * /for — hub for the Personas cluster. Lists every industry page, links all
 * spokes, ItemList + BreadcrumbList schema.
 */
import Base from "../../layouts/Base.astro";
import SiteNav from "../../components/SiteNav.astro";
import SiteFooter from "../../components/SiteFooter.astro";
import { industries } from "../../data/industries";

const title = "AI Automation by Industry | Arkansas Automated";
const description =
  "AI answering, booking, and workflow automation built for how Arkansas trades and practices actually run: plumbers, HVAC, roofers, dentists, law firms, and more.";

const site = "https://arkansasautomated.com";
const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "ItemList",
      name: "Industries served by Arkansas Automated",
      itemListElement: industries.map((ind, idx) => ({
        "@type": "ListItem",
        position: idx + 1,
        name: `AI for ${ind.name}`,
        url: `${site}/for/${ind.slug}`,
      })),
    },
    {
      "@type": "BreadcrumbList",
      itemListElement: [
        { "@type": "ListItem", position: 1, name: "Home", item: `${site}/` },
        { "@type": "ListItem", position: 2, name: "Industries", item: `${site}/for` },
      ],
    },
  ],
};
---

<Base title={title} description={description} path="/for" schema={schema}>
  <SiteNav />
  <main>
    <section class="hero">
      <div class="container">
        <nav class="crumbs" aria-label="Breadcrumb">
          <a href="/">Home</a><span>/</span>Industries
        </nav>
        <h1 class="heading-xl measure">Built for how your trade actually runs.</h1>
        <p class="body-lg measure" style="margin-top:1.15rem">
          An HVAC spike and a dental recall list are not the same problem, and we do not sell them
          the same system. Pick your trade for the leaks, the automate-first order, and the
          pricing that apply to you.
        </p>
      </div>
    </section>

    <section class="section section-tint">
      <div class="container">
        <div class="city-grid">
          {
            industries.map((ind) => (
              <a class="city-card" href={`/for/${ind.slug}`}>
                <span class="prop-name">{ind.name.charAt(0).toUpperCase() + ind.name.slice(1)}</span>
                <span class="prop-role">{ind.intent}</span>
                <span class="city-cta">AI for {ind.name}</span>
              </a>
            ))
          }
        </div>
        <p class="body-lg measure" style="margin-top:2.5rem;font-size:1rem">
          Your trade is not listed? The workshop and the done-for-you builds are
          trade-agnostic. <a class="text-link" href="/#reserve">Tell us how you run</a> and we
          will tell you honestly whether it fits.
        </p>
      </div>
    </section>
  </main>
  <SiteFooter />
</Base>
