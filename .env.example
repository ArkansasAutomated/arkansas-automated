# Names only. Copy to .env if you need local overrides.
# Do not commit .env. This static site has no app secrets.
# Empty values fall back to the public defaults in src/lib/hub.ts.

# Fort Smith Directory hub origin (apex, never www)
PUBLIC_HUB_ORIGIN=

# First-party pageview beacon (POST, text/plain)
PUBLIC_HUB_PV_URL=

# Assessment / workshop / merchant lead intake (POST, text/plain)
PUBLIC_HUB_LEADS_URL=

# List-your-business onboarding (POST, text/plain)
PUBLIC_HUB_ONBOARD_URL=

# Speed-to-lead audit API origin
PUBLIC_SPEED_TO_LEAD_API=

# Front Door $197 start Payment Link. TEST only until Dre GOes live keys.
# Empty = no Pay CTA (production stays form-only).
PUBLIC_FRONT_DOOR_START_URL=
